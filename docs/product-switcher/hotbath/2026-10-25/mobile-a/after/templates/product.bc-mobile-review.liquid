{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="robots" content="noindex, nofollow">
    <meta http-equiv="refresh" content="0;url={{ product.url | escape }}">
    <title>{{ product.title | escape }}</title>
  </head>
  <body><a href="{{ product.url }}">Bekijk het product</a></body>
</html>
