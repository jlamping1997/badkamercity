+{% javascript %}
+  if (!customElements.get('bc-fast-delivery')) {
+    customElements.define('bc-fast-delivery', class extends HTMLElement {
+      connectedCallback() {
+        const parts = new Intl.DateTimeFormat('en-GB', {
+          timeZone: 'Europe/Amsterdam',
+          weekday: 'short',
+          hour: 'numeric',
+          hourCycle: 'h23'
+        }).formatToParts(new Date());
+        const weekday = parts.find(part => part.type === 'weekday')?.value;
+        const hour = Number(parts.find(part => part.type === 'hour')?.value);
+        if (['Mon', 'Tue', 'Wed', 'Thu'].includes(weekday) && hour < 14) {
+          this.textContent = this.dataset.tomorrow;
+        }
+      }
+    });
+  }
