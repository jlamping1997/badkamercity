{{ 'component-product-pros-cons.css' | asset_url | stylesheet_tag }}
{{ 'bc-sunshower-page.css' | asset_url | stylesheet_tag }}
{{ 'bc-photoswipe.css' | asset_url | stylesheet_tag }}
{{ 'bc-sunshower-configurator.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bc-choice-position.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'bc-sunshower-page.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign config = product.metafields.bc_sunshower.configuration.value
  assign specifications = product.metafields.bc_sunshower.specifications.value
  assign components = product.metafields.bc_sunshower.components.value
  assign accessories = product.metafields.bc_sunshower.accessories.value
  assign documents = product.metafields.bc_sunshower.documents.value
  assign variant = product.selected_or_first_available_variant
  assign photos = product.media | where: 'media_type', 'image'
  assign first_photo = photos | first
  assign form_id = 'SunshowerForm-' | append: section.id
  assign quick_specs = 'Plaatsing,Met UV,Met infrarood,Sessietijd,Verzorging' | split: ','
-%}
<div class="ss-page ss-config-page" data-ss-page data-source="{{ product.metafields.bc_sunshower.source.value.source_product_id }}" data-variant="{{ variant.id }}" data-price="{{ variant.price }}" data-currency="{{ cart.currency.iso_code | escape }}" data-catalog="{{ 'bc-sunshower-products.json' | asset_url }}" data-add-url="{{ routes.cart_add_url }}.js" data-cart-url="{{ routes.cart_url }}" data-loading="{{ 'ss.loading' | t | escape }}" data-choice-error="{{ 'ss.choice_error' | t | escape }}" data-cart-error="{{ 'ss.cart_error' | t | escape }}" data-busy-label="{{ 'ss.adding' | t | escape }}">
  <div class="ss-container">
    <nav class="ss-breadcrumb" aria-label="{{ 'ss.breadcrumb' | t }}"><a href="{{ routes.root_url }}">{{ 'ss.home' | t }}</a><span>/</span><a href="{{ product.vendor | url_for_vendor }}">{{ product.vendor | escape }}</a></nav>
    <header class="ss-heading"><h1>{{ product.title | escape }}</h1><p>{{ 'ss.article' | t }} {{ variant.sku | escape }}</p></header>
    <div class="ss-hero">
      <div class="ss-gallery" data-ss-gallery role="group" aria-label="{{ 'ss.photos' | t | escape }}" data-viewer-module="{{ 'bc-photoswipe.esm.js' | asset_url | escape }}" data-gallery-label="{{ 'ss.photos' | t | escape }}" data-close-label="{{ 'ss.close' | t | escape }}" data-zoom-label="{{ 'ss.enlarge' | t | escape }}" data-previous-label="{{ 'general.slider.previous_slide' | t | escape }}" data-next-label="{{ 'general.slider.next_slide' | t | escape }}" data-load-error="{{ 'ss.photo_error' | t | escape }}">
        <div class="ss-gallery__main{% if photos.size == 0 %} ss-gallery__main--empty{% endif %}">
          <div class="ss-gallery__viewport" id="ss-photos-{{ section.id }}" data-ss-gallery-viewport>
            {%- assign gallery_zoom_widths = '480,720,1000,1400,2000' | split: ',' -%}
            {%- for photo in photos -%}
              {%- liquid
                assign photo_alt = photo.alt | default: product.title
                assign zoom_width = photo.preview_image.width | at_most: 2400
                assign zoom_height = zoom_width | divided_by: photo.preview_image.aspect_ratio | round
                assign photo_loading = 'lazy'
                assign photo_priority = 'auto'
                if forloop.first
                  assign photo_loading = 'eager'
                  assign photo_priority = 'high'
                endif
              -%}
              {%- capture full_srcset -%}{%- for width in gallery_zoom_widths -%}{%- assign candidate_width = width | plus: 0 -%}{%- if candidate_width < zoom_width -%}{{ photo.preview_image | image_url: width: candidate_width }} {{ candidate_width }}w, {%- endif -%}{%- endfor -%}{{ photo.preview_image | image_url: width: zoom_width }} {{ zoom_width }}w{%- endcapture -%}
              <a class="ss-gallery__slide" href="{{ photo.preview_image | image_url: width: zoom_width }}" data-ss-gallery-slide data-ss-open-image data-ss-full-srcset="{{ full_srcset | strip | escape }}" data-ss-photo-width="{{ zoom_width }}" data-ss-photo-height="{{ zoom_height }}" data-ss-photo-alt="{{ photo_alt | escape }}" aria-label="{{ 'ss.photo_number' | t: number: forloop.index | escape }}" aria-haspopup="dialog" aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}">
                {{ photo.preview_image | image_url: width: 1400 | image_tag: widths: '480, 720, 1000, 1400', sizes: '(min-width: 990px) 560px, 100vw', loading: photo_loading, fetchpriority: photo_priority, alt: photo_alt, class: 'ss-gallery__photo' }}
                <span class="ss-gallery__error" data-ss-photo-error hidden>{{ 'ss.photo_error' | t }}</span>
              </a>
            {%- endfor -%}
          </div>
          {%- if photos.size > 1 -%}
            <button class="ss-gallery__arrow ss-gallery__arrow--previous" type="button" data-ss-gallery-previous aria-label="{{ 'general.slider.previous_slide' | t | escape }}" aria-controls="ss-photos-{{ section.id }}" disabled><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m14 6-6 6 6 6"/></svg></button>
            <button class="ss-gallery__arrow ss-gallery__arrow--next" type="button" data-ss-gallery-next aria-label="{{ 'general.slider.next_slide' | t | escape }}" aria-controls="ss-photos-{{ section.id }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m10 6 6 6-6 6"/></svg></button>
            <span class="ss-gallery__counter" role="status" aria-live="polite" aria-atomic="true"><span data-ss-gallery-current>1</span><span aria-hidden="true"> / </span><span class="visually-hidden"> {{ 'general.slider.of' | t }} </span>{{ photos.size }}</span>
          {%- endif -%}
          {%- if photos.size > 0 -%}<button class="ss-gallery__expand" type="button" data-ss-gallery-expand aria-label="{{ 'ss.enlarge' | t | escape }}" aria-haspopup="dialog"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M14 5h5v5M19 5l-6 6M10 19H5v-5M5 19l6-6"/></svg></button>{%- endif -%}
        </div>
        {%- if photos.size > 1 -%}
          <div class="ss-gallery__thumbs" role="group" aria-label="{{ 'ss.photos' | t | escape }}">
            {%- for photo in photos -%}<button type="button" class="ss-gallery__thumb{% if forloop.first %} is-selected{% endif %}" data-ss-photo="{{ photo.preview_image | image_url: width: 1400 }}" data-ss-photo-index="{{ forloop.index0 }}" aria-label="{{ 'ss.photo_number' | t: number: forloop.index | escape }}" aria-controls="ss-photos-{{ section.id }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">{{ photo.preview_image | image_url: width: 180 | image_tag: width: 84, height: 84, loading: 'lazy', alt: '' }}</button>{%- endfor -%}
          </div>
        {%- endif -%}
      </div>
      <div class="ss-buybox ss-configurator" id="sunshower-configurator" data-ss-buybox>
        <div class="ss-buybox__content">
          <header class="ss-config-heading"><h2>{{ 'ss.config.title' | t }}</h2><p>{{ 'ss.config.subtitle' | t }}</p></header>
          <div class="ss-choices" data-ss-choices>
            {%- for field in config.fields -%}
              {%- assign option_values = field.values -%}
              {%- if field.code == 'plaatsing' -%}{%- assign option_values = 'Inbouw,Opbouw,Hoek' | split: ',' -%}{%- endif -%}
              {%- assign config_label_key = 'ss.config.' | append: field.code -%}
              {%- assign config_help_key = 'ss.config.help_' | append: field.code -%}
              <fieldset class="ss-choice ss-config-choice ss-config-choice--{{ field.code | escape }}" data-ss-field="{{ field.code | escape }}"><legend class="ss-config-legend"><span class="ss-config-field-name"><span class="ss-config-number" aria-hidden="true">{{ forloop.index }}</span>{{ config_label_key | t }}{% if field.code == 'kleur' %}<span class="ss-config-current">{{ config.selected.kleur | escape }}</span>{% endif %}</span><button type="button" class="ss-link ss-choice__help" data-ss-help="ss-help-{{ section.id }}-{{ field.code }}" aria-haspopup="dialog" aria-controls="ss-help-{{ section.id }}-{{ field.code }}">{{ config_help_key | t }}</button></legend>
                <div class="ss-choice__buttons ss-config-options">{%- for value in option_values -%}{%- assign option_label = field.value_labels[value] | default: value -%}<button type="button" class="ss-option ss-config-option{% if config.selected[field.code] == value %} is-selected{% endif %}" data-ss-option="{{ value | escape }}" aria-pressed="{% if config.selected[field.code] == value %}true{% else %}false{% endif %}">{% render 'bc-ss-choice-label', code: field.code, value: value, label: option_label %}</button>{%- endfor -%}</div>
                <dialog class="ss-help-dialog" id="ss-help-{{ section.id }}-{{ field.code }}" aria-labelledby="ss-help-title-{{ section.id }}-{{ field.code }}"><div class="ss-help-dialog__head"><h2 id="ss-help-title-{{ section.id }}-{{ field.code }}">{{ field.label | escape }}</h2><button type="button" data-ss-close-help aria-label="{{ 'ss.close' | t }}">×</button></div><div class="ss-help-dialog__body">{% render 'bc-ss-guide', config: config, documents: documents, mode: 'help', field: field.code, section_id: section.id %}</div></dialog>
              </fieldset>
            {%- endfor -%}
          </div>
          <p class="ss-status" data-ss-choice-status role="status" aria-live="polite"></p>
          <div class="ss-price-row ss-config-price-row"><div><strong class="ss-price">{{ variant.price | money }}</strong><small class="ss-config-tax">{{ 'ss.config.tax' | t }}</small></div><div class="ss-delivery ss-config-delivery"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 6v6l4 2"/></svg><div><strong>{{ 'ss.delivery' | t }}</strong><a href="mailto:{{ shop.email | escape }}?subject={{ product.title | prepend: 'Levertijd: ' | url_encode }}">{{ 'ss.config.ask_delivery' | t }}</a></div></div></div>
          {%- form 'product', product, id: form_id, class: 'ss-product-form ss-config-purchase' -%}
            <input type="hidden" name="id" value="{{ variant.id }}">
            <div class="ss-quantity-row"><label class="visually-hidden" for="ss-qty-{{ section.id }}">{{ 'ss.quantity' | t }}</label><div class="ss-quantity"><button type="button" data-ss-step="-1" aria-label="{{ 'ss.decrease' | t }}">−</button><input type="number" id="ss-qty-{{ section.id }}" name="quantity" value="1" min="1" step="1" inputmode="numeric" data-ss-quantity><button type="button" data-ss-step="1" aria-label="{{ 'ss.increase' | t }}">+</button></div></div>
            <button class="ss-cart-button" name="add" type="submit"{% unless variant.available %} disabled{% endunless %}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3h2l3 12h10l3-9H6M9 20h.01M18 20h.01"/></svg>{% if variant.available %}{{ 'ss.add_cart' | t }}{% else %}{{ 'ss.unavailable' | t }}{% endif %}</button>
            {% render 'bc-wishlist-button', product: product, class_name: 'bc-wishlist-button--sunshower', source: 'sunshower' %}
          {%- endform -%}
          <a class="ss-complete-link" href="#ss-bundle-{{ section.id }}">{{ 'ss.config.complete' | t }} <span aria-hidden="true">→</span></a>
        </div>
        <ul class="ss-promises" role="list"><li>{{ 'ss.promise_advice' | t }}</li><li>{{ 'ss.promise_parts' | t }}</li></ul>
      </div>
    </div>
    <nav class="ss-page-nav" aria-label="{{ 'ss.guide.navigation' | t }}"><a href="#ss-highlights-{{ section.id }}">{{ 'ss.redesign.highlights' | t }}</a><a href="#ss-description-section-{{ section.id }}">{{ 'ss.redesign.description' | t }}</a><a href="#ss-light-{{ section.id }}">{{ 'ss.guide.nav_light' | t }}</a><a href="#ss-specs-{{ section.id }}">{{ 'ss.specifications' | t }}</a><a href="#ss-docs-{{ section.id }}">{{ 'ss.documents' | t }}</a><a href="#ss-components-title-{{ section.id }}">{{ 'ss.redesign.parts' | t }}</a><a href="#ss-bundle-{{ section.id }}">{{ 'ss.redesign.accessories' | t }}</a></nav>
  </div>
  <div class="ss-information">
    <div class="ss-container ss-overview">
      <div class="ss-overview__left">
        {% render 'bc-ss-highlights', config: config, section_id: section.id %}
        <section class="ss-description" id="ss-description-section-{{ section.id }}" aria-labelledby="ss-short-title-{{ section.id }}"><h2 id="ss-short-title-{{ section.id }}">{{ 'ss.redesign.description' | t }}</h2><div class="ss-description__body" id="ss-description-{{ section.id }}" data-ss-description><div data-ss-description-content>{{ product.description | split: '<h2>Deze set bestaat uit</h2>' | first }}</div></div><button type="button" class="ss-description__toggle" data-ss-description-toggle aria-expanded="false" aria-controls="ss-description-{{ section.id }}" data-more="{{ 'ss.show_more' | t | escape }}" data-less="{{ 'ss.show_less' | t | escape }}" hidden><span data-ss-description-label>{{ 'ss.show_more' | t }}</span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7.5 5 5 5-5"/></svg></button></section>
      </div>
      <div class="ss-overview__right">
        <section aria-labelledby="ss-quick-title-{{ section.id }}"><h2 id="ss-quick-title-{{ section.id }}">{{ 'ss.specifications' | t }}</h2><dl class="ss-quick-specs">{%- for name in quick_specs -%}{%- for group in specifications.groups -%}{%- for item in group.items -%}{%- if item.name == name -%}<div><dt>{{ item.name | escape }}</dt><dd>{%- render 'bc-ss-value', value: item.value -%}</dd></div>{%- endif -%}{%- endfor -%}{%- endfor -%}{%- endfor -%}</dl><a class="ss-link" href="#ss-specs-{{ section.id }}">{{ 'ss.all_specs' | t }}</a></section>
        <section class="ss-components" aria-labelledby="ss-components-title-{{ section.id }}"><h2 id="ss-components-title-{{ section.id }}">{{ 'ss.components' | t }}</h2><ul role="list">{%- for item in components.items -%}<li><a href="{{ item.url | escape }}" data-ss-preview="{{ item.preview_url | escape }}" data-ss-source="{{ item.source_product_id }}">{%- if item.image_url != blank -%}<img src="{{ item.image_url | append: '&width=160' | escape }}" width="64" height="74" alt="" loading="lazy">{%- endif -%}<span>{{ item.title | escape }}<small>{{ item.quantity | round }} × {{ item.manufacturer_number | escape }}</small><span class="ss-component-included">{{ 'ss.included' | t }}</span></span></a></li>{%- endfor -%}</ul></section>
      </div>
    </div>
  </div>
  {% render 'bc-ss-guide', config: config, documents: documents, mode: 'content', photo: first_photo.preview_image, photo_alt: product.title, section_id: section.id %}
  <section class="ss-container ss-bundle" id="ss-bundle-{{ section.id }}" aria-labelledby="ss-bundle-title-{{ section.id }}"><h2 id="ss-bundle-title-{{ section.id }}">{{ 'ss.complete' | t }}</h2><div class="ss-bundle__box">
    <div class="ss-bundle__base">{%- if first_photo != blank -%}{{ first_photo.preview_image | image_url: width: 200 | image_tag: width: 90, height: 100, loading: 'lazy', alt: '' }}{%- endif -%}<div><strong>{{ product.title | escape }}</strong><span>{{ 'ss.delivery' | t }}</span><b>{{ variant.price | money }}</b></div></div>
    {%- assign accessory_groups = 'installation,optional' | split: ',' -%}
    {%- for group_key in accessory_groups -%}
      {%- capture rows -%}{%- for item in accessories.items -%}{%- liquid
        assign is_installation = false
        if item.group == 'Benodigd'
          assign is_installation = true
        endif
        assign show_item = false
        if group_key == 'installation' and is_installation
          assign show_item = true
        elsif group_key == 'optional' and is_installation == false
          assign show_item = true
        endif
        assign accessory_handle = item.url | remove: '/products/'
        assign accessory_product = all_products[accessory_handle]
        assign accessory_variant = accessory_product.selected_or_first_available_variant
        assign accessory_price = item.price_cents
        if accessory_variant != blank
          assign accessory_price = accessory_variant.price
        endif
      -%}{%- if show_item -%}<div class="ss-extra" data-ss-extra-row data-price="{{ accessory_price }}" data-variant="{{ item.variant_id }}"><label class="ss-extra__select"><input type="checkbox" data-ss-extra aria-label="{{ 'ss.select_extra' | t: title: item.title | escape }}"{% if accessory_variant != blank and accessory_variant.available == false %} disabled{% endif %}><span class="visually-hidden">{{ item.title | escape }}</span></label><a class="ss-extra__image" aria-label="{{ item.title | escape }}" href="{{ item.url | escape }}" data-ss-preview="{{ item.preview_url | escape }}" data-ss-source="{{ item.source_product_id }}">{%- if accessory_product.featured_image != blank -%}{{ accessory_product.featured_image | image_url: width: 180 | image_tag: width: 80, height: 86, loading: 'lazy', alt: '' }}{%- elsif item.image_url != blank -%}<img src="{{ item.image_url | append: '&width=180' | escape }}" width="80" height="86" alt="" loading="lazy">{%- else -%}<svg class="ss-placeholder" viewBox="0 0 32 32" aria-hidden="true"><path d="m4 9 12-6 12 6v14l-12 6-12-6V9Zm0 0 12 6 12-6M16 15v14"/></svg>{%- endif -%}</a><div class="ss-extra__description"><span>{{ item.description | escape }}</span><a href="{{ item.url | escape }}" data-ss-preview="{{ item.preview_url | escape }}" data-ss-source="{{ item.source_product_id }}">{{ item.title | escape }}</a><small>{{ item.manufacturer_number | escape }}</small></div><strong class="ss-extra__price">{{ accessory_price | money }}</strong></div>{%- endif -%}{%- endfor -%}{%- endcapture -%}
      {%- assign rows = rows | strip -%}{%- if rows != blank -%}<div class="ss-bundle__group"><div class="ss-bundle__divider" aria-hidden="true">+</div><h3>{% if group_key == 'installation' %}{{ 'ss.installation_group' | t }}{% else %}{{ 'ss.optional_group' | t }}{% endif %}</h3>{{ rows }}</div>{%- endif -%}
    {%- endfor -%}
    <div class="ss-bundle__summary"><div>{{ 'ss.total' | t }} <strong data-ss-total>{{ variant.price | money }}</strong><small>{{ 'ss.total_note' | t }}</small></div><button class="ss-cart-button" type="button" data-ss-add-set{% unless variant.available %} disabled{% endunless %}>{{ 'ss.add_set' | t }}</button><p class="ss-status" data-ss-cart-status role="status" aria-live="polite"></p><a href="{{ routes.cart_url }}" class="ss-link" data-ss-cart-check hidden>{{ 'ss.check_cart' | t }}</a></div>
  </div></section>
  <section class="ss-full-specs" id="ss-specs-{{ section.id }}"><div class="ss-container ss-specs-grid"><h2>{{ 'ss.specifications' | t }}</h2><div class="ss-spec-groups">{%- for group in specifications.groups -%}{%- if group.items.size > 0 -%}<section class="ss-spec-group"><h3>{{ group.group | escape }}</h3><dl class="ss-spec-table">{%- for item in group.items -%}<div><dt>{{ item.name | escape }}</dt><dd>{%- render 'bc-ss-value', value: item.value -%}</dd></div>{%- endfor -%}</dl></section>{%- endif -%}{%- endfor -%}<section class="ss-spec-group">{% render 'bc-ss-guide', config: config, documents: documents, mode: 'installation_specs', section_id: section.id %}</section></div>{% render 'bc-ss-guide', config: config, documents: documents, mode: 'documents', section_id: section.id %}</div></section>
  {% render 'bc-ss-guide', config: config, documents: documents, mode: 'faq', section_id: section.id %}
  <div class="ss-sticky" data-ss-sticky hidden><div class="ss-container ss-sticky__inner">{%- if first_photo != blank -%}{{ first_photo.preview_image | image_url: width: 100 | image_tag: width: 42, height: 50, loading: 'lazy', alt: '' }}{%- endif -%}<span>{{ product.title | escape }}</span><strong>{{ variant.price | money }}</strong><button type="submit" form="{{ form_id }}" class="ss-cart-button"{% unless variant.available %} disabled{% endunless %}>{{ 'ss.add_cart' | t }}</button></div></div>
</div>
<script type="application/ld+json">{{ product | structured_data }}</script>
{% schema %}
{"name":"Sunshower productpagina","settings":[],"presets":[{"name":"Sunshower productpagina"}]}
{% endschema %}


