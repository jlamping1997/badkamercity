  "proposal": {
    "title": "Wiesbaden Grant wastafelkraan met coldstart – geborsteld RVS",
    "short_title": {
      "namespace": "custom",
      "key": "card_title",
      "type": "single_line_text_field",
      "value": "Wiesbaden Grant wastafelkraan geborsteld RVS",
      "definition_reference": "docs/SEARCH_AND_SHORT_TITLES_2026-10-14.md",
