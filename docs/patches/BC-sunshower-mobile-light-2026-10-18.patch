diff --git a/assets/bc-sunshower-mobile.js b/assets/bc-sunshower-mobile.js
new file mode 100644
index 0000000..838b223
--- /dev/null
+++ b/assets/bc-sunshower-mobile.js
@@ -0,0 +1,168 @@
+/* Phone-only Sunshower exploration. Product links remain the no-script fallback. */
+(function () {
+  'use strict';
+  if (window.BCSunshowerMobileLight) {
+    window.BCSunshowerMobileLight.init(document);
+    return;
+  }
+
+  var instances = new Map();
+  var rootSelector = '[data-bcsse-mobile-light]';
+
+  function createController(root) {
+    var sectionId = root.dataset.bcsseSectionId;
+    var media = window.matchMedia('(max-width: 749px)');
+    var overview = root.querySelector('[data-bcsse-light-overview]');
+    var mobileContent = root.querySelector('.bcsse-mobile-light');
+    var panels = Array.from(root.querySelectorAll('[data-bcsse-light-panel]'));
+    var links = Array.from(root.querySelectorAll('[data-bcsse-light-link]'));
+    var configurator = root.querySelector('[data-bcsse-mobile-configurator]');
+    var modelDisclosure = root.querySelector('[data-bcsse-model-disclosure]');
+    var shelf = root.querySelector('[data-bcsse-accessory-shelf]');
+    var heroCopy = root.querySelector('.bcsse-hero__copy');
+    var modelSummary = modelDisclosure && modelDisclosure.querySelector('summary');
+    var title = document.getElementById('bcsse-title-' + sectionId);
+    var modelsId = 'bcsse-models-' + sectionId;
+    var state = 'overview';
+    var destroyed = false;
+
+    function getHashState() {
+      if (window.location.hash === '#bcsse-light-infrared-' + sectionId) return 'infrared';
+      if (window.location.hash === '#bcsse-light-uv-' + sectionId) return 'uv';
+      if (!window.location.hash || window.location.hash === '#bcsse-lights-' + sectionId) return 'overview';
+      if (window.location.hash.indexOf('#bcsse-light-') === 0 || window.location.hash.indexOf('#bcsse-lights-') === 0) return 'overview';
+      return null;
+    }
+
+    function focusState() {
+      var target = title;
+      if (state !== 'overview') {
+        target = document.getElementById('bcsse-light-heading-' + state + '-' + sectionId);
+      }
+      if (!target) return;
+      target.focus({ preventScroll: true });
+      target.scrollIntoView({ block: 'start', behavior: 'auto' });
+    }
+
+    function update(shouldFocus) {
+      if (destroyed) return;
+      state = media.matches ? (getHashState() || state) : 'overview';
+      root.dataset.bcsseLightView = state === 'overview' ? 'overview' : 'detail';
+      overview.hidden = media.matches && state !== 'overview';
+      panels.forEach(function (panel) {
+        panel.hidden = !media.matches || panel.dataset.bcsseLightPanel !== state;
+      });
+      links.forEach(function (link) {
+        if (state !== 'overview' && link.dataset.bcsseLightLink === state) {
+          link.setAttribute('aria-current', 'true');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+      if (configurator) {
+        configurator.href = state === 'uv' ? root.dataset.bcsseUvUrl : root.dataset.bcsseConfiguratorUrl;
+      }
+      if (shelf) shelf.tabIndex = media.matches ? 0 : -1;
+      if (modelDisclosure && (!media.matches || window.location.hash === '#' + modelsId)) {
+        modelDisclosure.open = true;
+      }
+      if (shouldFocus && media.matches) focusState();
+    }
+
+    function navigate(nextState) {
+      var hash = nextState === 'overview' ? '#bcsse-lights-' + sectionId : '#bcsse-light-' + nextState + '-' + sectionId;
+      if (window.location.hash !== hash) {
+        try {
+          window.history.pushState(null, '', hash);
+        } catch (error) {
+          window.location.hash = hash;
+        }
+      }
+      update(true);
+    }
+
+    function onClick(event) {
+      if (!media.matches || event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+      var target = event.target.closest('a');
+      if (!target || !root.contains(target)) return;
+      if (target.getAttribute('href') === '#' + modelsId && modelDisclosure) {
+        modelDisclosure.open = true;
+        return;
+      }
+      var nextState = target.dataset.bcsseLightLink;
+      if (nextState !== 'infrared' && nextState !== 'uv' && nextState !== 'overview') return;
+      event.preventDefault();
+      navigate(nextState);
+    }
+
+    function onHashChange() {
+      var wasDetail = state !== 'overview';
+      var focusWasInside = root.contains(document.activeElement);
+      var hash = window.location.hash;
+      var ownsHash = hash === '#bcsse-lights-' + sectionId || hash === '#bcsse-light-infrared-' + sectionId || hash === '#bcsse-light-uv-' + sectionId;
+      update(false);
+      if (media.matches && (ownsHash || (wasDetail && focusWasInside && state === 'overview'))) focusState();
+    }
+
+    function onMediaChange() {
+      var active = document.activeElement;
+      var willHideActive = !media.matches && ((mobileContent && mobileContent.contains(active)) || (modelSummary && active === modelSummary) || panels.some(function (panel) { return panel.contains(active); }));
+      var nextState = getHashState();
+      var willHideHeroFocus = media.matches && heroCopy && heroCopy.contains(active) && (active !== title || nextState === 'infrared' || nextState === 'uv');
+      var willHideModelFocus = media.matches && modelDisclosure && modelDisclosure.contains(active) && active !== modelSummary && window.location.hash !== '#' + modelsId;
+      if (modelDisclosure) {
+        modelDisclosure.open = !media.matches || window.location.hash === '#' + modelsId;
+      }
+      update(false);
+      if (willHideActive && title) title.focus({ preventScroll: true });
+      else if (willHideHeroFocus) focusState();
+      else if (willHideModelFocus && modelSummary) modelSummary.focus({ preventScroll: true });
+    }
+
+    root.addEventListener('click', onClick);
+    window.addEventListener('hashchange', onHashChange);
+    window.addEventListener('popstate', onHashChange);
+    if (media.addEventListener) media.addEventListener('change', onMediaChange);
+    else media.addListener(onMediaChange);
+    root.dataset.bcsseMobileReady = 'true';
+    onMediaChange();
+
+    return {
+      destroy: function () {
+        destroyed = true;
+        root.removeEventListener('click', onClick);
+        window.removeEventListener('hashchange', onHashChange);
+        window.removeEventListener('popstate', onHashChange);
+        if (media.removeEventListener) media.removeEventListener('change', onMediaChange);
+        else media.removeListener(onMediaChange);
+        overview.hidden = false;
+        panels.forEach(function (panel) { panel.hidden = false; });
+        if (modelDisclosure) modelDisclosure.open = true;
+        if (configurator) configurator.href = root.dataset.bcsseConfiguratorUrl;
+        delete root.dataset.bcsseMobileReady;
+        delete root.dataset.bcsseLightView;
+      }
+    };
+  }
+
+  function init(scope) {
+    var roots = Array.from(scope.querySelectorAll(rootSelector));
+    if (scope.matches && scope.matches(rootSelector)) roots.unshift(scope);
+    roots.forEach(function (root) {
+      if (!instances.has(root)) instances.set(root, createController(root));
+    });
+  }
+
+  document.addEventListener('shopify:section:load', function (event) { init(event.target); });
+  document.addEventListener('shopify:section:unload', function (event) {
+    instances.forEach(function (controller, root) {
+      if (event.target === root || event.target.contains(root)) {
+        controller.destroy();
+        instances.delete(root);
+      }
+    });
+  });
+  window.BCSunshowerMobileLight = { init: init };
+  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { init(document); }, { once: true });
+  else init(document);
+})();
