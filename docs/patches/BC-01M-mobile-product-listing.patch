diff --git a/scripts/test-mobile-listing.cjs b/scripts/test-mobile-listing.cjs
new file mode 100644
index 0000000..d10d368
--- /dev/null
+++ b/scripts/test-mobile-listing.cjs
@@ -0,0 +1,51 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { JSDOM } = require('jsdom');
+const fs = require('node:fs');
+const source = fs.readFileSync(require('node:path').join(__dirname, '../assets/bc-mobile-listing.js'), 'utf8');
+const tick = () => new Promise(resolve => setTimeout(resolve, 30));
+async function fixture() {
+  const dom = new JSDOM(`<html class="bc-external-filters-active"><body><section class="template-search"><button data-bc-open-filters>Filters</button><details class="mobile-facets__disclosure"><summary class="mobile-facets__open-wrapper">Native filters</summary></details><div id="product-grid">Products</div><button data-bc-floating-filter hidden>Filter</button></section></body></html>`, { runScripts:'outside-only', pretendToBeVisual:true });
+  const w = dom.window;
+  let mobile = true, top = 100, bottom = 1400;
+  w.matchMedia = () => ({ get matches() { return mobile; }, addEventListener() {} });
+  for (const el of w.document.querySelectorAll('[data-bc-open-filters], summary')) {
+    el.getClientRects = () => [{}];
+    el.getBoundingClientRect = () => ({ bottom:top });
+  }
+  w.document.querySelector('#product-grid').getBoundingClientRect = () => ({top:-100,bottom});
+  w.document.querySelector('[data-bc-open-filters]').onclick = () => w.document.documentElement.classList.add('bc-filter-drawer-open');
+  w.eval(source); w.document.dispatchEvent(new w.Event('DOMContentLoaded')); await tick();
+  const update = async data => { if ('top' in data) top=data.top; if ('bottom' in data) bottom=data.bottom; if ('mobile' in data) mobile=data.mobile; w.dispatchEvent(new w.Event('scroll')); await tick(); };
+  return {dom,w,update,button:w.document.querySelector('[data-bc-floating-filter]')};
+}
+test('Shortcut appears only after toolbar scrolls away and disappears beyond results or on desktop', async () => {
+  const f = await fixture();
+  try {
+    assert.equal(f.button.hidden,true);
+    await f.update({top:-10}); assert.equal(f.button.hidden,false);
+    await f.update({bottom:80}); assert.equal(f.button.hidden,true);
+    await f.update({bottom:1400,mobile:false}); assert.equal(f.button.hidden,true);
+  } finally { f.dom.window.close(); }
+});
+test('Shortcut opens existing external drawer, hides during filtering, and restores focus', async () => {
+  const f = await fixture();
+  try {
+    await f.update({top:-10}); f.button.click(); await tick();
+    assert(f.w.document.documentElement.classList.contains('bc-filter-drawer-open'));
+    assert.equal(f.button.hidden,true);
+    f.w.document.documentElement.classList.remove('bc-filter-drawer-open'); await tick();
+    assert.equal(f.button.hidden,false);
+    assert.equal(f.w.document.activeElement,f.button);
+  } finally { f.dom.window.close(); }
+});
+test('After external fallback the shortcut opens native Shopify filters', async () => {
+  const f = await fixture();
+  try {
+    await f.update({top:-10});
+    f.w.document.documentElement.classList.remove('bc-external-filters-active'); await tick();
+    f.button.click(); await tick();
+    assert.equal(f.w.document.querySelector('details').open,true);
+    assert.equal(f.button.hidden,true);
+  } finally { f.dom.window.close(); }
+});
