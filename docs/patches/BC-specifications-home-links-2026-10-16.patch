diff --git a/sections/bc-brand-directory.liquid b/sections/bc-brand-directory.liquid
new file mode 100644
--- /dev/null
+++ b/sections/bc-brand-directory.liquid
@@ -0,0 +1,115 @@
+{%- liquid
+  assign approved_vendors = 'hotbath|jee-o|sunshower|the mosaic factory|wiesbaden' | split: '|'
+  assign sorted_vendors = shop.vendors | sort_natural
+-%}
+
+<div class="bc-brand-directory page-width">
+  <h1 class="bc-brand-directory__heading">{{ section.settings.heading | escape }}</h1>
+  <ul class="bc-brand-directory__grid" role="list">
+    {%- for vendor in sorted_vendors -%}
+      {%- assign vendor_key = vendor | downcase -%}
+      {%- if approved_vendors contains vendor_key -%}
+        <li class="bc-brand-directory__item">
+          {{- vendor | link_to_vendor: class: 'bc-brand-directory__link' -}}
+        </li>
+      {%- endif -%}
+    {%- endfor -%}
+  </ul>
+</div>
+
+{% stylesheet %}
+  .bc-brand-directory {
+    width: 100%;
+    max-width: 1440px;
+    margin-inline: auto;
+    padding: 32px 16px 48px;
+    color: #0f2740;
+  }
+
+  .bc-brand-directory__heading {
+    margin: 0 0 24px;
+    color: inherit;
+    font-size: clamp(2.6rem, 3vw, 3.6rem);
+    font-weight: 700;
+    line-height: 1.2;
+  }
+
+  .bc-brand-directory__grid {
+    display: grid;
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+    gap: 12px;
+    margin: 0;
+    padding: 0;
+    list-style: none;
+  }
+
+  .bc-brand-directory__item {
+    min-width: 0;
+  }
+
+  .bc-brand-directory__link {
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    height: 100%;
+    min-height: 88px;
+    padding: 20px 16px;
+    border: 1px solid rgba(15, 39, 64, 0.12);
+    border-radius: 8px;
+    background: #fff;
+    color: inherit;
+    font-size: 1.7rem;
+    font-weight: 600;
+    line-height: 1.4;
+    text-align: center;
+    text-decoration: none;
+    overflow-wrap: anywhere;
+    transition: border-color 160ms ease, background-color 160ms ease;
+  }
+
+  .bc-brand-directory__link:hover {
+    border-color: #176b9b;
+    background: #f2f7fa;
+  }
+
+  .bc-brand-directory__link:focus-visible {
+    outline: 3px solid #176b9b;
+    outline-offset: 3px;
+  }
+
+  @media screen and (min-width: 750px) {
+    .bc-brand-directory {
+      padding: 40px 24px 64px;
+    }
+
+    .bc-brand-directory__grid {
+      grid-template-columns: repeat(3, minmax(0, 1fr));
+    }
+  }
+
+  @media screen and (min-width: 1100px) {
+    .bc-brand-directory__grid {
+      grid-template-columns: repeat(5, minmax(0, 1fr));
+    }
+  }
+
+  @media (prefers-reduced-motion: reduce) {
+    .bc-brand-directory__link {
+      transition: none;
+    }
+  }
+{% endstylesheet %}
+
+{% schema %}
+{
+  "name": "Merkenoverzicht",
+  "settings": [
+    {
+      "type": "text",
+      "id": "heading",
+      "label": "Titel",
+      "default": "Onze merken"
+    }
+  ]
+}
+{% endschema %}
