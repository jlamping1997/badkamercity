+}
+
+.bc-cart-items .cart-item cart-remove-button {
+  margin-left: 0.4rem;
+}
+
+.bc-cart-items cart-remove-button .button {
+  width: 4.4rem;
+  min-width: 4.4rem;
+  min-height: 4.4rem;
+  margin: 0;
+  color: var(--bc-cart-muted);
+}
+
+.bc-cart-items cart-remove-button .button:hover {
+  color: var(--bc-cart-ink);
+  background: #edf7f9;
+  border-radius: 0.8rem;
+}
+
+.bc-cart-items .cart-item__totals {
+  grid-column: 2;
+  grid-row: 2;
+  align-self: center;
+  justify-self: end;
+  min-height: 4.4rem;
+  align-items: center;
+}
+
+.bc-cart-items .cart-item__price-wrapper > *:only-child:not(.cart-item__discounted-prices) {
+  margin: 0;
+}
+
+.bc-cart-items .cart-item__totals .price {
+  color: var(--bc-cart-ink);
+  font-size: 1.6rem;
+  font-weight: 700;
+  line-height: 1.4;
+}
+
+.bc-cart-items .cart-item__totals .cart-item__old-price {
+  color: var(--bc-cart-muted);
+  font-size: 1.2rem;
+  font-weight: 400;
+}
+
+.bc-cart-items .cart-item .loading__spinner {
+  top: 50%;
+  right: 0;
+  bottom: auto;
+  padding: 0;
+  transform: translateY(-50%);
+}
+
+.bc-cart-items .cart-item__error {
+  max-width: 100%;
+  margin-left: 0;
+}
+
+.bc-cart-items .cart-items__info {
+  z-index: 3;
+}
+
+.bc-cart-items .cart-item__nested-line {
+  margin-left: 1.6rem;
+  border-left: 3px solid #a9e6ef;
+}
+
+.bc-cart-summary .cart__footer,
+.cart__footer-wrapper:last-child .bc-cart-summary .cart__footer {
+  display: flex;
+  flex-direction: column;
+  gap: 2.4rem;
+  margin: 0;
+  padding: 2.4rem;
+  border: 1px solid #cddfe8;
+  border-top: 4px solid var(--bc-cart-cyan);
+  border-radius: 1.6rem;
+  background: #fff;
+  box-shadow: 0 1rem 3rem #10324608;
+}
+
+.bc-cart-summary .cart__footer > * {
+  width: 100%;
+  min-width: 0;
+  margin: 0;
+}
+
+.bc-cart-summary .cart__blocks > * + * {
