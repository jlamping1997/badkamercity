+
+.bc-cart-summary__heading h2 {
+  margin: 0;
+  color: var(--bc-cart-ink);
+  font-size: 2.5rem;
+  font-weight: 750;
+  line-height: 1.2;
+  letter-spacing: -0.025em;
+}
+
+.bc-cart-summary__subtotal {
