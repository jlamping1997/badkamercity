+  align-items: baseline;
+  justify-content: space-between;
+  gap: 1.6rem;
+  margin-bottom: 1.6rem;
+  color: var(--bc-cart-muted);
+  font-size: 1.4rem;
+  line-height: 1.5;
+}
+
+.bc-cart-summary__subtotal > :last-child {
+  flex-shrink: 0;
+  color: var(--bc-cart-ink);
