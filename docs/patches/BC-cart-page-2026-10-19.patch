+  margin: 0 auto 2.4rem;
+  color: var(--bc-cart-muted);
+  font-size: 1.5rem;
+  line-height: 1.6;
+}
+
+.bc-cart-empty > .button {
+  min-height: 5.2rem;
+  border-radius: 0.8rem;
+  color: var(--bc-cart-ink);
+  background: var(--bc-cart-cyan);
+  font-size: 1.5rem;
+  font-weight: 700;
+  letter-spacing: 0;
+}
+
+.bc-cart-empty > .button::before,
+.bc-cart-empty > .button::after {
+  content: none;
+}
+
+.bc-cart-empty .cart__login-title {
+  margin-top: 3.2rem;
+  color: var(--bc-cart-ink);
+  font-size: 1.8rem;
+}
+
+.bc-cart-empty .cart__login-paragraph {
+  color: var(--bc-cart-muted);
+  font-size: 1.4rem;
+  line-height: 1.6;
+}
+
+.bc-cart-items a:focus-visible,
+.bc-cart-items button:focus-visible,
+.bc-cart-items input:focus-visible,
+.bc-cart-summary a:focus-visible,
+.bc-cart-summary button:focus-visible {
+  outline: 2px solid var(--bc-cart-ink);
+  outline-offset: 3px;
+  box-shadow: none;
+}
+
+@media screen and (min-width: 750px) {
+  #MainContent:has(.bc-cart-items) {
+    padding-top: 4rem;
+    padding-right: max(3.2rem, calc((100vw - 124rem) / 2));
+    padding-left: max(3.2rem, calc((100vw - 124rem) / 2));
+  }
+
+  .bc-cart-items .cart-item {
+    grid-template-columns: 10rem minmax(0, 1fr) auto;
+    gap: 1.6rem 2rem;
+    padding: 2rem;
+  }
+
+  .bc-cart-items .cart-item__media {
+    grid-row: 1 / 3;
+  }
+
+  .bc-cart-items .cart-item__image-container {
+    height: 12rem;
+  }
+
+  .bc-cart-items .cart-item__name {
+    font-size: 1.7rem;
+  }
+
+  .bc-cart-items .cart-item__quantity {
+    grid-column: 2;
+    grid-row: 2;
+  }
+
+  .bc-cart-items .cart-item__totals {
+    display: flex;
+    grid-column: 3;
+    grid-row: 1 / 3;
+    align-self: start;
+    min-height: 0;
+    padding-top: 0.2rem;
+  }
+
+  .bc-cart-summary .cart__footer {
+    padding: 2.8rem;
+  }
+
+  .cart__footer-wrapper:last-child .bc-cart-summary .cart__footer {
+    padding-bottom: 2.8rem;
+  }
+}
+
+@media screen and (min-width: 1100px) {
+  #MainContent:has(.bc-cart-items) {
+    grid-template-columns: minmax(0, 1fr) 39rem;
+    align-items: start;
+    gap: 3.2rem;
+    padding-bottom: 7rem;
+  }
+
+  #MainContent:has(.bc-cart-items) > .cart__footer-wrapper {
+    position: sticky;
+    top: 2.4rem;
+  }
+
+  .bc-cart-items .bc-cart-heading {
+    margin-bottom: 3.2rem;
+  }
+
+  .bc-cart-items .cart-item {
+    grid-template-columns: 10rem minmax(0, 1fr);
+  }
+
+  .bc-cart-items .cart-item__media {
+    grid-row: 1;
+  }
+
+  .bc-cart-items .cart-item__quantity {
+    grid-column: 1 / -1;
+    grid-row: 2;
+  }
+
+  .bc-cart-items .cart-item__totals {
+    grid-column: 2;
+    grid-row: 2;
+    align-self: center;
+  }
+}
+
+@media screen and (max-width: 360px) {
+  .bc-cart-items .cart-item__totals {
+    grid-column: 1 / -1;
+    grid-row: 3;
+    justify-self: end;
+    min-height: 0;
+    max-width: 100%;
+  }
+
+  .bc-cart-items .cart-item__price-wrapper {
+    max-width: 100%;
+    overflow-wrap: anywhere;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .bc-cart-summary .cart__checkout-button {
+    transition: none;
+  }
+}
