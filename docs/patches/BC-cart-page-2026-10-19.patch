+  align-items: baseline;
+  flex-wrap: wrap;
+  gap: 1.6rem;
+  row-gap: 0.6rem;
+  padding-top: 1.8rem;
+  border-top: 1px solid var(--bc-cart-line);
+}
+
+.bc-cart-summary .totals > * {
+  margin: 0;
+  color: var(--bc-cart-ink);
+  line-height: 1.4;
+}
+
+.bc-cart-summary .totals .totals__total {
+  font-size: 1.6rem;
+  font-weight: 650;
+}
+
+.bc-cart-summary .totals .totals__total-value {
+  flex-shrink: 0;
+  max-width: 100%;
+  margin-left: auto;
+  overflow-wrap: anywhere;
+  font-size: 2.2rem;
+  font-weight: 750;
+  letter-spacing: -0.025em;
+  font-variant-numeric: tabular-nums;
+}
+
+.bc-cart-summary .tax-note {
+  margin: 1rem 0 0;
+  color: var(--bc-cart-muted);
+  font-size: 1.2rem;
+  line-height: 1.6;
+  text-align: left;
+}
+
+.bc-cart-summary .tax-note a {
+  color: inherit;
+  text-underline-offset: 0.25rem;
+}
+
+.bc-cart-summary .cart__ctas {
+  display: block;
+  margin-top: 2rem;
+}
+
+.bc-cart-summary .cart__checkout-button {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 1rem;
+  min-height: 5.6rem;
+  width: 100%;
+  max-width: none;
+  padding: 1.4rem 1.8rem;
+  border: 0;
+  border-radius: 0.8rem;
+  color: var(--bc-cart-ink);
+  background: var(--bc-cart-cyan);
+  font-size: 1.6rem;
+  font-weight: 750;
+  line-height: 1.35;
+  letter-spacing: 0;
+  box-shadow: none;
+  text-align: left;
+  transition: background-color 150ms ease;
+}
+
+.bc-cart-summary .cart__checkout-button::before,
+.bc-cart-summary .cart__checkout-button::after {
+  content: none;
+}
+
+.bc-cart-summary .cart__checkout-button:not([disabled]):hover {
+  background: #62dcea;
+}
+
+.bc-cart-checkout-arrow {
+  flex-shrink: 0;
+  font-size: 2.5rem;
+  font-weight: 400;
+  line-height: 1;
+}
+
+.bc-cart-summary .bc-cart-secure {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 0.7rem;
+  margin: 1rem 0 0;
+  color: var(--bc-cart-muted);
+  font-size: 1.2rem;
+  line-height: 1.6;
+}
+
+.bc-cart-secure::before {
+  content: "";
+  display: block;
+  width: 0.75rem;
+  height: 0.75rem;
+  border-radius: 50%;
