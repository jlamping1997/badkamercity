+  font-weight: 700;
+  line-height: 1.35;
+  letter-spacing: -0.015em;
+  overflow-wrap: anywhere;
+}
+
+.bc-cart-items .product-option,
+.bc-cart-items .cart-item__details .caption-with-letter-spacing {
+  color: var(--bc-cart-muted);
+  font-size: 1.3rem;
+  line-height: 1.5;
+}
+
+.bc-cart-items .cart-item__details > .product-option,
+.bc-cart-items .cart-item__final-price {
