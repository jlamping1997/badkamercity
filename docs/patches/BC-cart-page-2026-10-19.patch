+
+.bc-cart-items .cart-item__quantity {
+  grid-column: 1 / -1;
+  grid-row: 2;
+  justify-self: start;
+  align-self: center;
+}
+
+.bc-cart-items .cart-item__quantity-wrapper {
+  align-items: center;
+  flex-wrap: nowrap;
+}
