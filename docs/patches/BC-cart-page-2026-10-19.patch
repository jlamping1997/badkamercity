+  padding-top: 2.6rem;
+  border-top: 1px solid var(--bc-cart-line);
+}
+
+.bc-cart-summary .cart__note label {
+  position: absolute;
+  top: 1rem;
+  height: auto;
+  color: var(--bc-cart-muted);
+  font-size: 1.2rem;
+  line-height: 1.5;
+}
+
+.bc-cart-summary .cart__note .field__input {
+  min-height: 8rem;
+  padding: 1.2rem;
+  border-radius: 0.8rem;
+  font-size: 1.4rem;
+  line-height: 1.5;
+}
+
+.bc-cart-summary .cart__note::after,
+.bc-cart-summary .cart__note::before {
+  content: none;
+}
+
+.bc-cart-summary #cart-errors:empty {
+  display: none;
+}
+
+.bc-cart-summary #cart-errors {
+  font-size: 1.3rem;
+  line-height: 1.5;
+}
+
+.bc-cart-summary .bc-cart-payments {
+  padding-top: 1.6rem;
+  border-top: 1px solid var(--bc-cart-line);
+}
+
+.bc-cart-payments__list {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  flex-wrap: wrap;
+  gap: 0.7rem;
+  margin: 0;
+  padding: 0;
+}
+
+.bc-cart-payments__list li {
+  display: flex;
+}
+
+.bc-cart-payment-icon {
+  display: block;
+  width: 3.8rem;
+  height: 2.4rem;
+}
+
+#MainContent:has(.bc-cart-items.is-empty) > .shopify-section:has(.bc-cart-summary) {
+  display: none;
+}
+
+#MainContent:has(.bc-cart-items.is-empty) > .shopify-section:has(.bc-cart-items) {
+  grid-column: 1 / -1;
+}
+
+.bc-cart-items.is-empty .bc-cart-empty {
