+#MainContent:has(.bc-cart-items) {
+  --bc-cart-ink: #103246;
+  --bc-cart-muted: #526a78;
+  --bc-cart-cyan: #32cce1;
+  --bc-cart-line: #dce6eb;
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  align-content: start;
+  gap: 2rem;
+  padding: 3rem max(1.6rem, calc((100vw - 124rem) / 2)) 5rem;
+  background: linear-gradient(150deg, #edf9fc 0, #f5f8fa 36rem, #f5f8fa 100%);
+  color: var(--bc-cart-ink);
+}
+
+#MainContent:has(.bc-cart-items) > .shopify-section {
+  min-width: 0;
+}
+
+#MainContent:has(.bc-cart-items) > .shopify-section:not(:has(.bc-cart-items, .bc-cart-summary)) {
+  grid-column: 1 / -1;
+}
+
+.bc-cart-items,
+.bc-cart-summary {
+  color: var(--bc-cart-ink);
+  background: transparent;
+  font-size: 1.5rem;
+  letter-spacing: 0;
+}
+
+cart-items.bc-cart-items {
+  padding: 0;
+}
+
+.bc-cart-items > .page-width,
+.bc-cart-summary > .page-width {
+  max-width: none;
+  padding: 0;
+}
+
+.bc-cart-items .bc-cart-heading {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: flex-end;
+  justify-content: space-between;
+  gap: 1.6rem;
+  margin: 0 0 2.6rem;
+}
+
+.bc-cart-eyebrow {
+  margin: 0 0 0.8rem;
+  color: var(--bc-cart-muted);
+  font-size: 1.2rem;
+  font-weight: 650;
+  line-height: 1.4;
+  letter-spacing: 0.07em;
+  text-transform: uppercase;
+}
+
+.bc-cart-items .bc-cart-heading .title {
+  margin: 0;
+  color: var(--bc-cart-ink);
+  font-size: clamp(3rem, 3vw, 4rem);
+  font-weight: 750;
+  line-height: 1.12;
+  letter-spacing: -0.035em;
+}
+
+.bc-cart-intro {
