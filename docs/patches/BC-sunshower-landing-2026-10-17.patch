+    font-size: 22px;
+  }
+
+  .bcssl-mount-tile__copy p {
+    font-size: 14px;
+  }
+
+  .bcssl-landing .bcssl-mount__sizes {
+    margin-top: 22px;
+    font-size: 16px;
+  }
+
+  .bcssl-landing .bcssl-mount__note {
+    font-size: 15px;
+  }
+
+  .bcssl-advice {
+    grid-template-columns: minmax(0, 1fr) auto;
+    align-items: center;
+    gap: 30px;
+    padding: 30px 32px;
+  }
