+{{ 'bc-sunshower-landing.css' | asset_url | stylesheet_tag }}
+
+{%- liquid
+  assign one_product = section.settings.one_product
+  assign plus_product = section.settings.plus_product
+  assign hero_image = section.settings.hero_image | default: one_product.featured_image
+  assign one_image = section.settings.one_image | default: one_product.featured_image
+  assign plus_image = section.settings.plus_image | default: plus_product.featured_image
+  assign advice_url = section.settings.advice_url | default: pages.contact.url
+  assign hero_alt = 'ss_landing.hero.image_alt' | t
+  assign one_alt = 'ss_landing.one.image_alt' | t
+  assign plus_alt = 'ss_landing.plus.image_alt' | t
+  assign inbouw_alt = 'ss_landing.mount.inbouw_alt' | t
+  assign opbouw_alt = 'ss_landing.mount.opbouw_alt' | t
+-%}
+
+<div class="bcssl-landing">
+  <div class="bcssl-wrap">
+    <section class="bcssl-hero" aria-labelledby="bcssl-title-{{ section.id }}">
+      <div class="bcssl-hero__copy">
+        <p class="bcssl-eyebrow">{{ 'ss_landing.hero.eyebrow' | t }}</p>
+        <h1 class="bcssl-title" id="bcssl-title-{{ section.id }}">{{ 'ss_landing.hero.heading' | t }}</h1>
+        <p class="bcssl-hero__intro">{{ 'ss_landing.hero.intro' | t }}</p>
+        <a class="bcssl-text-link" href="#bcssl-models-{{ section.id }}">{{ 'ss_landing.hero.compare' | t }} <span aria-hidden="true">↓</span></a>
+      </div>
+      {%- if hero_image != blank -%}
+        <div class="bcssl-hero__media">
+          {{- hero_image | image_url: width: 1400 | image_tag: class: 'bcssl-hero__image', widths: '360, 540, 750, 1000, 1400', sizes: '(min-width: 1152px) 592px, (min-width: 750px) 52vw, calc(100vw - 32px)', width: hero_image.width, height: hero_image.height, loading: 'eager', fetchpriority: 'high', alt: hero_alt -}}
+        </div>
+      {%- endif -%}
+    </section>
+
+    <section class="bcssl-models bcssl-section" id="bcssl-models-{{ section.id }}" aria-labelledby="bcssl-models-title-{{ section.id }}">
+      <div class="bcssl-section__head">
+        <h2 class="bcssl-heading" id="bcssl-models-title-{{ section.id }}">{{ 'ss_landing.models.heading' | t }}</h2>
+        <p class="bcssl-intro">{{ 'ss_landing.models.intro' | t }}</p>
+      </div>
+      <div class="bcssl-model-grid">
+        <article class="bcssl-model">
+          {%- if one_image != blank -%}
+            <div class="bcssl-model__media">
+              {{- one_image | image_url: width: 1000 | image_tag: class: 'bcssl-model__image', widths: '240, 360, 540, 750, 1000', sizes: '(min-width: 1152px) 530px, (min-width: 750px) 45vw, (min-width: 350px) calc((100vw - 68px) / 2), calc(100vw - 56px)', width: one_image.width, height: one_image.height, loading: 'lazy', alt: one_alt -}}
+            </div>
+          {%- endif -%}
+          <div class="bcssl-model__body">
+            <h3 class="bcssl-model__title">{{ 'ss_landing.one.heading' | t }}</h3>
+            <p class="bcssl-badge bcssl-badge--ir">{{ 'ss_landing.one.badge' | t }}</p>
+            <p class="bcssl-model__description">{{ 'ss_landing.one.description' | t }}</p>
+            {%- if one_product != blank -%}
+              <a class="bcssl-button bcssl-button--navy" href="{{ one_product.url }}">{{ 'ss_landing.one.button' | t }} <span aria-hidden="true">→</span></a>
+            {%- endif -%}
+          </div>
+        </article>
+        <article class="bcssl-model">
+          {%- if plus_image != blank -%}
+            <div class="bcssl-model__media">
+              {{- plus_image | image_url: width: 1000 | image_tag: class: 'bcssl-model__image', widths: '240, 360, 540, 750, 1000', sizes: '(min-width: 1152px) 530px, (min-width: 750px) 45vw, (min-width: 350px) calc((100vw - 68px) / 2), calc(100vw - 56px)', width: plus_image.width, height: plus_image.height, loading: 'lazy', alt: plus_alt -}}
+            </div>
+          {%- endif -%}
+          <div class="bcssl-model__body">
+            <h3 class="bcssl-model__title">{{ 'ss_landing.plus.heading' | t }}</h3>
+            <p class="bcssl-badge bcssl-badge--uv">{{ 'ss_landing.plus.badge' | t }}</p>
+            <p class="bcssl-model__description">{{ 'ss_landing.plus.description' | t }}</p>
+            {%- if plus_product != blank -%}
+              <a class="bcssl-button bcssl-button--navy" href="{{ plus_product.url }}">{{ 'ss_landing.plus.button' | t }} <span aria-hidden="true">→</span></a>
+            {%- endif -%}
+          </div>
+        </article>
+      </div>
+      <p class="bcssl-models__note">{{ 'ss_landing.models.note' | t }}</p>
+    </section>
+
+    <section class="bcssl-explain bcssl-section" aria-labelledby="bcssl-explain-title-{{ section.id }}">
+      <div class="bcssl-explain__intro">
+        <p class="bcssl-eyebrow">{{ 'ss_landing.explain.eyebrow' | t }}</p>
+        <h2 class="bcssl-heading" id="bcssl-explain-title-{{ section.id }}">{{ 'ss_landing.explain.heading' | t }}</h2>
+        <p class="bcssl-intro">{{ 'ss_landing.explain.intro' | t }}</p>
+      </div>
+      <div class="bcssl-light-grid">
+        <div class="bcssl-light">
+          <span class="bcssl-light__mark bcssl-light__mark--ir" aria-hidden="true">IR</span>
+          <div>
+            <h3 class="bcssl-subheading">{{ 'ss_landing.explain.ir_heading' | t }}</h3>
+            <p>{{ 'ss_landing.explain.ir_text' | t }}</p>
+          </div>
+        </div>
+        <div class="bcssl-light">
+          <span class="bcssl-light__mark bcssl-light__mark--uv" aria-hidden="true">UV</span>
+          <div>
+            <h3 class="bcssl-subheading">{{ 'ss_landing.explain.uv_heading' | t }}</h3>
+            <p>{{ 'ss_landing.explain.uv_text' | t }}</p>
+          </div>
+        </div>
+      </div>
+    </section>
+
+    <section class="bcssl-mount bcssl-section" aria-labelledby="bcssl-mount-title-{{ section.id }}">
+      <div class="bcssl-section__head">
+        <h2 class="bcssl-heading" id="bcssl-mount-title-{{ section.id }}">{{ 'ss_landing.mount.heading' | t }}</h2>
+        <p class="bcssl-intro">{{ 'ss_landing.mount.intro' | t }}</p>
+      </div>
+      <div class="bcssl-mount-grid">
+        <article class="bcssl-mount-tile">
+          {%- if section.settings.inbouw_image != blank -%}
+            {{- section.settings.inbouw_image | image_url: width: 1000 | image_tag: class: 'bcssl-mount-tile__image', widths: '240, 360, 540, 750, 1000', sizes: '(min-width: 1152px) 544px, (min-width: 750px) 46vw, calc((100vw - 44px) / 2)', width: section.settings.inbouw_image.width, height: section.settings.inbouw_image.height, loading: 'lazy', alt: inbouw_alt -}}
+          {%- endif -%}
+          <div class="bcssl-mount-tile__copy">
+            <h3 class="bcssl-subheading">{{ 'ss_landing.mount.inbouw_heading' | t }}</h3>
+            <p>{{ 'ss_landing.mount.inbouw_text' | t }}</p>
+          </div>
+        </article>
+        <article class="bcssl-mount-tile">
+          {%- if section.settings.opbouw_image != blank -%}
+            {{- section.settings.opbouw_image | image_url: width: 1000 | image_tag: class: 'bcssl-mount-tile__image', widths: '240, 360, 540, 750, 1000', sizes: '(min-width: 1152px) 544px, (min-width: 750px) 46vw, calc((100vw - 44px) / 2)', width: section.settings.opbouw_image.width, height: section.settings.opbouw_image.height, loading: 'lazy', alt: opbouw_alt -}}
+          {%- endif -%}
+          <div class="bcssl-mount-tile__copy">
+            <h3 class="bcssl-subheading">{{ 'ss_landing.mount.opbouw_heading' | t }}</h3>
+            <p>{{ 'ss_landing.mount.opbouw_text' | t }}</p>
+          </div>
+        </article>
+      </div>
+      <p class="bcssl-mount__sizes">{{ 'ss_landing.mount.sizes' | t }}</p>
+      <p class="bcssl-mount__note">{{ 'ss_landing.mount.note' | t }}</p>
+    </section>
+
+    <section class="bcssl-advice" aria-labelledby="bcssl-advice-title-{{ section.id }}">
+      <div>
+        <h2 class="bcssl-heading" id="bcssl-advice-title-{{ section.id }}">{{ 'ss_landing.advice.heading' | t }}</h2>
+        <p>{{ 'ss_landing.advice.text' | t }}</p>
+      </div>
+      {%- if advice_url != blank -%}
+        <a class="bcssl-button bcssl-button--cyan" href="{{ advice_url }}">{{ 'ss_landing.advice.button' | t }} <span aria-hidden="true">→</span></a>
+      {%- endif -%}
+    </section>
+
+    <section class="bcssl-faq bcssl-section" aria-labelledby="bcssl-faq-title-{{ section.id }}">
+      <h2 class="bcssl-heading" id="bcssl-faq-title-{{ section.id }}">{{ 'ss_landing.faq.heading' | t }}</h2>
+      <div class="bcssl-faq__list">
+        <details class="bcssl-faq__item">
+          <summary>{{ 'ss_landing.faq.difference_question' | t }}<span class="bcssl-faq__plus" aria-hidden="true"></span></summary>
+          <div class="bcssl-faq__answer"><p>{{ 'ss_landing.faq.difference_answer' | t }}</p></div>
+        </details>
+        <details class="bcssl-faq__item">
+          <summary>{{ 'ss_landing.faq.size_question' | t }}<span class="bcssl-faq__plus" aria-hidden="true"></span></summary>
+          <div class="bcssl-faq__answer"><p>{{ 'ss_landing.faq.size_answer' | t }}</p></div>
+        </details>
+        <details class="bcssl-faq__item">
+          <summary>{{ 'ss_landing.faq.mount_question' | t }}<span class="bcssl-faq__plus" aria-hidden="true"></span></summary>
+          <div class="bcssl-faq__answer"><p>{{ 'ss_landing.faq.mount_answer' | t }}</p></div>
+        </details>
+        <details class="bcssl-faq__item">
+          <summary>{{ 'ss_landing.faq.install_question' | t }}<span class="bcssl-faq__plus" aria-hidden="true"></span></summary>
+          <div class="bcssl-faq__answer"><p>{{ 'ss_landing.faq.install_answer' | t }}</p></div>
+        </details>
+      </div>
+    </section>
+  </div>
+</div>
+
+{% schema %}
+{
+  "name": "t:sections.bc_sunshower_landing.name",
+  "tag": "section",
+  "class": "bcssl-section-root",
+  "settings": [
+    {
+      "type": "image_picker",
