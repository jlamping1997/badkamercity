diff --git a/assets/bc-home-sunshower.css b/assets/bc-home-sunshower.css
new file mode 100644
index 0000000..38a1c30
--- /dev/null
+++ b/assets/bc-home-sunshower.css
@@ -0,0 +1,163 @@
+.bcssh {
+  padding-block: 18px;
+  color: #0f2740;
+  background: #fff;
+}
+
+.bcssh-container {
+  box-sizing: border-box;
+  width: 100%;
+  max-width: 1440px;
+  margin-inline: auto;
+  padding-inline: 16px;
+}
+
+.bcssh-card {
+  display: grid;
+  grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
+  min-height: 210px;
+  border: 1px solid #e8e1d6;
+  border-radius: 12px;
+  background: #f5f1e9;
+}
+
+.bcssh-content {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  justify-content: center;
+  gap: 8px;
+  min-width: 0;
+  padding: 18px 14px;
+}
+
+.bcssh-eyebrow {
+  margin: 0;
+  color: #3a6576;
+  font-size: 1.1rem;
+  font-weight: 700;
+  line-height: 1.2;
+  letter-spacing: 0.11em;
+  text-transform: uppercase;
+}
+
+.bcssh-heading {
+  max-width: 23ch;
+  margin: 0;
+  color: #0f2740;
+  font-size: 2rem;
+  font-weight: 650;
+  line-height: 1.14;
+  letter-spacing: -0.025em;
+  overflow-wrap: break-word;
+}
+
+.bcssh-intro {
+  margin: 0;
+  color: #516273;
+  font-size: 1.2rem;
+  line-height: 1.4;
+}
+
+.bcssh-link {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 7px;
+  box-sizing: border-box;
+  max-width: 100%;
+  min-height: 44px;
+  margin-top: 2px;
+  padding: 9px 11px;
+  border: 1px solid #0f2740;
+  border-radius: 7px;
+  color: #fff;
+  background: #0f2740;
+  font-size: 1.15rem;
+  font-weight: 600;
+  line-height: 1.3;
+  text-decoration: none;
+  text-align: center;
+  transition: background-color 160ms ease, border-color 160ms ease;
+}
+
+.bcssh-link:hover {
+  border-color: #1f6685;
+  color: #fff;
+  background: #1f6685;
+}
+
+.bcssh-link:focus-visible {
+  outline: 3px solid #176b9b;
+  outline-offset: 4px;
+}
+
+.bcssh-arrow {
+  flex-shrink: 0;
+}
+
+.bcssh-media {
+  position: relative;
+  min-width: 0;
+  border-radius: 0 11px 11px 0;
+  overflow: hidden;
+}
+
+.bcssh-image {
+  position: absolute;
+  inset: 0;
+  display: block;
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+  object-position: 72% center;
+}
+
+.bcssh-card--text-only {
+  grid-template-columns: minmax(0, 1fr);
+  min-height: 0;
+}
+
+@media screen and (min-width: 750px) {
+  .bcssh {
+    padding-block: 24px;
+  }
+
+  .bcssh-card {
+    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
+    min-height: 230px;
+  }
+
+  .bcssh-content {
+    gap: 9px;
+    padding: 24px 32px;
+  }
+
+  .bcssh-eyebrow {
+    font-size: 1.2rem;
+  }
+
+  .bcssh-heading {
+    font-size: clamp(2.6rem, 2.4vw, 3.2rem);
+  }
+
+  .bcssh-intro {
+    font-size: 1.4rem;
+  }
+
+  .bcssh-link {
+    padding-inline: 18px;
+    font-size: 1.3rem;
+  }
+
+  .bcssh-card--text-only {
+    grid-template-columns: minmax(0, 1fr);
+    min-height: 0;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .bcssh-link {
+    transition: none;
+  }
+}
