+  .bcssl-advice .bcssl-heading {
+    font-size: 28px;
+  }
+
+  .bcssl-advice .bcssl-button {
+    min-width: 220px;
+  }
+
+  .bcssl-faq summary,
+  .bcssl-faq__answer {
+    font-size: 16px;
+  }
+}
