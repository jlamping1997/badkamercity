--- a/snippets/bc-product-breadcrumbs.liquid
+++ b/snippets/bc-product-breadcrumbs.liquid
@@ -0,0 +1,16 @@
+{% doc %}
+  Shows the reviewed category path above the 24.3710 pilot product heading.
+  @param {product} product - Current product.
+{% enddoc %}
+{%- assign breadcrumb_vendor = product.vendor | strip | downcase -%}
+{%- if breadcrumb_vendor == 'wiesbaden' and product.has_only_default_variant and product.selected_or_first_available_variant.sku == '24.3710' -%}
+  <nav class="bc-product-breadcrumbs" aria-label="{{ 'ss.breadcrumb' | t | escape }}">
+    <ol role="list">
+      <li><a href="{{ routes.root_url }}">{{ 'ss.home' | t }}</a></li>
+      <li><span aria-hidden="true">/</span><a href="{{ routes.collections_url }}/kranen">{{ 'bc_pilot_category.kranen' | t }}</a></li>
+      <li><span aria-hidden="true">/</span><a href="{{ routes.collections_url }}/wastafelkranen">{{ 'bc_pilot_category.wastafelkranen' | t }}</a></li>
+      <li><span aria-hidden="true">/</span><a href="{{ routes.collections_url }}/opbouw-wastafelkranen">{{ 'bc_pilot_category.opbouw' | t }}</a></li>
+      <li><span aria-hidden="true">/</span><span aria-current="page">{{ product.title | escape }}</span></li>
+    </ol>
+  </nav>
+{%- endif -%}
--- a/snippets/bc-product-documents.liquid
+++ b/snippets/bc-product-documents.liquid
@@ -0,0 +1,44 @@
+{% doc %}
+  Displays stored technical links for the reviewed 24.3710 pilot, using the Sunshower document layout.
+  @param {product} product - Current product.
+  @param {string} section_id - Main product section identifier.
+{% enddoc %}
+{%- liquid
+  assign documents_vendor = product.vendor | strip | downcase
+  assign documents = product.metafields.custom.technische_documenten
+-%}
+{%- if documents_vendor == 'wiesbaden' and product.has_only_default_variant and product.selected_or_first_available_variant.sku == '24.3710' and documents.type == 'list.url' -%}
+  {%- capture document_rows -%}
+    {%- assign document_urls = documents.value | uniq -%}
+    {%- for document_url in document_urls -%}
+      {%- liquid
+        assign protocol = document_url | slice: 0, 8
+        assign document_path = document_url | split: '?' | first | split: '#' | first | downcase
+        assign extension = document_path | split: '/' | last | split: '.' | last
+        assign label_key = 'bc_product_documents.document'
+        assign file_type = extension | upcase
+        if extension == 'jpg' or extension == 'jpeg' or extension == 'png' or extension == 'webp'
+          assign label_key = 'bc_product_documents.drawing'
+        elsif extension == 'pdf' and document_path contains '/handleidingen/'
+          assign label_key = 'bc_product_documents.manual'
+        endif
+      -%}
+      {%- if protocol == 'https://' -%}
+        <li>
+          <a href="{{ document_url | escape }}" target="_blank" rel="noopener noreferrer">
+            <svg class="bc-product-documents__file{% if extension == 'pdf' %} bc-product-documents__file--pdf{% endif %}" viewBox="0 0 24 28" aria-hidden="true"><path d="M4 1h10l6 6v19H4V1Z M14 1v7h6"/><text x="5" y="21">{{ file_type | escape }}</text></svg>
+            <span>{{ label_key | t }} {{ product.selected_or_first_available_variant.sku | escape }}</span>
+            <svg class="bc-product-documents__arrow" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 2v10m-4-4 4 4 4-4M3 14v3h14v-3"/></svg>
+          </a>
+        </li>
+      {%- endif -%}
+    {%- endfor -%}
+  {%- endcapture -%}
+  {%- assign document_rows = document_rows | strip -%}
+  {%- if document_rows != blank -%}
+    <div class="bc-product-documents" id="ProductDocuments-{{ section_id | escape }}" aria-labelledby="ProductDocumentsTitle-{{ section_id | escape }}">
+      <h3 id="ProductDocumentsTitle-{{ section_id | escape }}">{{ 'ss.documents' | t }}</h3>
+      <ul class="bc-product-documents__list" role="list">{{ document_rows }}</ul>
+    </div>
+  {%- endif -%}
+{%- endif -%}
