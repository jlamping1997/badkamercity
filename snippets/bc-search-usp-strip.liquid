<div class="bc-search-usp-strip" aria-label="{{ 'bc_listing.usp_label' | t | escape }}">
  <div class="bc-search-usp-strip__item">
    <span class="bc-search-usp-strip__icon" aria-hidden="true">
      {{- 'icon-stopwatch.svg' | inline_asset_content -}}
    </span>
    <span class="bc-search-usp-strip__title">{{ 'bc_listing.delivery_per_item' | t }}</span>
  </div>

  <div class="bc-search-usp-strip__item">
    <span class="bc-search-usp-strip__icon" aria-hidden="true">
      {{- 'icon-truck.svg' | inline_asset_content -}}
    </span>
    <span class="bc-search-usp-strip__title">{{ 'bc_listing.free_shipping' | t }}</span>
  </div>

  <div class="bc-search-usp-strip__item">
    <span class="bc-search-usp-strip__icon" aria-hidden="true">
      {{- 'icon-chat-bubble.svg' | inline_asset_content -}}
    </span>
    <span class="bc-search-usp-strip__title">{{ 'bc_listing.expert_advice' | t }}</span>
  </div>
</div>
