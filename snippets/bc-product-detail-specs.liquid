{% doc %}
  Shows verified grouped Hotbath specifications and preserves the previous renderer for other products.
  @param {product} product - Current product.
  @param {string} section_id - Main product section identifier.
{% enddoc %}
{%- capture bc_normal_scope -%}{%- render 'bc-hotbath-normal-scope', product: product -%}{%- endcapture -%}
{%- assign bc_normal_scope = bc_normal_scope | strip -%}
{%- if bc_normal_scope == 'ready' -%}
  {%- render 'bc-hotbath-public-specs', product: product, section_id: section_id -%}
{%- else -%}
  {%- render 'bc-product-detail-specs-legacy', product: product, section_id: section_id -%}
{%- endif -%}
