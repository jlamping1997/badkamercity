{% liquid
  assign form_id = 'ReturnForm-' | append: section.id
  assign support_email = shop.email
%}
<section class="bcr" aria-labelledby="ReturnHeading-{{ section.id }}">
  <div class="bcr-shell">
    <nav class="bcr-crumb" aria-label="{{ 'bc_assortment.breadcrumb' | t | escape }}"><a href="{{ routes.root_url }}">{{ 'bc_assortment.home' | t }}</a><span aria-hidden="true">›</span><span>{{ 'bc_returns.heading' | t }}</span></nav>
    <div class="bcr-intro"><p class="bcr-eyebrow">{{ 'bc_returns.eyebrow' | t }}</p><h1 id="ReturnHeading-{{ section.id }}">{{ 'bc_returns.heading' | t }}</h1><p>{{ 'bc_returns.intro' | t }}</p></div>
    <div class="bcr-grid">

      <div class="bcr-panel">
        {% form 'contact', id: form_id, class: 'bcr-form', return_to: 'back' %}
          {% if form.posted_successfully? %}
            <div class="bcr-status bcr-success" role="status" tabindex="-1"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m7 12 3 3 7-7"/></svg><h2>{{ 'bc_returns.success_heading' | t }}</h2><p>{{ 'bc_returns.success_text' | t }}</p><a href="mailto:{{ support_email | escape }}">{{ support_email | escape }}</a></div>
          {% else %}
            <div class="bcr-panel-intro"><h2>{{ 'bc_returns.form_heading' | t }}</h2><p>{{ 'bc_returns.form_intro' | t }}</p></div>
            {% if form.errors %}<div class="bcr-status bcr-error" role="alert" tabindex="-1"><h3>{{ 'bc_returns.error_heading' | t }}</h3><p>{{ 'bc_returns.error_text' | t }}</p>{{ form.errors | default_errors }}</div>{% endif %}
            <input type="hidden" name="contact[Onderwerp]" value="{{ 'bc_returns.topic_value' | t | escape }}">
            <div class="bcr-pair">
              <div class="bcr-field"><label for="{{ form_id }}-name">{{ 'bc_returns.name' | t }} <span aria-hidden="true">*</span></label><input type="text" id="{{ form_id }}-name" name="contact[name]" autocomplete="name" maxlength="100" required value="{% if form.name %}{{ form.name | escape }}{% elsif customer %}{{ customer.name | escape }}{% endif %}"></div>
              <div class="bcr-field"><label for="{{ form_id }}-email">{{ 'bc_returns.email' | t }} <span aria-hidden="true">*</span></label><input type="email" id="{{ form_id }}-email" name="contact[email]" autocomplete="email" autocapitalize="off" spellcheck="false" maxlength="254" required value="{% if form.email %}{{ form.email | escape }}{% elsif customer %}{{ customer.email | escape }}{% endif %}"{% if form.errors contains 'email' %} aria-invalid="true"{% endif %}></div>
            </div>
            <div class="bcr-pair">
              <div class="bcr-field"><label for="{{ form_id }}-order">{{ 'bc_returns.order' | t }} <small>{{ 'bc_returns.optional' | t }}</small></label><input type="text" id="{{ form_id }}-order" name="contact[Bestelnummer]" maxlength="80" placeholder="{{ 'bc_returns.order_placeholder' | t | escape }}" aria-describedby="{{ form_id }}-order-help"><p class="bcr-hint" id="{{ form_id }}-order-help">{{ 'bc_returns.order_help' | t }}</p></div>
              <div class="bcr-field"><label for="{{ form_id }}-request">{{ 'bc_returns.request' | t }} <span aria-hidden="true">*</span></label><select id="{{ form_id }}-request" name="contact[Verzoek]" required><option value="" disabled selected>{{ 'bc_returns.choose' | t }}</option><option>{{ 'bc_returns.request_return' | t }}</option><option>{{ 'bc_returns.request_exchange' | t }}</option><option>{{ 'bc_returns.request_problem' | t }}</option></select></div>
            </div>
            <div class="bcr-field"><label for="{{ form_id }}-products">{{ 'bc_returns.products' | t }} <span aria-hidden="true">*</span></label><textarea id="{{ form_id }}-products" name="contact[body]" rows="3" maxlength="2500" required placeholder="{{ 'bc_returns.products_placeholder' | t | escape }}" aria-describedby="{{ form_id }}-products-help">{{ form.body | escape }}</textarea><p class="bcr-hint" id="{{ form_id }}-products-help">{{ 'bc_returns.products_help' | t }}</p></div>
            <div class="bcr-field"><label for="{{ form_id }}-reason">{{ 'bc_returns.reason' | t }} <small>{{ 'bc_returns.optional' | t }}</small></label><select id="{{ form_id }}-reason" name="contact[Reden]" aria-describedby="{{ form_id }}-reason-help">{% assign reasons = 'none,wrong_order,fit,damage,wrong_delivery,defect,other' | split: ',' %}{% for reason in reasons %}{% assign reason_key = 'bc_returns.reason_' | append: reason %}<option>{{ reason_key | t }}</option>{% endfor %}</select><p class="bcr-hint" id="{{ form_id }}-reason-help">{{ 'bc_returns.reason_help' | t }}</p></div>
            <div class="bcr-field"><label for="{{ form_id }}-message">{{ 'bc_returns.message' | t }} <small>{{ 'bc_returns.optional' | t }}</small></label><textarea id="{{ form_id }}-message" name="contact[Toelichting]" rows="3" maxlength="3000" placeholder="{{ 'bc_returns.message_placeholder' | t | escape }}"></textarea></div>
            <button class="bcr-button" type="submit">{{ 'bc_returns.send' | t }}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 12h15m-5-5 5 5-5 5"/></svg></button>
            <p class="bcr-privacy">{{ 'bc_returns.privacy' | t }}{% if shop.privacy_policy != blank %} <a href="{{ shop.privacy_policy.url }}">{{ 'bc_returns.privacy_link' | t }}</a>{% endif %}</p>
          {% endif %}
        {% endform %}
      </div>
      <aside class="bcr-guide" aria-labelledby="ReturnSteps-{{ section.id }}"><h2 id="ReturnSteps-{{ section.id }}">{{ 'bc_returns.steps_heading' | t }}</h2><ol>
        {% for index in (1..3) %}{% assign title_key = 'bc_returns.step_' | append: index | append: '_title' %}{% assign text_key = 'bc_returns.step_' | append: index | append: '_text' %}<li><span aria-hidden="true">{{ index }}</span><div><h3>{{ title_key | t }}</h3><p>{{ text_key | t }}</p></div></li>{% endfor %}
      </ol><div class="bcr-help"><h3>{{ 'bc_returns.help_heading' | t }}</h3><p>{{ 'bc_returns.help_text' | t }}</p><a href="mailto:{{ support_email | escape }}">{{ support_email | escape }}</a></div></aside>
    </div>
    <div class="bcr-faq"><h2>{{ 'bc_returns.faq_label' | t }}</h2>{% assign topics = 'label,address,damage,cost' | split: ',' %}{% for topic in topics %}{% assign question_key = 'bc_returns.faq_' | append: topic | append: '_question' %}{% assign answer_key = 'bc_returns.faq_' | append: topic | append: '_answer' %}<details><summary>{{ question_key | t }}<span aria-hidden="true">+</span></summary><p>{{ answer_key | t }}</p></details>{% endfor %}</div>
    <p class="bcr-rights">{{ 'bc_returns.rights' | t }} <a href="mailto:{{ support_email | escape }}">{{ support_email | escape }}</a></p>
  </div>
</section>
{% stylesheet %}
.bcr{color:#102b40;background:#f7fafb;padding:30px 0 60px;letter-spacing:0;line-height:1.55}.bcr *{box-sizing:border-box}.bcr-shell{width:min(1120px,100% - 48px);margin:0 auto}.bcr :is(h1,h2,h3,p,ol){margin:0}.bcr a{color:#1f6685;text-underline-offset:4px}.bcr-crumb{display:flex;gap:10px;align-items:center;font-size:13px;color:#60727f;margin-bottom:28px}.bcr-crumb a{color:inherit}.bcr-intro{max-width:680px;margin-bottom:30px}.bcr-eyebrow{font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#49758a;margin-bottom:9px!important}.bcr h1{font-size:clamp(30px,4vw,44px);line-height:1.15;letter-spacing:-.035em;margin-bottom:13px}.bcr-intro>p:last-child{font-size:17px;color:#536775}.bcr-grid{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(240px,.8fr);gap:48px;align-items:start}.bcr h2{font-size:21px;line-height:1.3;letter-spacing:-.02em}.bcr h3{font-size:15px;font-weight:700;line-height:1.4}.bcr-guide{padding-top:6px}.bcr-guide ol{padding:0;list-style:none;display:grid;gap:24px;margin-top:24px}.bcr-guide li{display:flex;gap:13px;align-items:start}.bcr-guide li>span{display:grid;place-items:center;flex:0 0 30px;height:30px;border-radius:50%;background:#e3f2f8;color:#1f6685;font-size:13px;font-weight:700}.bcr-guide li p,.bcr-help p{font-size:14px;color:#60727f;margin-top:5px}.bcr-help{border-top:1px solid #dce6ec;margin-top:28px;padding-top:22px}.bcr-help a{display:inline-block;margin-top:8px;font-size:14px}.bcr-panel{min-width:0;background:white;border:1px solid #e0e8ee;border-radius:12px;padding:28px;box-shadow:0 8px 30px #102b4005}.bcr-form{display:grid;gap:20px}.bcr-panel-intro p{margin-top:8px;color:#60727f;font-size:13px}.bcr-pair{display:grid;grid-template-columns:1fr 1fr;gap:16px}.bcr-field{min-width:0;display:flex;flex-direction:column;gap:7px}.bcr-field label{font-size:13px;font-weight:700;line-height:1.4}.bcr-field label small{font-size:11px;font-weight:400;color:#71818b;margin-left:4px}.bcr-field :is(input,select,textarea){width:100%;max-width:100%;border:1px solid #cedbe3;border-radius:6px;background:#fff;color:#102b40;font-family:inherit;font-size:16px;font-weight:400;line-height:1.45;letter-spacing:0;padding:12px;box-shadow:none;min-height:46px}.bcr-field select{padding-right:24px}.bcr-field textarea{resize:vertical;min-height:92px}.bcr-field ::placeholder{color:#86959f;opacity:1}.bcr-field :is(input,select,textarea):focus-visible,.bcr :is(a,button,summary):focus-visible{outline:2px solid #1f6685;outline-offset:3px;box-shadow:none}.bcr-hint{font-size:11px!important;line-height:1.5;color:#71818b}.bcr-button{display:flex;justify-content:center;align-items:center;gap:12px;width:100%;border:1px solid #102b40;border-radius:6px;background:#102b40;color:white;padding:14px 18px;min-height:50px;font:700 15px/1.4 var(--font-body-family,Arial,sans-serif);cursor:pointer}.bcr-button:hover{background:#1f455d}.bcr-privacy{font-size:11px;color:#71818b;line-height:1.6}.bcr-status{padding:18px;border-radius:8px}.bcr-status p{margin-top:8px;font-size:14px}.bcr-success{background:#edf7f3;color:#175c47;display:grid;gap:8px}.bcr-success a{color:inherit}.bcr-error{background:#fff3ef;color:#8a3b2a}.bcr-error ul{padding-left:20px;font-size:13px}.bcr-faq{max-width:760px;margin:42px auto 0}.bcr-faq h2{margin-bottom:14px}.bcr-faq details{border-bottom:1px solid #dce6ec;padding:17px 0}.bcr-faq summary{display:flex;justify-content:space-between;align-items:center;gap:16px;list-style:none;cursor:pointer;font-size:14px;font-weight:600}.bcr-faq summary::-webkit-details-marker{display:none}.bcr-faq summary span{font-size:23px;font-weight:400;line-height:1}.bcr-faq details[open] summary span{transform:rotate(45deg)}.bcr-faq details p{padding-top:12px;font-size:14px;color:#60727f;max-width:650px}.bcr-rights{font-size:11px;color:#71818b;max-width:760px;margin:24px auto 0!important}.bcr-rights a{white-space:nowrap}@media(max-width:749px){.bcr{padding:22px 0 36px}.bcr-shell{width:calc(100% - 28px)}.bcr-crumb{margin-bottom:22px}.bcr-intro{margin-bottom:22px}.bcr-intro>p:last-child{font-size:15px}.bcr-grid{grid-template-columns:1fr;gap:22px}.bcr-panel{padding:20px 16px}.bcr-pair{grid-template-columns:1fr;gap:18px}.bcr-form{gap:18px}.bcr-guide{padding:4px 6px 0}.bcr-guide ol{gap:18px;margin-top:18px}.bcr-help{margin-top:20px;padding-top:18px}.bcr-faq{margin-top:28px}.bcr h2{font-size:19px}}
{% endstylesheet %}
