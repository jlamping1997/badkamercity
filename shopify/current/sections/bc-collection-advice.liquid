{% unless request.page_type == 'collection' %}{{ 'bc-collection.css' | asset_url | stylesheet_tag }}{% endunless %}
{%- liquid
  assign tree_menu = section.settings.navigation_menu | default: linklists['main-menu']
  assign is_faucet_category = false
  for root_link in tree_menu.links
    if root_link.object.handle == 'kranen'
      if root_link.object.id == collection.id
        assign is_faucet_category = true
      endif
      for middle_link in root_link.links
        if middle_link.object.id == collection.id
          assign is_faucet_category = true
        endif
        for leaf_link in middle_link.links
          if leaf_link.object.id == collection.id
            assign is_faucet_category = true
          endif
        endfor
      endfor
    endif
  endfor
-%}
{%- liquid
  assign description_parts = collection.description | replace: '<p>[SPLIT]</p>', '__BC_SPLIT__' | replace: '<p>[split]</p>', '__BC_SPLIT__' | replace: '[SPLIT]', '__BC_SPLIT__' | replace: '[split]', '__BC_SPLIT__' | split: '__BC_SPLIT__'
  assign editorial_fallback = ''
  case collection.handle
    when 'bad-accessoires'
      assign editorial_fallback = 'bath'
    when 'badgrepen'
      assign editorial_fallback = 'grab_rails'
  endcase
-%}
{%- capture category_content -%}
  {%- unless collection.template_suffix == 'category-landing' -%}
    {%- for description_part in description_parts offset: 1 -%}
      {{ description_part }}
    {%- endfor -%}
  {%- endunless -%}
  {%- if section.settings.extra_content != blank -%}
    {{ section.settings.extra_content }}
  {%- endif -%}
{%- endcapture -%}
{%- assign category_content_text = category_content | strip_html | strip -%}
<section id="bc-category-advice-{{ collection.id }}" class="bc-collection-advice" aria-label="{{ 'bc_collection.editorial.about' | t: category: collection.title | escape }}">
  <div class="page-width">
    <div class="bc-category-editorial">
      {%- if category_content_text != blank -%}
        <div class="bc-category-editorial__text rte">{{ category_content }}</div>
      {%- elsif editorial_fallback != blank -%}
        {%- assign editorial_prefix = 'bc_collection.editorial.' | append: editorial_fallback -%}
        <div class="bc-category-editorial__text rte">
          <h2>{{ editorial_prefix | append: '.heading' | t }}</h2>
          <p>{{ editorial_prefix | append: '.intro' | t }}</p>
          <h3>{{ editorial_prefix | append: '.title' | t }}</h3>
          <p>{{ editorial_prefix | append: '.body' | t }}</p>
          {%- if editorial_fallback == 'bath' -%}
            <p><a href="{{ routes.collections_url }}/badgrepen">{{ 'bc_collection.editorial.grab_rails_link' | t }}</a> · <a href="{{ routes.collections_url }}/badbruggen-badplanken">{{ 'bc_collection.editorial.bath_trays_link' | t }}</a></p>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- if section.settings.show_faq and is_faucet_category -%}
      <div class="bc-category-faq">
        <h2>{{ 'bc_collection.faq_title' | t: category: collection.title }}</h2>
        {%- for index in (1..3) -%}
          {%- assign question_key = 'bc_collection.faq.question_' | append: index -%}
          {%- assign answer_key = 'bc_collection.faq.answer_' | append: index -%}
          <details class="bc-category-faq__item">
            <summary>{{ question_key | t }}<span class="svg-wrapper" aria-hidden="true">{{ 'icon-caret.svg' | inline_asset_content }}</span></summary>
            <div class="bc-category-faq__answer"><p>{{ answer_key | t }}</p></div>
          </details>
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- if section.settings.show_contact and pages['contact'] != blank -%}
      <p class="bc-category-editorial__contact">{{ 'bc_collection.help_title' | t }} <a href="{{ pages['contact'].url }}">{{ 'bc_collection.contact' | t }} <span aria-hidden="true">→</span></a></p>
    {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "BC categorietekst",
  "settings": [
    {"type":"link_list","id":"navigation_menu","label":"Menu voor categorieboom","default":"main-menu"},
    {"type":"richtext","id":"extra_content","label":"Extra categorietekst"},
    {"type":"checkbox","id":"show_faq","label":"Toon veelgestelde vragen bij kranen","default":true},
    {"type":"checkbox","id":"show_contact","label":"Toon compacte advieslink","default":true}
  ],
  "presets": [{"name":"BC categorietekst"}]
}
{% endschema %}

