{{ 'bc-kitkat-guide.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bc-kitkat-guide.js' | asset_url }}" defer="defer"></script>
{%- assign translation_prefix = 'sections.bc-kitkat-guide.' -%}
{%- paginate collection.products by 250 -%}
  <bc-kitkat-guide class="bc-kg"
    data-kg-guide
    data-kg-section="{{ section.id | escape }}"
    data-kg-page="{{ paginate.current_page }}"
    data-kg-pages="{{ paginate.pages }}"
    data-kg-total="{{ paginate.items }}"
    data-kg-page-param="{{ paginate.page_param | escape }}"
    data-kg-one="{{ translation_prefix | append: 'result_one' | t | escape }}"
    data-kg-many="{{ translation_prefix | append: 'result_many' | t | escape }}"
    data-kg-loading="{{ translation_prefix | append: 'loading' | t | escape }}"
    data-kg-partial="{{ translation_prefix | append: 'partial' | t | escape }}">
    <nav aria-label="{{ translation_prefix | append: 'breadcrumb' | t | escape }}" class="kg-crumb">
      <a href="{{ routes.root_url }}">{{ translation_prefix | append: 'home' | t }}</a>
      <span aria-hidden="true">/</span>
      <a href="{{ collections['tegels'].url | default: routes.all_products_collection_url }}">{{ translation_prefix | append: 'tiles' | t }}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ collection.title | escape }}</span>
    </nav>
    {% if paginate.current_page == 1 %}
      <header class="kg-hero">
        <div class="kg-intro">
          <h1>{{ collection.title | escape }}</h1>
          <p class="kg-lead">{{ section.settings.intro | escape }}</p>
          <div class="kg-hero-actions">
            <a class="kg-button kg-primary" href="#kitkat-kleuren">{{ translation_prefix | append: 'browse' | t }}</a>
            <a class="kg-button kg-secondary" href="#kitkat-formaten">{{ translation_prefix | append: 'compare' | t }}</a>
          </div>
        </div>
        {%- assign hero = section.settings.hero_image | default: collection.image -%}
        {% if hero %}
          <figure class="kg-hero-photo">
            {{ hero
              | image_url: width: 1340
              | image_tag: widths: '430,650,900,1100,1340', sizes: '(min-width: 1280px) 570px, (min-width: 750px) 44vw, 96vw', loading: 'eager', fetchpriority: 'high'
            }}
          </figure>
        {% endif %}
      </header>
      {% if section.blocks.size > 0 %}
        <section id="kitkat-formaten" class="kg-ranges" aria-labelledby="kg-ranges-title-{{ section.id }}">
          <h2 id="kg-ranges-title-{{ section.id }}">{{ translation_prefix | append: 'range_heading' | t }}</h2>
          <p class="kg-section-note">{{ translation_prefix | append: 'range_note' | t }}</p>
          <div class="kg-range-grid">
            {% for block in section.blocks %}
              {% assign example = block.settings.example %}
              <article class="kg-range{% if block.settings.key == 'travertin' %} kg-range-stone{% endif %}" {{ block.shopify_attributes }}>
                {% if example.featured_image %}
                  <div class="kg-range-photo kg-tone-{{ block.settings.key | escape }}">
                    {{ example.featured_image
                      | image_url: width: 580
                      | image_tag: widths: '210,330,440,580', sizes: '(min-width: 1100px) 240px, (min-width: 750px) 22vw, 42vw', loading: 'lazy', alt: ''
                    }}
                  </div>
                {% endif %}
                <div class="kg-range-text">
                  <p class="kg-dimensions">{{ block.settings.size | escape }}</p>
                  <h3>{{ block.settings.title | escape }}</h3>
                  <p class="kg-range-note">{{ block.settings.description | escape }}</p>
                </div>
                <button type="button" class="kg-button kg-secondary" data-kg-choose="{{ block.settings.key | escape }}" hidden
                  aria-label="{{ translation_prefix | append: 'choose_series' | t: name: block.settings.title | escape }}">
                  {{ translation_prefix | append: 'choose' | t }}
                </button>
                {% if example %}
                  <a class="kg-button kg-secondary" data-kg-fallback href="{{ example.url }}">{{ translation_prefix | append: 'example' | t }}</a>
                {% endif %}
              </article>
            {% endfor %}
          </div>
        </section>
      {% endif %}
    {% else %}
      <header class="kg-page-header">
        <h1>{{ collection.title | escape }}</h1>
        <a class="kg-button kg-secondary" href="{{ collection.url }}#kitkat-formaten">{{ translation_prefix | append: 'compare' | t }}</a>
      </header>
    {% endif %}

    <section class="kg-catalog" id="kitkat-kleuren" aria-labelledby="kg-colors-title-{{ section.id }}">
      <h2 id="kg-colors-title-{{ section.id }}" tabindex="-1">{{ translation_prefix | append: 'color_heading' | t }}</h2>
      <p class="kg-section-note">{{ translation_prefix | append: 'color_note' | t }}</p>
      <form data-kg-form class="kg-controls" hidden>
        {%- assign dimensions = 'material,size,series,color,finish' | split: ',' -%}
        {% for dimension in dimensions %}
          {%- liquid
            case dimension
              when 'material'
                assign values = 'keramiek,travertin,overig'
              when 'size'
                assign values = '12,19,20,22-145,22-148,overig'
              when 'series'
                assign values = 'mini,original,kitkat22,osiris,travertin,overig'
              when 'color'
                assign values = 'beige,blauw,brons,bruin,geel,grijs,groen,rood,roze,wit,zwart,overig'
              when 'finish'
                assign values = 'mat,glans,mix,metallic,steen,overig'
            endcase
            assign values = values | split: ','
          -%}
          <label>
            <span>{{ translation_prefix | append: dimension | t }}</span>
            <select data-kg-filter="{{ dimension }}">
              <option value="">{{ translation_prefix | append: 'all' | t }}</option>
              {% for value in values %}
                <option value="{{ value }}">
                  {%- if dimension == 'size' and value != 'overig' -%}
                    {%- case value -%}
                      {%- when '12' -%}12 × 92 mm
                      {%- when '19' -%}19 × 152 mm
                      {%- when '20' -%}20 × 145 mm
                      {%- when '22-145' -%}22 × 145 mm
                      {%- when '22-148' -%}22 × 148 mm
                    {%- endcase -%}
                  {%- else -%}
                    {{- translation_prefix | append: value | t -}}
                  {%- endif -%}
                </option>
              {% endfor %}
            </select>
          </label>
        {% endfor %}
        <button class="kg-clear" type="reset" data-kg-clear>{{ translation_prefix | append: 'reset' | t }}</button>
      </form>
      <p role="status" aria-live="polite" aria-atomic="true" class="kg-result" data-kg-result>
        {% if paginate.items == 1 %}{{ paginate.items }} {{ translation_prefix | append: 'result_one' | t }}{% else %}{{ paginate.items }} {{ translation_prefix | append: 'result_many' | t }}{% endif %}
      </p>
      <ul class="kg-palette" data-kg-list role="list">
        {% for tile in collection.products %}
          {% render 'bc-kitkat-item', tile: tile %}
        {% endfor %}
      </ul>
      {% if paginate.items == 0 %}<p class="kg-empty">{{ translation_prefix | append: 'empty_collection' | t }}</p>{% endif %}
      <div data-kg-empty class="kg-empty" hidden>
        <p>{{ translation_prefix | append: 'empty' | t }}</p>
        <button type="button" class="kg-button kg-secondary" data-kg-reset>{{ translation_prefix | append: 'reset' | t }}</button>
      </div>
      {% if paginate.pages > 1 %}
        <nav data-kg-pager class="kg-pager" aria-label="{{ translation_prefix | append: 'pagination' | t | escape }}">
          {% if paginate.previous %}<a href="{{ paginate.previous.url }}#kitkat-kleuren">{{ translation_prefix | append: 'previous' | t }}</a>{% endif %}
          <span>{{ translation_prefix | append: 'page_number' | t: number: paginate.current_page, total: paginate.pages }}</span>
          {% if paginate.next %}<a href="{{ paginate.next.url }}#kitkat-kleuren">{{ translation_prefix | append: 'next' | t }}</a>{% endif %}
        </nav>
      {% endif %}
    </section>
    {% if paginate.current_page == 1 %}
      <section class="kg-questions" aria-labelledby="kg-questions-title-{{ section.id }}">
        <div>
          <h2 id="kg-questions-title-{{ section.id }}">{{ translation_prefix | append: 'faq_title' | t }}</h2>
          {% if pages['contact'] %}
            <a class="kg-button kg-secondary" href="{{ pages['contact'].url }}">{{ translation_prefix | append: 'contact' | t }}</a>
          {% endif %}
        </div>
        <div>
          {% assign tips = 'sheet,stone_sheet,grout,stone_care,laying,bronze' | split: ',' %}
          {% for tip in tips %}
            <details>
              <summary>{{ translation_prefix | append: 'q_' | append: tip | t }}</summary>
              <p>{{ translation_prefix | append: 'a_' | append: tip | t }}</p>
              {% if tip == 'bronze' %}
                {%- assign bronze = all_products['the-mosaic-factory-sevilla-kitkat-original-finger-bronze-metallic-mozaiektegel-sef20b'] -%}
                {% if bronze != blank %}<a href="{{ bronze.url }}">{{ translation_prefix | append: 'bronze_product' | t }}</a>{% endif %}
              {% endif %}
            </details>
          {% endfor %}
        </div>
      </section>
    {% endif %}
  </bc-kitkat-guide>
{%- endpaginate -%}

