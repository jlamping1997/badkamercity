{{ 'bc-kitkat-guide.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bc-kitkat-guide.js' | asset_url }}" defer="defer"></script>
{%- assign translation_prefix = 'sections.bc-kitkat-guide.' -%}
{%- paginate collection.products by 250 -%}
  <bc-kitkat-guide class="bc-kg"
    data-kg-guide
    data-kg-section="{{ section.id | escape }}"
    data-kg-page="{{ paginate.current_page }}"
    data-kg-pages="{{ paginate.pages }}"
    data-kg-total="{{ paginate.items }}"
    data-kg-page-param="{{ paginate.page_param | escape }}"
    data-kg-one="{{ translation_prefix | append: 'result_one' | t | escape }}"
    data-kg-many="{{ translation_prefix | append: 'result_many' | t | escape }}"
    data-kg-loading="{{ translation_prefix | append: 'loading' | t | escape }}"
    data-kg-partial="{{ translation_prefix | append: 'partial' | t | escape }}">
    <nav aria-label="{{ translation_prefix | append: 'breadcrumb' | t | escape }}" class="kg-crumb">
      <a href="{{ routes.root_url }}">{{ translation_prefix | append: 'home' | t }}</a>
      <span aria-hidden="true">/</span>
      <a href="{{ collections['tegels'].url | default: routes.all_products_collection_url }}">{{ translation_prefix | append: 'tiles' | t }}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ collection.title | escape }}</span>
    </nav>
    {% if paginate.current_page == 1 %}
      <header class="kg-hero">
        <div class="kg-intro">
          <h1>{{ translation_prefix | append: 'guide_heading' | t }}</h1>
          {%- assign intro = section.settings.intro | strip -%}
          {%- if intro == blank -%}
            {%- assign intro = translation_prefix | append: 'guide_intro' | t -%}
          {%- endif -%}
          <p class="kg-lead">{{ intro | escape }}</p>
          <div class="kg-hero-actions">
            <a class="kg-button kg-primary" href="#kitkat-kleuren">{{ translation_prefix | append: 'browse' | t }}</a>
            <a class="kg-button kg-secondary" href="#kitkat-formaten">{{ translation_prefix | append: 'compare' | t }}</a>
          </div>
        </div>
        {%- assign hero = section.settings.hero_image | default: collection.image -%}
        {% if hero %}
          <figure class="kg-hero-photo">
            {{ hero
              | image_url: width: 1340
              | image_tag: widths: '430,650,900,1100,1340', sizes: '(min-width: 1280px) 570px, (min-width: 750px) 44vw, 96vw', loading: 'eager', fetchpriority: 'high'
            }}
          </figure>
        {% endif %}
      </header>
      {%- assign room_blocks = section.blocks | where: 'type', 'room' -%}
      {% if room_blocks.size > 0 %}
        <section class="kg-rooms" aria-labelledby="kg-rooms-title-{{ section.id }}">
          <h2 id="kg-rooms-title-{{ section.id }}">{{ translation_prefix | append: 'rooms_heading' | t }}</h2>
          <div class="kg-room-grid">
            {% for block in room_blocks %}
              {% liquid
                assign tile = block.settings.tile
                assign image_index = block.settings.image_number | minus: 1
                assign room_photo = block.settings.room_photo | default: tile.images[image_index]
              %}
              {% if tile != blank and room_photo != blank %}
                <article class="kg-room" {{ block.shopify_attributes }}>
                  <a class="kg-room-photo" href="{{ tile.url }}" aria-label="{{ block.settings.link_label | default: tile.title | escape }}">
                    {{ room_photo | image_url: width: 840 | image_tag: widths: '300,420,620,840', sizes: '(min-width: 1000px) 29vw, (min-width: 620px) 42vw, 88vw', loading: 'lazy', alt: block.settings.alt }}
                  </a>
                  <div class="kg-room-copy">
                    <h3>{{ block.settings.title | escape }}</h3>
                    <p>{{ block.settings.description | escape }}</p>
                    <a class="kg-button kg-secondary" href="{{ tile.url }}">{{ block.settings.link_label | default: tile.title | escape }}</a>
                  </div>
                </article>
              {% endif %}
            {% endfor %}
          </div>
        </section>
      {% endif %}
    {% else %}
      <header class="kg-page-header">
        <h1>{{ translation_prefix | append: 'guide_heading' | t }}</h1>
        <a class="kg-button kg-secondary" href="{{ collection.url }}#kitkat-formaten">{{ translation_prefix | append: 'compare' | t }}</a>
      </header>
    {% endif %}

    <section class="kg-catalog" id="kitkat-kleuren" aria-labelledby="kg-colors-title-{{ section.id }}">
      <h2 id="kg-colors-title-{{ section.id }}" tabindex="-1">{{ translation_prefix | append: 'color_heading' | t }}</h2>
      <p class="kg-section-note">{{ translation_prefix | append: 'color_note' | t }}</p>
      {% if paginate.current_page == 1 %}
        {%- assign shade_guides = 'beige,groen,wit' | split: ',' -%}
        <details class="kg-colour-guide">
          <summary>{{ translation_prefix | append: 'colour_help' | t }}</summary>
          <ul role="list">
            {% for shade in shade_guides %}
              {% liquid
                case shade
                  when 'beige'
                    assign handles = 'the-mosaic-factory-sevilla-kitkat-mini-finger-desert-beige-glossy-mozaiektegel-sef12225,the-mosaic-factory-natural-stone-travertine-beige-matt-mozaiektegel-ntk01'
                  when 'groen'
                    assign handles = 'the-mosaic-factory-sevilla-kitkat-original-finger-sage-green-matt-mozaiektegel-sef20575,the-mosaic-factory-sevilla-kitkat-original-finger-forest-green-glossy-mozaiektegel-sef20525'
                  when 'wit'
                    assign handles = 'the-mosaic-factory-sevilla-kitkat-original-finger-vintage-white-glossy-mozaiektegel-sef20120'
                endcase
                assign handles = handles | split: ','
              %}
              <li>
                <p><strong>{{ translation_prefix | append: shade | t }}.</strong> {{ translation_prefix | append: 'colour_' | append: shade | t }}</p>
                {% for handle in handles %}
                  {%- assign tile = all_products[handle] -%}
                  {% if tile != blank %}
                    <a href="{{ tile.url }}">{{ translation_prefix | append: 'tile_' | append: shade | append: '_' | append: forloop.index | t }}</a>
                  {% endif %}
                {% endfor %}
              </li>
            {% endfor %}
          </ul>
        </details>
      {% endif %}
      <div class="kg-colour-choices" data-kg-colour-choices hidden aria-label="{{ translation_prefix | append: 'quick_colour' | t | escape }}">
        {% assign featured_colours = 'beige,groen,wit,blauw,rood' | split: ',' %}
        {% for colour in featured_colours %}
          <button type="button" class="kg-colour" data-kg-colour="{{ colour }}" aria-pressed="false">
            <span class="kg-colour-dot" aria-hidden="true"></span>
            {{ translation_prefix | append: colour | t }}
          </button>
        {% endfor %}
      </div>
      <form data-kg-form class="kg-controls" hidden>
        {%- assign dimensions = 'color,finish,size,material,series' | split: ',' -%}
        {% for dimension in dimensions %}
          {%- liquid
            case dimension
              when 'material'
                assign values = 'keramiek,travertin,overig'
              when 'size'
                assign values = '12,19,20,22-145,22-148,overig'
              when 'series'
                assign values = 'mini,original,kitkat22,osiris,travertin,overig'
              when 'color'
                assign values = 'beige,blauw,brons,bruin,geel,grijs,groen,rood,roze,wit,zwart,overig'
              when 'finish'
                assign values = 'mat,glans,mix,metallic,steen,overig'
            endcase
            assign values = values | split: ','
          -%}
          <label>
            <span>{{ translation_prefix | append: dimension | t }}</span>
            <select data-kg-filter="{{ dimension }}">
              <option value="">{{ translation_prefix | append: 'all' | t }}</option>
              {% for value in values %}
                <option value="{{ value }}">
                  {%- if dimension == 'size' and value != 'overig' -%}
                    {%- case value -%}
                      {%- when '12' -%}1,2 × 9,2 cm
                      {%- when '19' -%}1,9 × 15,2 cm
                      {%- when '20' -%}2 × 14,5 cm
                      {%- when '22-145' -%}2,2 × 14,5 cm
                      {%- when '22-148' -%}2,2 × 14,8 cm
                    {%- endcase -%}
                  {%- else -%}
                    {{- translation_prefix | append: value | t -}}
                  {%- endif -%}
                </option>
              {% endfor %}
            </select>
          </label>
        {% endfor %}
        <button class="kg-clear" type="reset" data-kg-clear>{{ translation_prefix | append: 'reset' | t }}</button>
      </form>
      <p role="status" aria-live="polite" aria-atomic="true" class="kg-result" data-kg-result>
        {% if paginate.items == 1 %}{{ paginate.items }} {{ translation_prefix | append: 'result_one' | t }}{% else %}{{ paginate.items }} {{ translation_prefix | append: 'result_many' | t }}{% endif %}
      </p>
      <ul class="kg-palette" data-kg-list role="list">
        {% for tile in collection.products %}
          {% render 'bc-kitkat-item', tile: tile %}
        {% endfor %}
      </ul>
      {% if paginate.items == 0 %}<p class="kg-empty">{{ translation_prefix | append: 'empty_collection' | t }}</p>{% endif %}
      <div data-kg-empty class="kg-empty" hidden>
        <p>{{ translation_prefix | append: 'empty' | t }}</p>
        <button type="button" class="kg-button kg-secondary" data-kg-reset>{{ translation_prefix | append: 'reset' | t }}</button>
      </div>
      {% if paginate.pages > 1 %}
        <nav data-kg-pager class="kg-pager" aria-label="{{ translation_prefix | append: 'pagination' | t | escape }}">
          {% if paginate.previous %}<a href="{{ paginate.previous.url }}#kitkat-kleuren">{{ translation_prefix | append: 'previous' | t }}</a>{% endif %}
          <span>{{ translation_prefix | append: 'page_number' | t: number: paginate.current_page, total: paginate.pages }}</span>
          {% if paginate.next %}<a href="{{ paginate.next.url }}#kitkat-kleuren">{{ translation_prefix | append: 'next' | t }}</a>{% endif %}
        </nav>
      {% endif %}
    </section>
    {% if paginate.current_page == 1 %}
      {%- assign series_blocks = section.blocks | where: 'type', 'series' -%}
      {% if series_blocks.size > 0 %}
        <section id="kitkat-formaten" class="kg-ranges" aria-labelledby="kg-ranges-title-{{ section.id }}">
          <h2 id="kg-ranges-title-{{ section.id }}">{{ translation_prefix | append: 'range_heading' | t }}</h2>
          <p class="kg-section-note">{{ translation_prefix | append: 'range_note' | t }}</p>
          {%- assign table_rows = 'mini|1,2 × 9,2|28,2 × 30,8;original|2 × 14,5|29,6 × 29,9;kitkat22|2,2 × 14,5|29,6 × 30;osiris|2 × 14,5|29,6 × 29,9;stone_convex|1,9 × 15,2|30,1 × 30,8;stone_flat_original|2,2 × 14,8|30 × 30' | split: ';' -%}
          <table class="kg-size-table">
            <caption>{{ translation_prefix | append: 'size_table' | t }}</caption>
            <thead>
              <tr>
                <th scope="col">{{ translation_prefix | append: 'series' | t }}</th>
                <th scope="col">{{ translation_prefix | append: 'one_tile_cm' | t }}</th>
                <th scope="col">{{ translation_prefix | append: 'one_sheet_cm' | t }}</th>
              </tr>
            </thead>
            <tbody>
              {% for row in table_rows %}
                {%- assign columns = row | split: '|' -%}
                <tr>
                  <th scope="row">{{ translation_prefix | append: columns[0] | t }}</th>
                  <td>{{ columns[1] }}</td>
                  <td>{{ columns[2] }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
          <div class="kg-range-grid">
            {% for block in series_blocks %}
              {% assign example = block.settings.example %}
              <article class="kg-range{% if block.settings.key == 'travertin' %} kg-range-stone{% endif %}" {{ block.shopify_attributes }}>
                {% if example.featured_image %}
                  <div class="kg-range-photo kg-tone-{{ block.settings.key | escape }}">
                    {{ example.featured_image
                      | image_url: width: 580
                      | image_tag: widths: '210,330,440,580', sizes: '(min-width: 1100px) 240px, (min-width: 750px) 22vw, 42vw', loading: 'lazy', alt: ''
                    }}
                  </div>
                {% endif %}
                <div class="kg-range-text">
                  <p class="kg-dimensions">{{ block.settings.size | escape }}</p>
                  <h3>{{ block.settings.title | escape }}</h3>
                  <p class="kg-range-note">{{ block.settings.description | escape }}</p>
                </div>
                <button type="button" class="kg-button kg-secondary" data-kg-choose="{{ block.settings.key | escape }}" hidden
                  aria-label="{{ translation_prefix | append: 'choose_series' | t: name: block.settings.title | escape }}">
                  {{ translation_prefix | append: 'choose' | t }}
                </button>
                {% if example %}
                  <a class="kg-button kg-secondary" data-kg-fallback href="{{ example.url }}">{{ translation_prefix | append: 'example' | t }}</a>
                {% endif %}
              </article>
            {% endfor %}
          </div>
        </section>
      {% endif %}
      <section class="kg-questions" aria-labelledby="kg-questions-title-{{ section.id }}">
        <div>
          <h2 id="kg-questions-title-{{ section.id }}">{{ translation_prefix | append: 'faq_title' | t }}</h2>
          {% if pages['contact'] %}
            <a class="kg-button kg-secondary" href="{{ pages['contact'].url }}">{{ translation_prefix | append: 'contact' | t }}</a>
          {% endif %}
        </div>
        <div>
          {% assign tips = 'boxes,wet_wall,samples,grout,stone_care,laying' | split: ',' %}
          {% for tip in tips %}
            <details>
              <summary>{{ translation_prefix | append: 'q_' | append: tip | t }}</summary>
              <p>{{ translation_prefix | append: 'a_' | append: tip | t }}</p>
              {% liquid
                assign linked_tile = blank
                if tip == 'boxes' or tip == 'samples'
                  assign linked_tile = all_products['the-mosaic-factory-sevilla-kitkat-original-finger-sage-green-matt-mozaiektegel-sef20575']
                elsif tip == 'wet_wall'
                  assign linked_tile = all_products['the-mosaic-factory-sevilla-kitkat-original-finger-bronze-metallic-mozaiektegel-sef20b']
                endif
              %}
              {% if linked_tile != blank %}
                <a href="{{ linked_tile.url }}">{{ translation_prefix | append: 'product_' | append: tip | t }}</a>
              {% endif %}
            </details>
          {% endfor %}
        </div>
      </section>
    {% endif %}
  </bc-kitkat-guide>
{%- endpaginate -%}

{% stylesheet %}
  .bc-kg .kg-colour-guide {
    margin-block: 1.4rem .2rem;
    border-bottom: 1px solid var(--kg-line);
    font-size: 1.6rem;
  }
  .bc-kg .kg-colour-guide summary { cursor: pointer; padding: 1rem 0; font-weight: 650; }
  .bc-kg .kg-colour-guide ul { display: grid; gap: 1rem; list-style: none; padding: 0 0 1.4rem; }
  .bc-kg .kg-colour-guide a { display: inline-block; margin: .3rem 1.2rem .1rem 0; text-decoration: underline; }
  .bc-kg .kg-size-table { width: 100%; margin-top: 1.6rem; border-collapse: collapse; table-layout: fixed; font-size: clamp(1.3rem, 1.12vw, 1.6rem); }
  .bc-kg .kg-size-table caption { text-align: start; padding-bottom: .7rem; font-weight: 650; }
  .bc-kg .kg-size-table :is(th, td) { padding: .8rem clamp(.45rem, 1.5vw, 1.2rem); text-align: start; vertical-align: top; border-bottom: 1px solid var(--kg-line); }
  .bc-kg .kg-size-table thead { background: var(--kg-wash); }
  .bc-kg .kg-size-table :first-child > tr > :first-child { width: 42%; }
  .bc-kg .kg-size-table :is(th, td) { overflow-wrap: anywhere; }
{% endstylesheet %}

