{{ 'bc-home-sunshower.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sunshower_link = section.settings.link
  if sunshower_link == blank
    assign sunshower_link = pages['sunshower'].url | default: '/pages/sunshower'
  endif
  assign hero_image = section.settings.image
  assign mobile_image = section.settings.mobile_image
  assign image_alt = 'ss_home_v2.image_alt' | t
  assign image_loading = 'lazy'
  assign image_priority = 'auto'
  if section.index == nil or section.index <= 1
    assign image_loading = 'eager'
    assign image_priority = 'high'
  endif
-%}

<section class="bcssh{% if hero_image == blank %} bcssh--text-only{% endif %}" aria-labelledby="bcssh-title-{{ section.id }}">
  {%- if hero_image != blank -%}
    <picture class="bcssh-media{% if mobile_image != blank %} bcssh-media--art-directed{% endif %}">
      {%- if mobile_image != blank -%}
        <source
          media="(max-width: 749px)"
          srcset="{{ mobile_image | image_url: width: 390 }} 390w, {{ mobile_image | image_url: width: 600 }} 600w, {{ mobile_image | image_url: width: 900 }} 900w"
          sizes="100vw"
          width="{{ mobile_image.width }}"
          height="{{ mobile_image.height }}"
        >
      {%- endif -%}
      {{ hero_image | image_url: width: 2400 | image_tag: class: 'bcssh-image', widths: '600, 900, 1200, 1600, 2000, 2400', sizes: '100vw', width: hero_image.width, height: hero_image.height, loading: image_loading, fetchpriority: image_priority, alt: image_alt }}
    </picture>
  {%- endif -%}
  <div class="bcssh-container">
    <div class="bcssh-content">
      <p class="bcssh-eyebrow">{{ 'ss_home_v2.eyebrow' | t | escape }}</p>
      <h2 class="bcssh-heading" id="bcssh-title-{{ section.id }}">{{ 'ss_home_v2.heading' | t | escape }}</h2>
      <p class="bcssh-intro">{{ 'ss_home_v2.intro' | t | escape }}</p>
      <a class="bcssh-link" href="{{ sunshower_link | escape }}">
        <span>{{ 'ss_home_v2.cta' | t | escape }}</span>
        <svg class="bcssh-arrow" viewBox="0 0 20 20" width="18" height="18" fill="none" aria-hidden="true" focusable="false"><path d="M4 10h12m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.home_sunshower.name",
  "tag": "div",
  "class": "section-home-sunshower",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.home_sunshower.image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "t:sections.home_sunshower.mobile_image"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:sections.home_sunshower.link"
    }
  ],
  "presets": [
    {
      "name": "t:sections.home_sunshower.name"
    }
  ]
}
{% endschema %}
