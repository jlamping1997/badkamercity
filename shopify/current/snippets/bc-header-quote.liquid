{% doc %}
Renders the quote action in the desktop header utilities.
@param {string} url - Quote page or unpublished preview destination.
@param {string} variant - desktop.
{% enddoc %}
<a class="bc-header__utility-link bc-header__utility-link--quote bc-header-quote--{{ variant | escape }} link focus-inset" href="{{ url | escape }}" title="{{ 'bc_quote.eyebrow' | t | escape }}">
  <span class="bc-header__utility-icon" aria-hidden="true"><span class="svg-wrapper"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" focusable="false"><path d="M6 3h8l4 4v14H6zM14 3v5h4M12 18v-7m-3 3 3-3 3 3"/></svg></span></span>
  <span class="bc-header__utility-label">{{ 'bc_quote.header_button' | t }}</span>
</a>
