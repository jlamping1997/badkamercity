{% doc %}
  Renders up to two confirmed product attributes with an article fallback.
  @param {product} product - The card product.
  @param {string} [mode] - Use data for the same attributes as JSON.
{% enddoc %}
{%- liquid
  assign manifest = product.metafields.bc_data.filter_manifest.value
  assign sku = product.variants.first.sku | strip
  assign expected_sku = sku | upcase
  assign manifest_sku = manifest.sku | strip | upcase
  assign value_1 = ''
  assign value_2 = ''
  assign label_1 = 'products.product.card_type' | t
  assign label_2 = 'products.product.card_sku' | t
  assign tile = false
  assign type_key = product.type | handleize
  if product.metafields.tiles.size.value != blank or product.metafields.custom.bron_toelichtingen_json.value.tiles != blank or type_key contains 'vloertegel' or type_key contains 'wandtegel' or type_key contains 'mozaiektegel' or type_key == 'tegels'
    assign tile = true
  endif
  if manifest.format == 'verified-product-filters-v1' and manifest_sku == expected_sku and expected_sku != blank
    assign values = manifest.values
    if values.kraanmontage != blank
      assign value_1 = values.kraanmontage
      assign label_1 = 'products.product.card_mounting' | t
    elsif values.materiaal != blank
      assign value_1 = values.materiaal
      assign label_1 = 'products.product.card_material' | t
    endif
    if values.kleur != blank
      assign value_2 = values.kleur
      assign label_2 = 'products.product.card_colour' | t
    endif
  endif
  if value_1 == blank
    assign value_1 = product.type
  endif
  if product.vendor == 'JEE-O' and product.metafields.custom.color_variants.value != blank and product.metafields.custom.kleur.value != blank
    assign value_2 = product.metafields.custom.kleur.value
    assign label_2 = 'products.product.card_colour' | t
  endif
  if value_2 == blank
    assign value_2 = sku
  endif
  if tile
    assign label_1 = 'products.product.card_tile_size' | t
    assign value_1 = product.metafields.tiles.size.value | strip
    assign length = product.metafields.bc_filters.tegel_lengte_mm.value
    assign width = product.metafields.bc_filters.tegel_breedte_mm.value
    if length > 0 and width > 0
      assign length_cm = length | divided_by: 10.0
      assign width_cm = width | divided_by: 10.0
      assign whole_length = length_cm | floor
      assign whole_width = width_cm | floor
      if length_cm == whole_length
        assign length_cm = whole_length
      endif
      if width_cm == whole_width
        assign width_cm = whole_width
      endif
      if request.locale.iso_code == 'nl'
        assign length_cm = length_cm | replace: '.', ','
        assign width_cm = width_cm | replace: '.', ','
      endif
      assign value_1 = length_cm | append: ' × ' | append: width_cm | append: ' cm'
    endif
    assign finish = product.metafields.tiles.execution.value | default: product.metafields.bc_filters.afwerking.value | default: product.metafields.custom.afwerking.value | strip
    assign look = product.metafields.tiles.look.value | strip
    assign label_2 = 'products.product.card_tile_finish' | t
    assign value_2 = finish
    if look != blank
      if finish == blank
        assign value_2 = look
      elsif look != finish
        assign value_2 = look | append: ' · ' | append: finish
      endif
    endif
  endif
-%}
{%- if mode == 'data' -%}
  {%- capture json_less_than -%}\u003c{%- endcapture -%}
  [
    {%- if value_1 != blank -%}{"label":{{ label_1 | json | replace: '<', json_less_than }},"value":{{ value_1 | append: '' | json | replace: '<', json_less_than }}}{%- endif -%}
    {%- if value_1 != blank and value_2 != blank -%},{%- endif -%}
    {%- if value_2 != blank -%}{"label":{{ label_2 | json | replace: '<', json_less_than }},"value":{{ value_2 | append: '' | json | replace: '<', json_less_than }}}{%- endif -%}
  ]
{%- elsif value_1 != blank or value_2 != blank -%}
  <dl class="bc-card-specs{% if tile %} bc-card-specs--tile{% endif %}">
    {%- if value_1 != blank -%}<div><dt>{{ label_1 | escape }}:</dt><dd>{{ value_1 | escape }}</dd></div>{%- endif -%}
    {%- if value_2 != blank -%}<div><dt>{{ label_2 | escape }}:</dt><dd>{{ value_2 | escape }}</dd></div>{%- endif -%}
  </dl>
{%- endif -%}

