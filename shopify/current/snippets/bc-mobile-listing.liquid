{% doc %}
  Provides the mobile filter shortcut for a product listing.
{% enddoc %}
<button type="button" class="bc-floating-filter" data-bc-floating-filter hidden>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/><circle cx="8" cy="6" r="2" fill="currentColor"/><circle cx="16" cy="12" r="2" fill="currentColor"/><circle cx="9" cy="18" r="2" fill="currentColor"/></svg>
  {{ 'products.facets.filter_button' | t }}
</button>
<script src="{{ 'bc-mobile-listing.js' | asset_url }}" defer="defer"></script>
