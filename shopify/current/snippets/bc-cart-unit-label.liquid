{% doc %}
  Renders the sale unit for a cart price, using the existing tile box contract.
  @param {product} product - The cart product
  @param {string} [fallback_key] - Translation key for non-tile products
{% enddoc %}
{%- liquid
  assign box_m2 = product.metafields.custom.bron_toelichtingen_json.value.tiles.m2_per_box | default: 0
  assign unit_fallback = fallback_key | default: 'bc_cart_page.per_item'
  capture unit_mode
    render 'bc-cotto-unit-mode', product: product
  endcapture
  assign unit_mode = unit_mode | strip
-%}
{%- if unit_mode == 'unit' -%}
  {%- case product.metafields.custom.bron_toelichtingen_json.value.tiles.sale_unit -%}
    {%- when 'stuk' -%}{{- 'bc_units.per_piece' | t -}}
    {%- when 'pak' -%}{{- 'bc_units.per_pack' | t -}}
    {%- when 'set' -%}{{- 'bc_units.per_set' | t -}}
    {%- else -%}{{- 'bc_units.per_unit' | t -}}
  {%- endcase -%}
{%- elsif box_m2 > 0 -%}
  {{- 'bc_tiles.per_box' | t -}}
{%- else -%}
  {{- unit_fallback | t -}}
{%- endif -%}
