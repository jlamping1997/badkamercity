{% doc %}
  @param {object} config - Current Sunshower configuration
  @param {string} section_id - Unique section ID
{% enddoc %}
<section class="ss-highlights bc-product-pros-cons" id="ss-highlights-{{ section_id }}" aria-labelledby="ss-highlights-title-{{ section_id }}">
  <div class="bc-product-pros-cons__inner">
  <h2 class="bc-product-pros-cons__title" id="ss-highlights-title-{{ section_id }}">{{ 'ss.redesign.highlights' | t }}</h2>
  <ul class="bc-product-pros-cons__list list-unstyled" role="list">
    <li class="bc-product-pros-cons__item bc-product-pros-cons__item--plus"><span class="bc-product-pros-cons__icon" aria-hidden="true"><svg class="bc-product-pros-cons__icon-mark" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m4 8 3 3 5-6"/></svg></span><span class="bc-product-pros-cons__text">{{ 'ss.redesign.pro_ir' | t }}</span></li>
    {% if config.selected.met_uv == 'true' %}<li class="bc-product-pros-cons__item bc-product-pros-cons__item--plus"><span class="bc-product-pros-cons__icon" aria-hidden="true"><svg class="bc-product-pros-cons__icon-mark" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m4 8 3 3 5-6"/></svg></span><span class="bc-product-pros-cons__text">{{ 'ss.redesign.pro_plus' | t }}</span></li>{% else %}<li class="bc-product-pros-cons__item bc-product-pros-cons__item--plus"><span class="bc-product-pros-cons__icon" aria-hidden="true"><svg class="bc-product-pros-cons__icon-mark" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m4 8 3 3 5-6"/></svg></span><span class="bc-product-pros-cons__text">{{ 'ss.redesign.pro_one' | t }}</span></li>{% endif %}
    <li class="bc-product-pros-cons__item bc-product-pros-cons__item--plus"><span class="bc-product-pros-cons__icon" aria-hidden="true"><svg class="bc-product-pros-cons__icon-mark" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m4 8 3 3 5-6"/></svg></span><span class="bc-product-pros-cons__text">{% if config.selected.plaatsing == 'Inbouw' %}{{ 'ss.redesign.pro_inbouw' | t }}{% else %}{{ 'ss.redesign.pro_mount' | t }}{% endif %}</span></li>
    <li class="bc-product-pros-cons__item bc-product-pros-cons__item--attention"><span class="bc-product-pros-cons__icon" aria-hidden="true"><svg class="bc-product-pros-cons__icon-mark" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 5 6 6m0-6-6 6"/></svg></span><span class="bc-product-pros-cons__text">{{ 'ss.redesign.con_steam' | t }}</span></li>
    <li class="bc-product-pros-cons__item bc-product-pros-cons__item--attention"><span class="bc-product-pros-cons__icon" aria-hidden="true"><svg class="bc-product-pros-cons__icon-mark" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 5 6 6m0-6-6 6"/></svg></span><span class="bc-product-pros-cons__text">{% if config.selected.plaatsing == 'Inbouw' %}{{ 'ss.redesign.con_inbouw' | t }}{% else %}{{ 'ss.redesign.con_space' | t }}{% endif %}</span></li>
    {% if config.selected.met_uv == 'true' %}<li class="bc-product-pros-cons__item bc-product-pros-cons__item--attention"><span class="bc-product-pros-cons__icon" aria-hidden="true"><svg class="bc-product-pros-cons__icon-mark" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 5 6 6m0-6-6 6"/></svg></span><span class="bc-product-pros-cons__text">{{ 'ss.redesign.con_uv' | t }}</span></li>{% endif %}
  </ul>
</div>
</section>

