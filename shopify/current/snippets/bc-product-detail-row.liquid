{%- comment -%}
Bestaande specificatie of expliciete productwaarde. False en 0 zijn geldig.
Complexe referenties/JSON niet stil als tekst tonen.
{%- endcomment -%}
{%- liquid
  assign spec_type = metafield.type | default: ''
  assign formatted_value = ''
  case spec_type
    when 'boolean'
      if metafield.value == true
        assign formatted_value = 'Ja'
      elsif metafield.value == false
        assign formatted_value = 'Nee'
      endif
    when 'dimension', 'volume', 'weight'
      assign formatted_value = metafield | metafield_text
    when 'list.single_line_text_field'
      assign formatted_value = metafield.value | join: ', '
    when 'single_line_text_field', 'multi_line_text_field', 'number_integer', 'number_decimal'
      assign formatted_value = metafield.value | append: '' | strip
    when 'rich_text_field'
      assign formatted_value = metafield | metafield_text
  endcase
  assign formatted_value = formatted_value | strip
  if formatted_value == blank
    assign formatted_value = value | append: '' | strip
  endif
-%}
{%- if formatted_value != blank -%}
  <tr class="bc-product-specs__row">
    <th class="bc-product-specs__label" scope="row">{{ label | escape }}</th>
    <td class="bc-product-specs__value">{{ formatted_value | escape }}</td>
  </tr>
{%- endif -%}
