{% doc %}
Renders one category-directory link.
@param {link} category_link - The navigation link
@param {boolean} [use_collection_title] - Use the full collection title
{% enddoc %}
{%- liquid
  assign label = category_link.title
  if use_collection_title and category_link.type == 'collection_link'
    assign label = category_link.object.title | default: label
  endif
-%}
{%- capture destination -%}{% render 'bc-category-destination', category_link: category_link %}{%- endcapture -%}
<li><a href="{{ destination | strip | escape }}">{{ label | escape }}</a></li>
