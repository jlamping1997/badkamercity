{% doc %}
  Renders reviewed Wiesbaden specifications; preserves the approved 24.3710 pilot.
  @param {product} product - Current product.
  @param {string} section_id - Main product section identifier.
{% enddoc %}
{%- liquid
  assign spec = product.metafields.custom.complete_specificaties
  assign matched_article = false
  assign allowed_keys = 'fabrikantnummer,merk,serie,productsoort,zelfsluitend,type_temperatuurregeling,aantal_kraangaten,uitvoering_uitloop,type_uitloop,kraanmondstuk,uittrekbare_uitloop_met_kraanbeluchter_mousseur,uittrekbare_uitloop_met_handdouche,met_zijwaartse_douche,met_koppelingen,met_afvoerplug,temperatuurbegrenzing,coldstart,volumestroomklasse,programmering,materiaal_kraan,oppervlaktebescherming,oppervlaktebehandeling,materiaal_greep,basiskleur,montage,aansluiting_aanvoer,maat_aansluiting_aanvoer,met_rozetten_afdekplaat,hoogte_mm,hoogte_uitloop_mm,voorsprong_uitloop_mm,kraanhuisdiameter_mm,aantal_grepen' | split: ','
-%}
{%- capture reviewed_scope -%}{%- render 'bc-wiesbaden-reviewed-scope', product: product -%}{%- endcapture -%}
{%- assign reviewed_scope = reviewed_scope | strip -%}
{%- if reviewed_scope != blank -%}
  {%- if reviewed_scope == 'reviewed' -%}
    {%- assign allowed_keys = product.metafields.bc_data.content_review.value.spec_keys -%}
  {%- endif -%}
  {%- for group in spec.value -%}
    {%- for item in group.items -%}
      {%- if item.key == 'fabrikantnummer' and item.value == product.selected_or_first_available_variant.sku -%}
        {%- assign matched_article = true -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endfor -%}
  {%- if matched_article -%}
    {%- capture spec_groups -%}
      {%- for group in spec.value -%}
        {%- capture rows -%}
          {%- for item in group.items -%}
            {%- if allowed_keys contains item.key and item.label != blank -%}
              {%- assign display_value = item.value | append: '' -%}
              {%- if item.value == true -%}
                {%- assign display_value = 'bc_specs.yes' | t -%}
              {%- elsif item.value == false -%}
                {%- assign display_value = 'bc_specs.no' | t -%}
              {%- endif -%}
              {%- if display_value != blank -%}
                {%- render 'bc-product-detail-row', value: display_value, label: item.label -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- assign rows = rows | strip -%}
        {%- if rows != blank -%}
          <tbody>
            <tr class="bc-product-specs__header-row"><th class="bc-product-specs__header" colspan="2" scope="rowgroup">{{ group.group | escape }}</th></tr>
            {{ rows }}
          </tbody>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    <section class="bc-product-specs" id="ProductSpecs-{{ section_id | escape }}" aria-labelledby="ProductSpecsTitle-{{ section_id | escape }}">
      <div class="bc-product-specs__inner">
        <h2 class="bc-product-specs__title" id="ProductSpecsTitle-{{ section_id | escape }}">{{ 'bc_specs.title' | t }}</h2>
        <table class="bc-product-specs__table" aria-labelledby="ProductSpecsTitle-{{ section_id | escape }}">{{ spec_groups }}</table>
      </div>
    </section>
  {%- endif -%}
{%- endif -%}
