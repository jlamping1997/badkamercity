{% doc %}
Renders a Sunshower accessory with inline colour choices and a product form.
@param {object} block - The accessory section block.
@param {string} section_id - The containing section ID.
@example
{% render 'bc-sunshower-shop-card', block: block, section_id: section.id %}
{% enddoc %}
{%- liquid
  assign accessory_product = block.settings.product
  assign accessory_kind = block.settings.kind | default: 'cleaning'
  assign accessory_heading_key = 'ss_experience.accessories.' | append: accessory_kind | append: '_heading'
  assign accessory_heading = accessory_heading_key | t
  assign accessory_description_key = 'ss_experience.accessories.' | append: accessory_kind | append: '_description'
  assign colors = 'white,black,grey,sand' | split: ','
  assign selected_key = 'default'
  assign selected_label = ''
  for color in colors
    assign color_setting = 'product_' | append: color
    assign color_product = block.settings[color_setting]
    if color_product != blank and color_product.id == accessory_product.id
      assign selected_key = color
      assign color_label_key = 'ss_experience.colors.' | append: color
      assign selected_label = color_label_key | t
    endif
  endfor
  assign accessory_variant = accessory_product.selected_or_first_available_variant
  assign accessory_image = block.settings.image_override | default: accessory_product.featured_image
  assign accessory_image_width = 1080
  assign accessory_image_widths = '360, 540, 720, 1080'
  assign accessory_image_sizes = '(min-width: 990px) 25vw, 80vw'
  assign image_mode = 'product'
  if accessory_kind == 'seat'
    assign image_mode = 'lifestyle'
    assign accessory_image_width = 2000
    assign accessory_image_widths = '720, 1080, 1500, 2000'
    assign accessory_image_sizes = '(min-width: 1440px) 630px, (min-width: 990px) 75vw, 240vw'
  endif
  assign shop_form_id = 'bcsse-shop-' | append: section_id | append: '-' | append: block.id
  assign shop_status_id = shop_form_id | append: '-status'
  assign choice_keys = 'default,white,black,grey,sand' | split: ','
-%}
<article class="bcsse-accessory bcsse-accessory--{{ accessory_kind }}" data-bcsse-shop-card data-bcsse-image-mode="{{ image_mode }}" data-bcsse-add-label="{{ 'ss_quick_shop.add' | t | escape }}" data-bcsse-loading-label="{{ 'ss_quick_shop.adding' | t | escape }}" data-bcsse-loading-image-label="{{ 'ss_quick_shop.loading_image' | t | escape }}" data-bcsse-added-label="{{ 'ss_quick_shop.added' | t: product: '__product__' | escape }}" data-bcsse-error-label="{{ 'ss_quick_shop.error' | t | escape }}" data-bcsse-image-error-label="{{ 'ss_quick_shop.image_error' | t | escape }}" data-bcsse-sold-out-label="{{ 'ss_quick_shop.unavailable' | t | escape }}" {{ block.shopify_attributes }}>
  {% render 'bc-wishlist-button', product: accessory_product, class_name: 'bc-wishlist-button--card', source: 'card' %}
  {%- if accessory_image != blank -%}
    <div class="bcsse-accessory__media">
      {{- accessory_image | image_url: width: accessory_image_width | image_tag: class: 'bcsse-accessory__image', widths: accessory_image_widths, sizes: accessory_image_sizes, width: accessory_image.width, height: accessory_image.height, loading: 'lazy', alt: accessory_product.title, data-bcsse-shop-image: '' -}}
    </div>
  {%- endif -%}
  <div class="bcsse-accessory__body">
    <h3 class="bcsse-accessory__title">{{ accessory_heading }}</h3>
    {%- if accessory_kind == 'cleaning' -%}
      <p class="bcsse-accessory__description">{{ accessory_description_key | t }}</p>
    {%- else -%}
      <ul class="bcsse-swatches" aria-label="{{ 'ss_experience.accessories.colors_label' | t: product: accessory_heading | escape }}">
        {%- for color in colors -%}
          {%- liquid
            assign color_setting = 'product_' | append: color
            assign color_product = block.settings[color_setting]
            assign color_label_key = 'ss_experience.colors.' | append: color
            assign color_label = color_label_key | t
          -%}
          {%- if color_product != blank -%}
            <li><a class="bcsse-swatch{% if color == selected_key %} bcsse-swatch--selected{% endif %}" href="{{ color_product.url }}" data-bcsse-shop-choice="{{ color }}" aria-label="{{ 'ss_experience.accessories.color_link' | t: product: accessory_heading, color: color_label | escape }}" title="{{ color_label | escape }}"{% if color == selected_key %} aria-current="true"{% endif %}><span class="bcsse-swatch__color bcsse-swatch__color--{{ color }}" aria-hidden="true"></span></a></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
      <p class="bcsse-shop-color"><span class="visually-hidden">{{ 'ss_quick_shop.color' | t }}: </span><span data-bcsse-shop-color>{{ selected_label }}</span></p>
      {%- if accessory_kind == 'wiper' -%}<p class="bcsse-shop-image-note">{{ 'ss_quick_shop.color_overview' | t }}</p>{%- endif -%}
    {%- endif -%}
    <p class="bcsse-accessory__price" data-bcsse-shop-price>{% render 'bc-money', amount: accessory_variant.price %}</p>
    {%- form 'product', accessory_product, id: shop_form_id, class: 'bcsse-shop-form', data-bcsse-shop-form: '' -%}
      <input type="hidden" name="id" value="{{ accessory_variant.id }}">
      <input type="hidden" name="quantity" value="1">
      <button type="submit" name="add" class="bcsse-button bcsse-button--outline" data-bcsse-shop-submit aria-describedby="{{ shop_status_id }}"{% unless accessory_variant.available %} disabled{% endunless %}><span data-bcsse-shop-button-label>{% if accessory_variant.available %}{{ 'ss_quick_shop.add' | t }}{% else %}{{ 'ss_quick_shop.unavailable' | t }}{% endif %}</span></button>
    {%- endform -%}
    <p class="bcsse-shop-status" id="{{ shop_status_id }}" role="status" aria-live="polite" data-bcsse-shop-status></p>
    <a class="bcsse-shop-cart-link" href="{{ routes.cart_url }}" data-bcsse-shop-cart-link hidden>{{ 'ss_quick_shop.view_cart' | t }}</a>
    <a class="bcsse-shop-details" href="{{ accessory_product.url }}" data-bcsse-shop-link>{{ 'ss_quick_shop.details' | t }}</a>
  </div>
  {%- capture shop_data -%}
    {"initial":{{ selected_key | json }},"choices":[
    {%- assign choice_separator = '' -%}
    {%- for choice_key in choice_keys -%}
      {%- liquid
        assign choice_product = nil
        assign choice_label = ''
        if choice_key == 'default'
          if selected_key == 'default'
            assign choice_product = accessory_product
          endif
        else
          assign choice_setting = 'product_' | append: choice_key
          assign choice_product = block.settings[choice_setting]
          assign choice_label_key = 'ss_experience.colors.' | append: choice_key
          assign choice_label = choice_label_key | t
        endif
      -%}
      {%- if choice_product != blank and choice_product.id -%}
        {%- liquid
          assign choice_variant = choice_product.selected_or_first_available_variant
          assign choice_image = choice_product.featured_image
          if choice_product.id == accessory_product.id
            assign choice_image = accessory_image
          endif
          assign choice_image_url = ''
          assign choice_srcset = ''
          if choice_image != blank
            assign choice_image_url = choice_image | image_url: width: accessory_image_width
            assign src_widths = accessory_image_widths | split: ', '
            for src_width in src_widths
              assign src_number = src_width | plus: 0
              assign src_url = choice_image | image_url: width: src_number
              assign choice_srcset = choice_srcset | append: src_url | append: ' ' | append: src_width | append: 'w'
              unless forloop.last
                assign choice_srcset = choice_srcset | append: ', '
              endunless
            endfor
          endif
        -%}
        {%- capture choice_money_price -%}{%- render 'bc-money', amount: choice_variant.price -%}{%- endcapture -%}{{- choice_separator -}}{"key":{{ choice_key | json }},"id":{{ choice_variant.id | append: '' | json }},"available":{{ choice_variant.available | json }},"url":{{ choice_product.url | json }},"title":{{ choice_product.title | json }},"label":{{ choice_label | json }},"price":{{ choice_money_price | json }},"image":{"src":{{ choice_image_url | json }},"srcset":{{ choice_srcset | json }},"sizes":{{ accessory_image_sizes | json }},"width":{{ choice_image.width | default: 1 | json }},"height":{{ choice_image.height | default: 1 | json }},"alt":{{ choice_product.title | json }},"mode":{{ image_mode | json }}}}
        {%- assign choice_separator = ',' -%}
      {%- endif -%}
    {%- endfor -%}
    ]}
  {%- endcapture -%}
  <script type="application/json" data-bcsse-shop-data>{{ shop_data | replace: '<', '\u003c' }}</script>
</article>
