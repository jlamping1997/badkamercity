{% layout none %}<!doctype html><html lang="nl"><head><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Mobiele tegelcontrole</title>{{ 'base.css' | asset_url | stylesheet_tag }}{{ 'bc-product-page.css' | asset_url | stylesheet_tag }}<style>html{font-size:62.5%}body{margin:0;background:white;font-family:Arial,sans-serif}product-info{display:block;max-width:390px;margin:12px auto;padding:16px;box-sizing:border-box}h1{font-size:20px;margin:0 0 16px}bc-porcelanosa-buybox{display:block}form{margin:0}.product__info-container{width:100%;max-width:100%;padding:0!important}</style></head><body><product-info data-bc-product-page data-bc-tile-product><div class="product__info-container"><h1>{{ product.title | escape }}</h1>{% capture actions %}<div class="bc-buybox__section--actions">{% form 'product', product, id: 'tile-preview-form' %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><div class="bc-product-form__buttons"><button type="button" class="product-form__submit button">In winkelwagen</button></div>{% endform %}</div>{% endcapture %}{% render 'bc-porcelanosa-buybox', product: product, section: section, product_form_id: 'tile-preview-form', actions_markup: actions %}</div></product-info></body></html>