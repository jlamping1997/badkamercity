{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="robots" content="noindex,nofollow">
    <meta http-equiv="refresh" content="0;url={{ page.url | escape }}">
    <title>{{ page.title | escape }}</title>
  </head>
  <body><a href="{{ page.url }}">{{ page.title | escape }}</a></body>
</html>
