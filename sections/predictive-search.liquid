{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{%- if predictive_search.performed -%}
  <div id="predictive-search-results" role="listbox">
    {%- if predictive_search.resources.products.size > 0 -%}
      <div
        id="predictive-search-results-groups-wrapper"
        class="predictive-search__results-groups-wrapper predictive-search__results-groups-wrapper--products-only"
      >
      <div class="predictive-search__result-group">
        <div class="predictive-search__products">
          <ul
            id="predictive-search-results-products-list"
            class="predictive-search__results-list list-unstyled"
            role="group"
            aria-label="{{ 'templates.search.products' | t }}"
          >
            {%- for product in predictive_search.resources.products -%}
              {%- liquid
                assign predictive_search_target = product.selected_or_first_available_variant
                assign predictive_search_money_price = predictive_search_target.price | money
                if settings.currency_code_enabled
                  assign predictive_search_money_price = predictive_search_target.price | money_with_currency
                endif
              -%}
              <li
                id="predictive-search-option-product-{{ forloop.index }}"
                class="predictive-search__list-item"
                role="option"
                aria-selected="false"
              >
                <a
                  href="{{ product.url }}"
                  class="predictive-search__item predictive-search__product-row link link--text"
                  tabindex="-1"
                >
                  <div class="predictive-search__product-media">
                    {%- if product.featured_media != blank -%}
                      <img
                        class="predictive-search__product-image predictive-search__image"
                        src="{{ product.featured_media | image_url: width: 180 }}"
                        alt="{{ product.featured_media.alt | escape }}"
                        width="72"
                        height="72"
                      >
                    {%- endif -%}
                  </div>
                  <div class="predictive-search__product-content">
                    {%- if settings.predictive_search_show_vendor -%}
                      <span class="visually-hidden">{{ 'accessibility.vendor' | t }}</span>
                      <div class="predictive-search__product-vendor predictive-search__item-vendor caption-with-letter-spacing">
                        {{ product.vendor }}
                      </div>
                    {%- endif -%}
                    <p class="predictive-search__product-title predictive-search__item-heading h5">
                      {{ product.title | escape }}
                    </p>
                  </div>
                  <div class="predictive-search__product-price" aria-label="{{ 'products.product.price.regular_price' | t }}">
                    {{ predictive_search_money_price }}
                  </div>
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      </div>
    {%- endif -%}
    {%- if predictive_search.resources.products.size > 0 -%}
      </div>
    {%- endif -%}

    {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}
  </div>

  <span class="hidden" data-predictive-search-live-region-count-value>
    {% liquid
      assign total_results = predictive_search.resources.products.size
      if total_results == 0
        echo 'templates.search.no_results' | t: terms: predictive_search.terms
      else
        echo 'templates.search.results_products_with_count' | t: count: predictive_search.resources.products.size
      endif
    %}
  </span>
{%- endif -%}
