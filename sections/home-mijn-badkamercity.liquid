{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .home-mbc-{{ section.id }} {
    --mbc-bg: #ffffff;
    --mbc-text: #132238;
    --mbc-muted: #58697b;
    --mbc-accent: #8fd4ef;
    --mbc-accent-deep: #3e5f95;
    --mbc-border: rgba(19, 34, 56, 0.08);
    --mbc-shadow: 0 1.8rem 4rem rgba(15, 31, 68, 0.08);
    background:
      radial-gradient(circle at top center, rgba(143, 212, 239, 0.14), rgba(143, 212, 239, 0) 30%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(246, 250, 252, 0.96));
  }

  .home-mbc-{{ section.id }} .page-width {
    max-width: min(100%, 144rem);
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  .home-mbc-{{ section.id }} .home-mbc__shell {
    display: grid;
    gap: 2.2rem;
  }

  .home-mbc-{{ section.id }} .home-mbc__header {
    display: grid;
    gap: 1rem;
    justify-items: center;
    text-align: center;
  }

  .home-mbc-{{ section.id }} .home-mbc__title {
    margin: 0;
    color: var(--mbc-accent-deep);
    font-size: clamp(3rem, 4vw, 4.8rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .home-mbc-{{ section.id }} .home-mbc__intro {
    margin: 0;
    max-width: 84rem;
    color: var(--mbc-muted);
    font-size: 1.6rem;
    line-height: 1.65;
  }

  .home-mbc-{{ section.id }} .home-mbc__intro strong,
  .home-mbc-{{ section.id }} .home-mbc__intro a {
    color: var(--mbc-accent-deep);
    font-weight: 700;
    text-decoration: none;
  }

  .home-mbc-{{ section.id }} .home-mbc__slider-wrap {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 1.2rem;
    align-items: center;
  }

  .home-mbc-{{ section.id }} .home-mbc__nav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 5.2rem;
    height: 5.2rem;
    border: 0;
    border-radius: 999px;
    background: #2c3138;
    color: #ffffff;
    cursor: pointer;
    transition: transform 0.18s ease, background-color 0.18s ease, opacity 0.18s ease;
  }

  .home-mbc-{{ section.id }} .home-mbc__nav:hover,
  .home-mbc-{{ section.id }} .home-mbc__nav:focus-visible {
    transform: translateY(-0.1rem);
    background: #1f242b;
  }

  .home-mbc-{{ section.id }} .home-mbc__nav[disabled] {
    opacity: 0.45;
    cursor: default;
    transform: none;
  }

  .home-mbc-{{ section.id }} .home-mbc__nav::before {
    content: '';
    width: 1.2rem;
    height: 1.2rem;
    border-top: 0.2rem solid currentColor;
    border-right: 0.2rem solid currentColor;
    transform: rotate(45deg);
  }

  .home-mbc-{{ section.id }} .home-mbc__nav--prev::before {
    transform: rotate(-135deg);
    margin-left: 0.35rem;
  }

  .home-mbc-{{ section.id }} .home-mbc__nav--next::before {
    margin-right: 0.35rem;
  }

  .home-mbc-{{ section.id }} .home-mbc__viewport {
    overflow: hidden;
  }

  .home-mbc-{{ section.id }} .home-mbc__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(21rem, 1fr);
    gap: 0.8rem;
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x proximity;
    padding: 0.2rem 0;
    scrollbar-width: none;
  }

  .home-mbc-{{ section.id }} .home-mbc__track::-webkit-scrollbar {
    display: none;
  }

  .home-mbc-{{ section.id }} .home-mbc__item {
    min-width: 0;
    scroll-snap-align: start;
  }

  .home-mbc-{{ section.id }} .home-mbc__card {
    position: relative;
    overflow: hidden;
    display: block;
    aspect-ratio: 1 / 1;
    background: #e7edf2;
    border: 1px solid var(--mbc-border);
    box-shadow: var(--mbc-shadow);
    text-decoration: none;
    color: inherit;
  }

  .home-mbc-{{ section.id }} .home-mbc__card:hover .home-mbc__image,
  .home-mbc-{{ section.id }} .home-mbc__card:focus-visible .home-mbc__image {
    transform: scale(1.03);
  }

  .home-mbc-{{ section.id }} .home-mbc__card:hover .home-mbc__overlay,
  .home-mbc-{{ section.id }} .home-mbc__card:focus-visible .home-mbc__overlay {
    opacity: 1;
  }

  .home-mbc-{{ section.id }} .home-mbc__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.28s ease;
  }

  .home-mbc-{{ section.id }} .home-mbc__placeholder {
    width: 100%;
    height: 100%;
    background:
      radial-gradient(circle at top left, rgba(143, 212, 239, 0.55), rgba(143, 212, 239, 0) 32%),
      linear-gradient(135deg, #dbe6ef, #eef4f8 42%, #cedae3);
  }

  .home-mbc-{{ section.id }} .home-mbc__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: 1.3rem;
    background: linear-gradient(180deg, rgba(19, 34, 56, 0.02), rgba(19, 34, 56, 0.56));
    opacity: 0.9;
    transition: opacity 0.22s ease;
  }

  .home-mbc-{{ section.id }} .home-mbc__meta {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.75rem 1rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(0.8rem);
    color: #ffffff;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1;
  }

  .home-mbc-{{ section.id }} .home-mbc__meta::before {
    content: '#';
    color: rgba(255, 255, 255, 0.82);
  }

  .home-mbc-{{ section.id }} .home-mbc__footer {
    display: flex;
    justify-content: center;
  }

  .home-mbc-{{ section.id }} .home-mbc__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 4.8rem;
    padding: 1.2rem 2.2rem;
    border: 1px solid transparent;
    background: var(--mbc-accent-deep);
    color: #ffffff;
    font-size: 1.45rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transition: transform 0.18s ease, filter 0.18s ease;
  }

  .home-mbc-{{ section.id }} .home-mbc__button:hover,
  .home-mbc-{{ section.id }} .home-mbc__button:focus-visible {
    transform: translateY(-0.1rem);
    filter: brightness(0.95);
  }

  @media screen and (max-width: 749px) {
    .home-mbc-{{ section.id }} .home-mbc__slider-wrap {
      grid-template-columns: 1fr;
    }

    .home-mbc-{{ section.id }} .home-mbc__nav {
      display: none;
    }

    .home-mbc-{{ section.id }} .home-mbc__track {
      grid-auto-columns: minmax(18rem, 72vw);
    }
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .home-mbc-{{ section.id }} .page-width {
      padding-left: 3.2rem;
      padding-right: 3.2rem;
    }

    .home-mbc-{{ section.id }} .home-mbc__shell {
      gap: 2.8rem;
    }

    .home-mbc-{{ section.id }} .home-mbc__track {
      grid-auto-columns: calc((100% - 2.4rem) / 4);
    }
  }

  @media screen and (min-width: 990px) {
    .home-mbc-{{ section.id }} .page-width {
      padding-left: 0;
      padding-right: 0;
    }

    .home-mbc-{{ section.id }} .home-mbc__track {
      grid-auto-columns: calc((100% - 4rem) / 6);
    }
  }
{%- endstyle -%}

<section class="home-mbc home-mbc-{{ section.id }} section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="home-mbc__shell" data-home-mbc>
      <div class="home-mbc__header">
        {%- if section.settings.title != blank -%}
          <h2 class="home-mbc__title">{{ section.settings.title | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.intro != blank -%}
          <div class="home-mbc__intro">{{ section.settings.intro }}</div>
        {%- endif -%}
      </div>

      <div class="home-mbc__slider-wrap">
        <button type="button" class="home-mbc__nav home-mbc__nav--prev" aria-label="Vorige afbeeldingen" data-home-mbc-prev></button>

        <div class="home-mbc__viewport">
          <div class="home-mbc__track" data-home-mbc-track>
            {%- for block in section.blocks -%}
              <div class="home-mbc__item" {{ block.shopify_attributes }}>
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" class="home-mbc__card">
                {%- else -%}
                  <div class="home-mbc__card">
                {%- endif -%}
                    {%- if block.settings.image != blank -%}
                      {{ block.settings.image | image_url: width: 900 | image_tag:
                        widths: '320, 480, 640, 900',
                        sizes: '(min-width: 990px) 16vw, (min-width: 750px) 22vw, 72vw',
                        loading: 'lazy',
                        class: 'home-mbc__image',
                        alt: block.settings.image.alt | default: block.settings.caption | default: section.settings.title | escape
                      }}
                    {%- else -%}
                      <div class="home-mbc__placeholder"></div>
                    {%- endif -%}

                    <div class="home-mbc__overlay">
                      <span class="home-mbc__meta">{{ block.settings.caption | default: section.settings.hashtag_label | escape }}</span>
                    </div>
                {%- if block.settings.link != blank -%}
                  </a>
                {%- else -%}
                  </div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        </div>

        <button type="button" class="home-mbc__nav home-mbc__nav--next" aria-label="Volgende afbeeldingen" data-home-mbc-next></button>
      </div>

      {%- if section.settings.button_label != blank -%}
        <div class="home-mbc__footer">
          <a
            {% if section.settings.button_link != blank %}
              href="{{ section.settings.button_link }}"
            {% else %}
              role="link" aria-disabled="true"
            {% endif %}
            class="home-mbc__button"
          >
            {{ section.settings.button_label | escape }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (() => {
    const root = document.currentScript.previousElementSibling;
    if (!root) return;

    const slider = root.querySelector('[data-home-mbc]');
    if (!slider) return;

    const track = slider.querySelector('[data-home-mbc-track]');
    const prevButton = slider.querySelector('[data-home-mbc-prev]');
    const nextButton = slider.querySelector('[data-home-mbc-next]');
    if (!track || !prevButton || !nextButton) return;

    const getStep = () => {
      const firstItem = track.querySelector('.home-mbc__item');
      if (!firstItem) return track.clientWidth * 0.8;
      const styles = window.getComputedStyle(track);
      const gap = parseFloat(styles.columnGap || styles.gap || 0);
      return firstItem.getBoundingClientRect().width + gap;
    };

    const updateButtons = () => {
      const maxScroll = Math.max(track.scrollWidth - track.clientWidth, 0);
      prevButton.disabled = track.scrollLeft <= 4;
      nextButton.disabled = track.scrollLeft >= maxScroll - 4;
    };

    const scrollByStep = (direction) => {
      track.scrollBy({ left: getStep() * direction, behavior: 'smooth' });
    };

    prevButton.addEventListener('click', () => scrollByStep(-1));
    nextButton.addEventListener('click', () => scrollByStep(1));
    track.addEventListener('scroll', updateButtons, { passive: true });
    window.addEventListener('resize', updateButtons);
    updateButtons();
  })();
</script>

{% schema %}
{
  "name": "Home MijnBadkamercity",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titel",
      "default": "#MijnBadkamercity"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>Deel jouw badkamer op Instagram met <strong>#MijnBadkamercity</strong> en tag <strong>@badkamercity</strong>. Zo bouwen we samen aan een inspirerende omgeving vol echte badkamers, slimme oplossingen en mooie stijlen.</p>"
    },
    {
      "type": "text",
      "id": "hashtag_label",
      "label": "Fallback hashtag label",
      "default": "MijnBadkamercity"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Knop label",
      "default": "Meer inspiratie op #MijnBadkamercity"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Knop link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Afbeelding",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Afbeelding"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption / tag",
          "default": "MijnBadkamercity"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home MijnBadkamercity",
      "blocks": [
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" }
      ]
    }
  ]
}
{% endschema %}
