<script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>

{%- liquid
  for block in section.blocks
    if block.type == '@app'
      assign has_app_block = true
    endif
  endfor
-%}

{% liquid
  assign header_tag = 'div'
%}

<{{ header_tag }} {% if header_tag == 'sticky-header' %}data-sticky-type="{{ section.settings.sticky_header_type }}"{% endif %} class="header-wrapper color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator %} header-wrapper--border-bottom{% endif %}">
  {%- liquid
    assign social_links = false
    assign localization_forms = false

    if settings.social_twitter_link != blank or settings.social_facebook_link != blank or settings.social_pinterest_link != blank or settings.social_instagram_link != blank or settings.social_youtube_link != blank or settings.social_vimeo_link != blank or settings.social_tiktok_link != blank or settings.social_tumblr_link != blank or settings.social_snapchat_link != blank
      assign social_links = true
    endif

    if localization.available_countries.size > 1 and section.settings.enable_country_selector or section.settings.enable_language_selector and localization.available_languages.size > 1
      assign localization_forms = true
    endif
  -%}
  <header class="header header--{{ section.settings.logo_position }} header--mobile-{{ section.settings.mobile_logo_position }}{% if section.settings.menu != blank %} header--has-menu{% endif %}{% if has_app_block %} header--has-app{% endif %}{% if social_links %} header--has-social{% endif %}{% if shop.customer_accounts_enabled %} header--has-account{% endif %}{% if localization_forms %} header--has-localizations{% endif %}{% if section.settings.menu_type_desktop == 'drawer' %} drawer-menu{% endif %} bc-header">
    <div class="bc-header__inner page-width">
      {%- if section.settings.menu != blank -%}
        <div class="bc-header__mobile-menu large-up-hide">
          {% render 'header-drawer' %}
        </div>
      {%- endif -%}

      {%- if request.page_type == 'index' -%}
        <h1 class="header__heading">
      {%- endif -%}
      <a href="{{ routes.root_url }}" class="header__heading-link link link--text focus-inset">
        {%- if settings.logo != blank -%}
          <div class="header__heading-logo-wrapper">
            {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
            {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
            {% capture sizes %}(max-width: 989px) 50vw, {{ settings.logo_width }}px{% endcapture %}
            {% capture widths %}{{ settings.logo_width }}, {{ settings.logo_width | times: 1.5 | round }}, {{ settings.logo_width | times: 2 }}{% endcapture %}
            {{ settings.logo | image_url: width: 600 | image_tag:
              class: 'header__heading-logo motion-reduce',
              widths: widths,
              height: logo_height,
              width: settings.logo_width,
              alt: logo_alt,
              sizes: sizes,
              preload: true
            }}
          </div>
        {%- else -%}
          <span class="h2">{{ shop.name }}</span>
        {%- endif -%}
      </a>
      {%- if request.page_type == 'index' -%}
        </h1>
      {%- endif -%}

      <div class="bc-header__search">
        {% render 'header-search', input_id: 'Search-In-Header', mode: 'inline', placeholder: 'Waar ben je naar op zoek?' %}
      </div>

      <div class="header__icons{% if section.settings.enable_country_selector or section.settings.enable_language_selector %} header__icons--localization header-localization{% endif %}">
        <div class="desktop-localization-wrapper">
          {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
            <localization-form class="small-hide medium-hide" data-prevent-hide>
              {%- form 'localization', id: 'HeaderCountryForm', class: 'localization-form' -%}
                <div>
                  <h2 class="visually-hidden" id="HeaderCountryLabel">{{ 'localization.country_label' | t }}</h2>
                  {%- render 'country-localization', localPosition: 'HeaderCountry' -%}
                </div>
              {%- endform -%}
            </localization-form>
          {% endif %}

          {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
            <localization-form class="small-hide medium-hide" data-prevent-hide>
              {%- form 'localization', id: 'HeaderLanguageForm', class: 'localization-form' -%}
                <div>
                  <h2 class="visually-hidden" id="HeaderLanguageLabel">{{ 'localization.language_label' | t }}</h2>
                  {%- render 'language-localization', localPosition: 'HeaderLanguage' -%}
                </div>
              {%- endform -%}
            </localization-form>
          {%- endif -%}
        </div>

        {%- if shop.customer_accounts_enabled -%}
          <a
            href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
            class="bc-header__utility-link bc-header__utility-link--account link focus-inset"
            rel="nofollow"
          >
            <span class="bc-header__utility-icon" aria-hidden="true">
              <span class="svg-wrapper">{{ 'icon-account-bc.svg' | inline_asset_content }}</span>
            </span>
            <span class="bc-header__utility-label">Mijn account</span>
            <span class="visually-hidden">
              {%- if customer -%}{{ 'customer.account_fallback' | t }}{%- else -%}{{ 'customer.log_in' | t }}{%- endif -%}
            </span>
          </a>
        {%- endif -%}

        <a href="/pages/verlanglijst" class="bc-header__utility-link bc-header__utility-link--wishlist link focus-inset">
          <span class="bc-header__utility-icon" aria-hidden="true">
            <span class="svg-wrapper">{{ 'icon-wishlist-bc.svg' | inline_asset_content }}</span>
          </span>
          <span class="bc-header__utility-label">Verlanglijst</span>
          <span class="visually-hidden">Verlanglijst</span>
        </a>

        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}
          {%- endcase -%}
        {%- endfor -%}

        <a href="{{ routes.cart_url }}" class="bc-header__utility-link bc-header__utility-link--cart link focus-inset" id="cart-icon-bubble">
          {% render 'bc-header-cart' %}
        </a>
      </div>
    </div>
  </header>

  {%- if section.settings.menu != blank -%}
    <nav class="bc-category-nav" aria-label="{{ section.settings.category_nav_label | escape }}" data-bc-category-nav>
      <div class="bc-category-nav__shell">
        <button class="bc-category-nav__scroll bc-category-nav__scroll--previous" type="button" aria-label="{{ section.settings.category_previous_label | escape }}" data-bc-category-previous hidden><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m14 6-6 6 6 6"/></svg></button>
        <ul class="bc-category-nav__list" role="list" data-bc-category-list>
          {%- for link in section.settings.menu.links -%}
            <li class="bc-category-nav__item">
              {%- if link.links != blank -%}
                <details class="bc-category-nav__details" data-bc-category-details>
                  <summary class="bc-category-nav__toggle">
                    <a class="bc-category-nav__link{% if link.active %} is-active{% endif %}" href="{{ link.url | escape }}" aria-expanded="false" aria-controls="CategoryPanel-{{ section.id }}-{{ forloop.index }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
                  </summary>
                  <div class="bc-category-nav__panel" id="CategoryPanel-{{ section.id }}-{{ forloop.index }}" data-bc-category-panel>
                    <div class="bc-category-nav__content">
                      <ul class="bc-category-nav__groups" role="list">
                        {%- for child_link in link.links -%}
                          <li class="bc-category-nav__group">
                            <a class="bc-category-nav__group-link" href="{{ child_link.url | escape }}"{% if child_link.current %} aria-current="page"{% endif %}>{{ child_link.title | escape }}</a>
                            {%- if child_link.links != blank -%}
                              <ul class="bc-category-nav__children" role="list">
                                {%- for grandchild_link in child_link.links -%}
                                  <li><a href="{{ grandchild_link.url | escape }}"{% if grandchild_link.current %} aria-current="page"{% endif %}>{{ grandchild_link.title | escape }}</a></li>
                                {%- endfor -%}
                              </ul>
                            {%- endif -%}
                          </li>
                        {%- endfor -%}
                      </ul>
                    </div>
                  </div>
                </details>
              {%- else -%}
                <a class="bc-category-nav__link{% if link.active %} is-active{% endif %}" href="{{ link.url | escape }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
        <button class="bc-category-nav__scroll bc-category-nav__scroll--next" type="button" aria-label="{{ section.settings.category_next_label | escape }}" data-bc-category-next hidden><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m10 6 6 6-6 6"/></svg></button>
      </div>
      <div class="bc-category-nav__backdrop" data-bc-category-backdrop aria-hidden="true" hidden></div>
    </nav>
  {%- endif -%}
</{{ header_tag }}>

{%- if settings.cart_type == "notification" -%}
  {%- render 'cart-notification', color_scheme: section.settings.color_scheme, desktop_menu_type: section.settings.menu_type_desktop -%}
{%- endif -%}

{% stylesheet %}
.bc-category-nav{--bcn-navy:#1a253f;--bcn-blue:#aad1ed;position:relative;z-index:5;margin-top:8px;background:var(--bcn-blue);color:var(--bcn-navy);font-family:var(--font-body-family,Arial,sans-serif);font-size:14px;line-height:1.4;letter-spacing:0;text-align:left}
.bc-category-nav *,.bc-category-nav *::before,.bc-category-nav *::after{box-sizing:border-box}
.bc-category-nav [hidden]{display:none!important}
.bc-category-nav :is(ul,li,details,summary){list-style:none;margin:0;padding:0}
.bc-category-nav a{color:inherit;text-decoration:none}
.bc-category-nav :is(a,button,summary):focus-visible{outline:2px solid var(--bcn-navy);outline-offset:-3px}
.bc-category-nav :is(button,summary){font:inherit;color:inherit}
.bc-category-nav svg{display:block;width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex:none}
.bc-category-nav .bc-category-nav__shell{display:flex;align-items:center;gap:8px;width:100%;max-width:1440px;margin:0 auto;padding:0 24px}
.bc-category-nav .bc-category-nav__list{display:flex;align-items:stretch;justify-content:space-between;gap:0;min-width:0;flex:1;overflow-x:auto;overflow-y:hidden;scrollbar-width:thin;scrollbar-color:#1a253f45 transparent;overscroll-behavior-inline:contain;scroll-padding-inline:12px}
.bc-category-nav .bc-category-nav__list::-webkit-scrollbar{height:3px}
.bc-category-nav .bc-category-nav__list::-webkit-scrollbar-thumb{background:#1a253f45;border-radius:4px}
.bc-category-nav .bc-category-nav__item{flex:none;min-width:0}
.bc-category-nav .bc-category-nav__link{display:flex;align-items:center;justify-content:center;min-height:50px;padding:0 12px;font-size:16px;line-height:22px;font-weight:700;white-space:nowrap}
.bc-category-nav .bc-category-nav__link.is-active{text-decoration:underline;text-underline-offset:5px;text-decoration-thickness:1.5px}
.bc-category-nav .bc-category-nav__details[open]>.bc-category-nav__toggle{background:#fff}
.bc-category-nav .bc-category-nav__toggle{cursor:pointer;list-style:none}
.bc-category-nav .bc-category-nav__toggle::-webkit-details-marker{display:none}
.bc-category-nav .bc-category-nav__scroll{display:grid;place-items:center;flex:0 0 28px;width:28px;min-height:50px;padding:0;border:0;background:transparent;cursor:pointer}
.bc-category-nav .bc-category-nav__scroll:hover:not(:disabled){background:#ffffff35}
.bc-category-nav .bc-category-nav__scroll:disabled{opacity:.3;cursor:default}
.bc-category-nav .bc-category-nav__panel{position:fixed;top:var(--bcn-panel-top,var(--header-height,160px));left:0;right:0;z-index:40;max-height:calc(100dvh - var(--bcn-panel-top,160px) - 48px);background:#fff;color:var(--bcn-navy);box-shadow:0 10px 18px #1a253f0a;overflow:auto;overscroll-behavior:contain;scrollbar-width:thin;scrollbar-color:#aebbd0 transparent}
.bc-category-nav .bc-category-nav__content{width:100%;max-width:1440px;min-height:160px;margin:0 auto;padding:32px 36px 20px}
.bc-category-nav .bc-category-nav__groups{column-count:3;column-gap:72px;column-fill:balance}
.bc-category-nav .bc-category-nav__group{display:block;width:100%;min-width:0;margin:0 0 24px;break-inside:avoid;page-break-inside:avoid}
.bc-category-nav .bc-category-nav__group-link{display:inline-block;padding:2px 0;font-size:18px;line-height:26px;font-weight:700;overflow-wrap:anywhere}
.bc-category-nav .bc-category-nav__children{margin-top:8px}
.bc-category-nav .bc-category-nav__children a{display:inline-block;padding:3px 0;font-size:17px;line-height:24px;overflow-wrap:anywhere}
.bc-category-nav .bc-category-nav__group-link:hover,.bc-category-nav .bc-category-nav__children a:hover{text-decoration:underline;text-underline-offset:4px}
.bc-category-nav .bc-category-nav__backdrop{display:block;position:fixed;top:var(--bcn-panel-top,var(--header-height,160px));right:0;bottom:0;left:0;z-index:30;background:#1a253f38}
@media(max-width:1279px) and (min-width:990px){.bc-category-nav .bc-category-nav__list{justify-content:flex-start}.bc-category-nav .bc-category-nav__link{padding-inline:14px}.bc-category-nav .bc-category-nav__groups{column-gap:48px}}
@media(max-width:989px){.bc-category-nav{display:none}}
@media(prefers-reduced-motion:reduce){.bc-category-nav *{transition:none!important;scroll-behavior:auto!important}}
{% endstylesheet %}

{% javascript %}
  class BcMobileDrawer {
    constructor(container) {
      this.container = container;
      this.trigger = container.querySelector('[data-bc-mobile-trigger]');
      this.overlay = container.querySelector('[data-bc-mobile-overlay]');
      this.panel = container.querySelector('[data-bc-mobile-panel]');
      this.menuPanels = Array.from(container.querySelectorAll('[data-bc-mobile-menu-panel]'));
      this.nextTriggers = Array.from(container.querySelectorAll('[data-bc-mobile-next]'));
      this.backTriggers = Array.from(container.querySelectorAll('[data-bc-mobile-back]'));
      this.desktopMedia = window.matchMedia('(min-width: 990px)');
      this.header = document.querySelector('.section-header');
      this.closeTimer = null;
      this.panelStack = ['root'];

      if (!this.trigger || !this.panel) return;

      this.onTriggerClick = this.onTriggerClick.bind(this);
      this.onOverlayClick = this.onOverlayClick.bind(this);
      this.onKeyDown = this.onKeyDown.bind(this);
      this.onViewportChange = this.onViewportChange.bind(this);
      this.onResize = this.onResize.bind(this);

      this.trigger.addEventListener('click', this.onTriggerClick);
      this.overlay?.addEventListener('click', this.onOverlayClick);
      document.addEventListener('keydown', this.onKeyDown);
      this.desktopMedia.addEventListener('change', this.onViewportChange);

      this.nextTriggers.forEach((trigger) => {
        trigger.addEventListener('click', () => this.navigateForward(trigger.dataset.bcMobileNext));
      });

      this.backTriggers.forEach((trigger) => {
        trigger.addEventListener('click', () => this.navigateBack());
      });

      this.setOffset();
      this.syncPanels();
    }

    onTriggerClick() {
      if (this.container.classList.contains('is-open')) {
        this.close();
      } else {
        this.open();
      }
    }

    onOverlayClick() {
      this.close();
    }

    onKeyDown(event) {
      if (event.key === 'Escape' && this.container.classList.contains('is-open')) {
        this.close();
      }
    }

    onViewportChange(event) {
      if (event.matches) this.close();
    }

    onResize() {
      this.setOffset();
    }

    setOffset() {
      const offset = this.header ? Math.round(this.header.getBoundingClientRect().bottom) : 0;
      document.documentElement.style.setProperty('--bc-mobile-drawer-offset', `${Math.max(offset, 0)}px`);
    }

    open() {
      const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
      window.clearTimeout(this.closeTimer);
      this.resetNavigation();
      this.setOffset();

      this.panel.setAttribute('aria-hidden', 'false');
      this.trigger.setAttribute('aria-expanded', 'true');
      if (this.overlay) this.overlay.hidden = false;

      document.documentElement.classList.add('bc-mobile-menu-open');
      document.body.classList.add('bc-mobile-menu-open');
      document.body.style.paddingRight = `${Math.max(scrollbarWidth, 0)}px`;
      window.addEventListener('resize', this.onResize);

      requestAnimationFrame(() => {
        this.container.classList.add('is-open');
        this.panel.focus();
      });
    }

    close() {
      this.container.classList.remove('is-open');
      this.trigger.setAttribute('aria-expanded', 'false');

      document.documentElement.classList.remove('bc-mobile-menu-open');
      document.body.classList.remove('bc-mobile-menu-open');
      document.body.style.paddingRight = '';
      window.removeEventListener('resize', this.onResize);

      window.clearTimeout(this.closeTimer);
      this.closeTimer = window.setTimeout(() => {
        this.panel.setAttribute('aria-hidden', 'true');
        if (this.overlay) this.overlay.hidden = true;
        this.resetNavigation();
      }, 260);

      this.trigger.focus();
    }

    navigateForward(targetId) {
      if (!targetId || this.panelStack[this.panelStack.length - 1] === targetId) return;

      this.panelStack.push(targetId);
      this.syncPanels();
    }

    navigateBack() {
      if (this.panelStack.length <= 1) return;

      this.panelStack.pop();
      this.syncPanels();
    }

    resetNavigation() {
      this.panelStack = ['root'];
      this.syncPanels();
    }

    syncPanels() {
      const activePanelId = this.panelStack[this.panelStack.length - 1];
      const previousPanelIds = this.panelStack.slice(0, -1);

      this.menuPanels.forEach((menuPanel) => {
        menuPanel.classList.remove('is-active', 'is-under');

        if (menuPanel.dataset.bcMobilePanelId === activePanelId) {
          menuPanel.classList.add('is-active');
        } else if (previousPanelIds.includes(menuPanel.dataset.bcMobilePanelId)) {
          menuPanel.classList.add('is-under');
        }
      });
    }
  }

  document.querySelectorAll('[data-bc-mobile-drawer]').forEach((container) => {
    new BcMobileDrawer(container);
  });

  (() => {
    class BcCategoryNavigation {
      constructor(root) {
        this.root = root;
        this.shell = root.querySelector('.bc-category-nav__shell');
        this.list = root.querySelector('[data-bc-category-list]');
        this.previous = root.querySelector('[data-bc-category-previous]');
        this.next = root.querySelector('[data-bc-category-next]');
        this.backdrop = root.querySelector('[data-bc-category-backdrop]');
        this.details = [...root.querySelectorAll('[data-bc-category-details]')];
        this.panels = [...root.querySelectorAll('[data-bc-category-panel]')];
        this.desktop = window.matchMedia('(min-width: 990px)');
        this.finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
        this.hoverHandlers = [];
        this.openTimer = null;
        this.closeTimer = null;
        this.lastPointerType = null;
        this.touchWasOpen = false;
        this.onToggle = this.onToggle.bind(this);
        this.onClick = this.onClick.bind(this);
        this.onKeyDown = this.onKeyDown.bind(this);
        this.onScroll = this.onScroll.bind(this);
        this.onResize = this.onResize.bind(this);
        this.onFocusIn = this.onFocusIn.bind(this);
        this.onFocusOut = this.onFocusOut.bind(this);
        this.onPointerDown = this.onPointerDown.bind(this);
        this.onPrevious = () => this.scroll(-1);
        this.onNext = () => this.scroll(1);
        this.details.forEach(item => {
          item.querySelector('summary').tabIndex = -1;
          item.addEventListener('toggle', this.onToggle);
          const container = item.closest('.bc-category-nav__item');
          const enter = () => {
            if (!this.desktop.matches || !this.finePointer.matches) return;
            window.clearTimeout(this.openTimer);
            window.clearTimeout(this.closeTimer);
            this.openTimer = window.setTimeout(() => this.open(item), 120);
          };
          const leave = () => {
            if (!this.finePointer.matches) return;
            window.clearTimeout(this.openTimer);
            window.clearTimeout(this.closeTimer);
            this.closeTimer = window.setTimeout(() => {
              item.open = false;
              this.syncState();
            }, 160);
          };
          container.addEventListener('mouseenter', enter);
          container.addEventListener('mouseleave', leave);
          this.hoverHandlers.push({ container, enter, leave });
        });
        document.addEventListener('click', this.onClick);
        document.addEventListener('keydown', this.onKeyDown);
        this.root.addEventListener('pointerdown', this.onPointerDown);
        this.root.addEventListener('focusin', this.onFocusIn);
        this.root.addEventListener('focusout', this.onFocusOut);
        window.addEventListener('scroll', this.onScroll, true);
        window.addEventListener('resize', this.onResize);
        this.desktop.addEventListener('change', this.onResize);
        this.previous.addEventListener('click', this.onPrevious);
        this.next.addEventListener('click', this.onNext);
        this.root.dataset.bcCategoryReady = 'true';
        this.onResize();
        document.fonts?.ready.then(() => { if (this.root.isConnected) this.onResize(); });
      }
      position() {
        this.root.style.setProperty('--bcn-panel-top', `${Math.max(0, Math.round(this.root.getBoundingClientRect().bottom))}px`);
      }
      syncState() {
        this.details.forEach(item => item.querySelector('.bc-category-nav__link').setAttribute('aria-expanded', String(item.open)));
        this.backdrop.hidden = !this.details.some(item => item.open);
      }
      open(item) {
        if (!this.desktop.matches) return;
        window.clearTimeout(this.openTimer);
        window.clearTimeout(this.closeTimer);
        this.details.forEach(other => { if (other !== item) other.open = false; });
        this.position();
        item.open = true;
        this.syncState();
      }
      close(returnFocus = false) {
        window.clearTimeout(this.openTimer);
        window.clearTimeout(this.closeTimer);
        const open = this.details.find(item => item.open);
        this.details.forEach(item => { item.open = false; });
        this.syncState();
        if (returnFocus && open) {
          this.suppressFocusOpen = true;
          open.querySelector('.bc-category-nav__link').focus({ preventScroll: true });
          this.suppressFocusOpen = false;
        }
      }
      onToggle(event) {
        const item = event.currentTarget;
        if (item.open) {
          if (!this.desktop.matches) item.open = false;
          else {
            this.details.forEach(other => { if (other !== item) other.open = false; });
            this.position();
          }
        }
        this.syncState();
      }
      onPointerDown(event) {
        this.lastPointerType = event.pointerType;
        const link = event.target.closest('.bc-category-nav__link');
        this.touchWasOpen = Boolean(link?.closest('details')?.open);
      }
      onClick(event) {
        const link = event.target.closest('.bc-category-nav__link');
        if (link && this.root.contains(link)) {
          const item = link.closest('details');
          if (item && event.detail > 0 && (this.lastPointerType === 'touch' || !this.finePointer.matches) && !this.touchWasOpen) {
            event.preventDefault();
            this.open(item);
            return;
          }
          this.close();
        } else if (!this.root.contains(event.target) || event.target === this.backdrop) this.close();
      }
      onKeyDown(event) {
        if (event.key === 'Escape' && this.details.some(item => item.open)) {
          event.preventDefault();
          this.close(true);
          return;
        }
        const link = event.target.closest('.bc-category-nav__link');
        const item = link?.closest('details');
        if (item && this.root.contains(item) && (event.key === 'ArrowDown' || event.key === ' ')) {
          event.preventDefault();
          this.open(item);
          item.querySelector('[data-bc-category-panel] a')?.focus();
        }
      }
      onFocusIn(event) {
        const link = event.target.closest('.bc-category-nav__link');
        const item = link?.closest('details');
        if (item && !this.suppressFocusOpen && link.matches(':focus-visible')) this.open(item);
      }
      onFocusOut(event) {
        const item = event.target.closest('[data-bc-category-details]');
        if (!this.root.contains(event.relatedTarget)) this.close();
        else if (item && !item.contains(event.relatedTarget)) {
          item.open = false;
          this.syncState();
        }
      }
      onScroll(event) {
        if (this.panels.some(panel => panel === event.target || panel.contains(event.target))) return;
        if (event.target === this.list) this.syncControls();
        this.close();
      }
      syncControls() {
        const shellStyle = getComputedStyle(this.shell);
        const available = this.shell.clientWidth - parseFloat(shellStyle.paddingLeft) - parseFloat(shellStyle.paddingRight);
        const overflow = this.list.scrollWidth > available + 1;
        this.previous.hidden = !overflow;
        this.next.hidden = !overflow;
        this.previous.disabled = this.list.scrollLeft <= 1;
        this.next.disabled = this.list.scrollLeft >= this.list.scrollWidth - this.list.clientWidth - 1;
      }
      scroll(direction) {
        this.close();
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        this.list.scrollBy({ left: direction * this.list.clientWidth * 0.65, behavior: reduced ? 'auto' : 'smooth' });
      }
      onResize() {
        this.close();
        this.syncControls();
        this.position();
      }
      destroy() {
        this.close();
        this.details.forEach(item => {
          item.querySelector('summary').removeAttribute('tabindex');
          item.removeEventListener('toggle', this.onToggle);
        });
        this.hoverHandlers.forEach(({ container, enter, leave }) => {
          container.removeEventListener('mouseenter', enter);
          container.removeEventListener('mouseleave', leave);
        });
        document.removeEventListener('click', this.onClick);
        document.removeEventListener('keydown', this.onKeyDown);
        this.root.removeEventListener('pointerdown', this.onPointerDown);
        this.root.removeEventListener('focusin', this.onFocusIn);
        this.root.removeEventListener('focusout', this.onFocusOut);
        window.removeEventListener('scroll', this.onScroll, true);
        window.removeEventListener('resize', this.onResize);
        this.desktop.removeEventListener('change', this.onResize);
        this.previous.removeEventListener('click', this.onPrevious);
        this.next.removeEventListener('click', this.onNext);
        delete this.root.bcCategoryCleanup;
        delete this.root.dataset.bcCategoryReady;
      }
    }
    const roots = scope => {
      const found = [...scope.querySelectorAll('[data-bc-category-nav]')];
      if (scope.matches?.('[data-bc-category-nav]')) found.unshift(scope);
      return found;
    };
    const scan = scope => roots(scope).forEach(root => {
      if (!root.bcCategoryCleanup) {
        const navigation = new BcCategoryNavigation(root);
        root.bcCategoryCleanup = () => navigation.destroy();
      }
    });
    scan(document);
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', () => scan(document), { once: true });
    document.addEventListener('shopify:section:load', event => scan(event.target));
    document.addEventListener('shopify:section:unload', event => roots(event.target).forEach(root => root.bcCategoryCleanup?.()));
  })();

  class StickyHeader extends HTMLElement {
    constructor() {
      super();
    }

    connectedCallback() {
      this.header = document.querySelector('.section-header');
      this.headerIsAlwaysSticky = this.getAttribute('data-sticky-type') === 'always' || this.getAttribute('data-sticky-type') === 'reduce-logo-size';
      this.headerBounds = {};

      this.setHeaderHeight();

      window.matchMedia('(max-width: 990px)').addEventListener('change', this.setHeaderHeight.bind(this));

      if (this.headerIsAlwaysSticky) {
        this.header.classList.add('shopify-section-header-sticky');
      };

      this.currentScrollTop = 0;
      this.preventReveal = false;
      this.predictiveSearch = this.querySelector('predictive-search');

      this.onScrollHandler = this.onScroll.bind(this);
      this.hideHeaderOnScrollUp = () => this.preventReveal = true;

      this.addEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
      window.addEventListener('scroll', this.onScrollHandler, false);

      this.createObserver();
    }

    setHeaderHeight() {
      document.documentElement.style.setProperty('--header-height', `${this.header.offsetHeight}px`);
    }

    disconnectedCallback() {
      this.removeEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
      window.removeEventListener('scroll', this.onScrollHandler);
    }

    createObserver() {
      let observer = new IntersectionObserver((entries, observer) => {
        this.headerBounds = entries[0].intersectionRect;
        observer.disconnect();
      });

      observer.observe(this.header);
    }

    onScroll() {
      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;

      if (this.predictiveSearch && this.predictiveSearch.isOpen) return;

      if (scrollTop > this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
        this.header.classList.add('scrolled-past-header');
        if (this.preventHide) return;
        requestAnimationFrame(this.hide.bind(this));
      } else if (scrollTop < this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
        this.header.classList.add('scrolled-past-header');
        if (!this.preventReveal) {
          requestAnimationFrame(this.reveal.bind(this));
        } else {
          window.clearTimeout(this.isScrolling);

          this.isScrolling = setTimeout(() => {
            this.preventReveal = false;
          }, 66);

          requestAnimationFrame(this.hide.bind(this));
        }
      } else if (scrollTop <= this.headerBounds.top) {
        this.header.classList.remove('scrolled-past-header');
        requestAnimationFrame(this.reset.bind(this));
      }

      this.currentScrollTop = scrollTop;
    }

    hide() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.add('shopify-section-header-hidden', 'shopify-section-header-sticky');
      this.closeMenuDisclosure();
      this.closeSearchModal();
    }

    reveal() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.add('shopify-section-header-sticky', 'animate');
      this.header.classList.remove('shopify-section-header-hidden');
    }

    reset() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.remove('shopify-section-header-hidden', 'shopify-section-header-sticky', 'animate');
    }

    closeMenuDisclosure() {
      this.header.querySelectorAll('[data-bc-category-details][open]').forEach(item => { item.open = false; });
      this.disclosures = this.disclosures || this.header.querySelectorAll('header-menu');
      this.disclosures.forEach(disclosure => disclosure.close());
    }

    closeSearchModal() {
      this.searchModal = this.searchModal || this.header.querySelector('details-modal');
      if (this.searchModal) this.searchModal.close(false);
    }
  }

  customElements.define('sticky-header', StickyHeader);
{% endjavascript %}

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if settings.logo %}
      "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "sameAs": [
      {{ settings.social_twitter_link | json }},
      {{ settings.social_facebook_link | json }},
      {{ settings.social_pinterest_link | json }},
      {{ settings.social_instagram_link | json }},
      {{ settings.social_tiktok_link | json }},
      {{ settings.social_tumblr_link | json }},
      {{ settings.social_snapchat_link | json }},
      {{ settings.social_youtube_link | json }},
      {{ settings.social_vimeo_link | json }}
    ],
    "url": {{ request.origin | append: page.url | json }}
  }
</script>

{%- if request.page_type == 'index' -%}
  {% assign potential_action_target = request.origin | append: routes.search_url | append: "?q={search_term_string}" %}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ request.origin | append: page.url | json }}
    }
  </script>
{%- endif -%}

