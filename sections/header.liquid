                    class="bc-subnav__mega-panel{% if link.links == blank %} bc-subnav__mega-panel--empty{% endif %}{% if bc_collection_image == blank %} bc-subnav__mega-panel--image-empty{% endif %}"
                    data-bc-catalog-content="{{ forloop.index0 }}"
                    hidden
                  >
                    <div class="bc-subnav__mega-layout">
                      <div class="bc-subnav__mega-main">
                        <div class="bc-subnav__mega-header">
                          <a href="{{ link.url }}" class="bc-subnav__mega-title">
                            <span>{{ bc_category_title_formatted | escape }}</span>
                            <span class="bc-subnav__mega-title-chevron" aria-hidden="true"></span>
                          </a>
                        </div>
                        {%- if link.links != blank -%}
                          <div class="bc-subnav__mega-groups">
                            {%- for child_link in link.links -%}
                              {%- liquid
                                assign bc_child_title = child_link.title | strip
                                assign bc_child_title_formatted = bc_child_title | slice: 0, 1 | upcase | append: bc_child_title | slice: 1, 200
                              -%}
                              <div class="bc-subnav__mega-group">
                                <a href="{{ child_link.url }}" class="bc-subnav__mega-heading">
                                  {{ bc_child_title_formatted | escape }}
                                </a>
                                {%- if child_link.links != blank -%}
                                  <ul class="bc-subnav__mega-links" role="list">
                                    {%- for grandchild_link in child_link.links -%}
                                      {%- liquid
                                        assign bc_grandchild_title = grandchild_link.title | strip
                                        assign bc_grandchild_title_formatted = bc_grandchild_title | slice: 0, 1 | upcase | append: bc_grandchild_title | slice: 1, 200
                                      -%}
                                      <li>
                                        <a href="{{ grandchild_link.url }}" class="bc-subnav__mega-link">
                                          {{ bc_grandchild_title_formatted | escape }}
                                        </a>
                                      </li>
                                    {%- endfor -%}
                                  </ul>
                                {%- endif -%}
                              </div>
                            {%- endfor -%}
                          </div>
                        {%- endif -%}
                      </div>
                      {%- if bc_collection_image != blank -%}
                        <a href="{{ link.url }}" class="bc-subnav__mega-image" aria-label="{{ link.title | escape }}">
                          <div class="bc-subnav__mega-image-frame">
                            {{ bc_collection_image | image_url: width: 720 | image_tag:
                              widths: '360, 520, 720',
                              sizes: '(min-width: 1200px) 360px, 28vw',
                              loading: 'lazy',
                              alt: bc_collection_image.alt | default: link.title | escape
                            }}
                          </div>
                        </a>
                      {%- endif -%}
                    </div>
                  </div>
                {%- endfor -%}
              </div>
            </div>
          </div>
        </div>
        <a href="#" class="bc-subnav__link">Inspiratie</a>
        <a href="#" class="bc-subnav__link">Advies</a>
        <a href="#" class="bc-subnav__link">#MijnBadkamercity</a>
