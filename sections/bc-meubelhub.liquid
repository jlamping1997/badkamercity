{% comment %}
BadkamerCity category hub. Standalone template; does not modify product data,
collection membership, shared navigation, header, footer or filter code.
Unconfigured SEO selections are not linked to invented destinations.
{% endcomment %}
{{ 'bc-meubelhub.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bc-meubelhub.js' | asset_url }}" defer></script>
{%- liquid
  assign hub_title = section.settings.heading | default: collection.title
  assign parts = collection.description | replace: '<p>[SPLIT]</p>', '__BC_SPLIT__' | replace: '<p>[split]</p>', '__BC_SPLIT__' | replace: '[SPLIT]', '__BC_SPLIT__' | replace: '[split]', '__BC_SPLIT__' | split: '__BC_SPLIT__'
  assign intro = section.settings.intro
  if intro == blank
    assign intro = parts | first
  endif
  assign hero_src = section.settings.hero_url
  if section.settings.hero_image != blank
    assign hero_src = section.settings.hero_image | image_url: width: 1600
  endif
  assign inspiration_src = section.settings.inspiration_url
  if section.settings.inspiration_image != blank
    assign inspiration_src = section.settings.inspiration_image | image_url: width: 1000
  endif
  assign card_blocks = section.blocks | where: 'type', 'category'
  assign brand_blocks = section.blocks | where: 'type', 'brand'
  assign configured_brands = 0
  for item in brand_blocks
    if item.settings.destination != blank and item.settings.label != blank
      assign configured_brands = configured_brands | plus: 1
    endif
  endfor
-%}
<div class="bcm-hub" data-bcm-hub id="bcm-hub-{{ section.id }}">
  <header class="bcm-hero">
    <div class="bcm-hero__inner">
      <div class="bcm-hero__copy">
        <nav class="bcm-breadcrumb" aria-label="Broodkruimelnavigatie">
          <a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">›</span><span aria-current="page">{{ collection.title | escape }}</span>
        </nav>
        <p class="bcm-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h1>{{ hub_title | escape }}</h1>
        <div class="bcm-hero__intro">{{ intro }}</div>
        <ul class="bcm-hero__usps">
          {%- for i in (1..3) -%}
            {%- assign key = 'hero_usp_' | append: i -%}
            {%- if section.settings[key] != blank -%}
              <li><span class="bcm-check">{% render 'bc-meubelhub-icon', icon: 'check' %}</span>{{ section.settings[key] | escape }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
      <div class="bcm-hero__media">
        {%- if hero_src != blank -%}
          <img src="{{ hero_src | escape }}" alt="{{ section.settings.hero_alt | escape }}" width="976" height="644" fetchpriority="high" loading="eager" decoding="async">
        {%- endif -%}
      </div>
    </div>
  </header>
  <div class="bcm-wrap">
    {%- if request.design_mode -%}<p class="bcm-editor-note">Maat-, stijl- en merkselecties stel je hieronder in via menu’s. Zonder bestemming zijn voorbeeldkeuzes bewust niet klikbaar. Er worden geen lege SEO-pagina’s aangemaakt.</p>{%- endif -%}
    <nav class="bcm-categories" aria-labelledby="bcm-categories-title-{{ section.id }}">
      <h2 class="bcm-categories__title" id="bcm-categories-title-{{ section.id }}">Kies een categorie</h2>
      <div class="bcm-card-grid">
        {%- for block in card_blocks -%}
          {%- liquid
            assign destination = block.settings.category
            assign card_title = block.settings.label | default: destination.title
            assign card_url = destination.url
            assign card_src = block.settings.photo_url
            if block.settings.photo != blank
              assign card_src = block.settings.photo | image_url: width: 1000
            elsif card_src == blank and destination.image != blank
              assign card_src = destination.image | image_url: width: 1000
            endif
            assign can_link = false
            if destination != blank
              if destination.all_products_count > 0 or block.settings.allow_empty
                assign can_link = true
              endif
            endif
          -%}
          {% if can_link %}<a class="bcm-card" href="{{ card_url }}" {{ block.shopify_attributes }}>{% else %}<div class="bcm-card bcm-card--pending" {{ block.shopify_attributes }}>{% endif %}
            <div class="bcm-card__image">{% if card_src != blank %}<img src="{{ card_src | escape }}" alt="{{ block.settings.photo_alt | default: card_title | escape }}" width="800" height="302" loading="lazy" decoding="async">{% endif %}</div>
            <div class="bcm-card__caption"><div><h3>{{ card_title | escape }}</h3><p>{{ block.settings.caption | escape }}</p>{% unless can_link %}<small class="bcm-card__pending">Assortiment wordt aangevuld</small>{% endunless %}</div><span class="bcm-arrow">{% render 'bc-meubelhub-icon', icon: 'arrow' %}</span></div>
          {% if can_link %}</a>{% else %}</div>{% endif %}
        {%- endfor -%}
      </div>
    </nav>
    <section class="bcm-shop" aria-labelledby="bcm-shop-title-{{ section.id }}">
      <p class="bcm-eyebrow">Shop op jouw manier</p>
      <h2 id="bcm-shop-title-{{ section.id }}">{{ section.settings.shop_heading | escape }}</h2>
      <div class="bcm-groups">
        {%- assign group_keys = 'type,maat,stijl,merk' | split: ',' -%}
        {%- for group in group_keys -%}
          {%- assign menu_key = group | append: '_menu' -%}
          {%- assign group_menu = section.settings[menu_key] -%}
          <details class="bcm-group" data-bcm-group open>
            <summary>{% render 'bc-meubelhub-icon', icon: group %}<h3>Op {{ group }}</h3><span class="bcm-group__chevron">{% render 'bc-meubelhub-icon', icon: 'down' %}</span></summary>
            <div class="bcm-group__body">
              <ul class="bcm-group__links">
                {%- if group_menu != blank and group_menu.links.size > 0 -%}
                  {%- for link in group_menu.links -%}<li><a href="{{ link.url }}">{{ link.title | escape }}{% render 'bc-meubelhub-icon', icon: 'chevron' %}</a></li>{%- endfor -%}
                {%- elsif group == 'type' -%}
                  {%- for block in card_blocks -%}
                    {%- assign destination = block.settings.category -%}
                    <li>{% if destination != blank and destination.all_products_count > 0 %}<a href="{{ destination.url }}">{{ block.settings.label | default: destination.title | escape }}{% render 'bc-meubelhub-icon', icon: 'chevron' %}</a>{% else %}<span class="bcm-pending-link">{{ block.settings.label | escape }}</span>{% endif %}</li>
                  {%- endfor -%}
                {%- elsif group == 'merk' and collection.all_vendors.size > 0 -%}
                  {%- for vendor in collection.all_vendors limit: 6 -%}<li><a href="{{ vendor | url_for_vendor }}">{{ vendor | escape }}{% render 'bc-meubelhub-icon', icon: 'chevron' %}</a></li>{%- endfor -%}
                {%- elsif section.settings.show_pending -%}
                  {%- case group -%}
                    {%- when 'maat' -%}{%- assign pending_labels = '60 cm|80 cm|100 cm|120 cm|140 cm|160 cm en breder' | split: '|' -%}
                    {%- when 'stijl' -%}{%- assign pending_labels = 'Modern|Japandi|Hotel chique|Landelijk|Industrieel|Tijdloos' | split: '|' -%}
                    {%- else -%}{%- assign pending_labels = '' | split: '|' -%}
                  {%- endcase -%}
                  {%- for label in pending_labels -%}{%- if label != blank -%}<li><span class="bcm-pending-link">{{ label | escape }}</span></li>{%- endif -%}{%- endfor -%}
                {%- endif -%}
              </ul>
              {%- if group_menu == blank and group != 'type' -%}
                {%- unless group == 'merk' and collection.all_vendors.size > 0 -%}<p class="bcm-group__note">Deze selecties worden aangevuld zodra het assortiment klaarstaat.</p>{%- endunless -%}
              {%- endif -%}
            </div>
          </details>
        {%- endfor -%}
      </div>
    </section>
    {%- if section.settings.show_brands -%}
      <section class="bcm-brands" aria-labelledby="bcm-brands-title-{{ section.id }}">
        <h2 id="bcm-brands-title-{{ section.id }}">{{ section.settings.brands_heading | escape }}</h2>
        <p>{{ section.settings.brands_intro | escape }}</p>
        {%- if configured_brands > 0 or collection.all_vendors.size > 0 -%}
          <div class="bcm-brand-grid">
            {%- if configured_brands > 0 -%}
              {%- for block in brand_blocks -%}{%- if block.settings.destination != blank and block.settings.label != blank -%}
                <a class="bcm-brand" href="{{ block.settings.destination }}" {{ block.shopify_attributes }}>{% if block.settings.logo != blank %}{{ block.settings.logo | image_url: width: 360 | image_tag: loading: 'lazy', alt: block.settings.label }}{% else %}<span class="bcm-brand__name">{{ block.settings.label | escape }}</span>{% endif %}</a>
              {%- endif -%}{%- endfor -%}
            {%- else -%}
              {%- for vendor in collection.all_vendors limit: 6 -%}<a class="bcm-brand" href="{{ vendor | url_for_vendor }}"><span class="bcm-brand__name">{{ vendor | escape }}</span></a>{%- endfor -%}
            {%- endif -%}
            {%- if section.settings.brands_url != blank -%}<a class="bcm-brand bcm-brand--more" href="{{ section.settings.brands_url }}">Alle merken bekijken{% render 'bc-meubelhub-icon', icon: 'arrow' %}</a>{%- endif -%}
          </div>
        {%- else -%}<p class="bcm-brands__empty">De merkselecties volgen zodra de bijbehorende producten beschikbaar zijn.</p>{%- endif -%}
      </section>
    {%- endif -%}
    <div class="bcm-bottom">
      <section class="bcm-inspiration" aria-labelledby="bcm-inspiration-title-{{ section.id }}">
        <div class="bcm-inspiration__media">{% if inspiration_src != blank %}<img src="{{ inspiration_src | escape }}" alt="Lichte badkamer met een houten meubel en ronde waskom, ter inspiratie" width="708" height="384" loading="lazy" decoding="async">{% endif %}</div>
        <div class="bcm-inspiration__copy"><p>Ontdek jouw stijl</p><h2 id="bcm-inspiration-title-{{ section.id }}">Van modern<br>tot landelijk</h2><a class="bcm-button" href="{% if section.settings.inspiration_link != blank %}{{ section.settings.inspiration_link }}{% else %}#bcm-advies-{{ section.id }}{% endif %}">{% if section.settings.inspiration_link != blank %}Bekijk alle stijlen{% else %}Bekijk het keuzeadvies{% endif %}{% render 'bc-meubelhub-icon', icon: 'arrow' %}</a></div>
      </section>
      <section class="bcm-services" aria-labelledby="bcm-services-title-{{ section.id }}">
        <h2 id="bcm-services-title-{{ section.id }}">Waarom kiezen voor BadkamerCity?</h2>
        <div class="bcm-services__grid">
          {%- assign service_icons = 'levering,schild,advies,combineren' | split: ',' -%}
          {%- for icon in service_icons -%}{%- assign title_key = 'service_title_' | append: forloop.index -%}{%- assign text_key = 'service_text_' | append: forloop.index -%}<div class="bcm-service">{% render 'bc-meubelhub-icon', icon: icon %}<div><h3>{{ section.settings[title_key] | escape }}</h3><p>{{ section.settings[text_key] | escape }}</p></div></div>{%- endfor -%}
        </div>
      </section>
    </div>
    <section class="bcm-advice" id="bcm-advies-{{ section.id }}" aria-labelledby="bcm-advice-title-{{ section.id }}">
      <p class="bcm-eyebrow">Goed voorbereid kiezen</p><h2 id="bcm-advice-title-{{ section.id }}">Advies over {{ collection.title | downcase | escape }}</h2>
      {%- capture advice_raw -%}{%- if parts.size > 1 -%}{%- for part in parts offset: 1 -%}{{ part }}{%- endfor -%}{%- else -%}{{ section.settings.advice_fallback }}{%- endif -%}{%- endcapture -%}
      {%- assign advice_semantic = advice_raw
        | replace: '<h3>', '__BC_H3_OPEN__'
        | replace: '</h3>', '__BC_H3_CLOSE__'
        | replace: '<h2>', '<h3>'
        | replace: '</h2>', '</h3>'
        | replace: '__BC_H3_OPEN__', '<h4>'
        | replace: '__BC_H3_CLOSE__', '</h4>'
      -%}
      <div class="bcm-advice__text rte">{{ advice_semantic }}</div>
    </section>
  </div>
</div>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": {{ canonical_url | append: '#webpage' | json }},
      "url": {{ canonical_url | json }},
      "name": {{ hub_title | json }},
      "description": {{ intro | strip_html | strip | json }},
      "breadcrumb": {"@id": {{ canonical_url | append: '#breadcrumb' | json }}},
      "mainEntity": {"@id": {{ canonical_url | append: '#categories' | json }}}
    },
    {
      "@type": "BreadcrumbList",
      "@id": {{ canonical_url | append: '#breadcrumb' | json }},
      "itemListElement": [
        {"@type":"ListItem","position":1,"name":"Home","item":{{ request.origin | append: routes.root_url | json }}},
        {"@type":"ListItem","position":2,"name":{{ collection.title | json }},"item":{{ canonical_url | json }}}
      ]
    },
    {
      "@type": "ItemList",
      "@id": {{ canonical_url | append: '#categories' | json }},
      "name": {{ 'Categorieën binnen ' | append: collection.title | json }},
      "itemListElement": [
        {%- assign schema_position = 0 -%}
        {%- for block in card_blocks -%}
          {%- assign schema_destination = block.settings.category -%}
          {%- assign schema_can_link = false -%}
          {%- if schema_destination != blank -%}
            {%- if schema_destination.all_products_count > 0 or block.settings.allow_empty -%}
              {%- assign schema_can_link = true -%}
            {%- endif -%}
          {%- endif -%}
          {%- if schema_can_link -%}
            {%- assign schema_position = schema_position | plus: 1 -%}
            {%- if schema_position > 1 -%},{%- endif -%}
            {"@type":"ListItem","position":{{ schema_position }},"name":{{ block.settings.label | default: schema_destination.title | json }},"url":{{ schema_destination.url | prepend: request.origin | json }}}
          {%- endif -%}
        {%- endfor -%}
      ]
    }
  ]
}
</script>
{% schema %}
{"name":"BadkamerCity meubelhub","tag":"section","class":"section-bc-meubelhub","settings":[{"type":"header","content":"Hero en introductie"},{"type":"text","id":"heading","label":"Paginatitel (leeg = collectietitel)"},{"type":"text","id":"eyebrow","label":"Bovenregel","default":"Stijlvol en praktisch"},{"type":"richtext","id":"intro","label":"Korte introductie"},{"type":"image_picker","id":"hero_image","label":"Hero afbeelding (vervangbaar)"},{"type":"url","id":"hero_url","label":"Hero afbeelding URL"},{"type":"text","id":"hero_alt","label":"Beschrijving hero afbeelding","default":"Sfeerbeeld van een houten badkamermeubel met twee waskommen en een verlichte spiegel"},{"type":"text","id":"hero_usp_1","label":"Voordeel 1","default":"Badmeubels en bijpassende toebehoren"},{"type":"text","id":"hero_usp_2","label":"Voordeel 2","default":"Zelf je combinatie samenstellen"},{"type":"text","id":"hero_usp_3","label":"Voordeel 3","default":"Persoonlijk advies"},{"type":"header","content":"Shop op jouw manier"},{"type":"text","id":"shop_heading","label":"Titel keuzehulp","default":"Vind het perfecte badkamermeubel"},{"type":"link_list","id":"type_menu","label":"Menu: op type"},{"type":"link_list","id":"maat_menu","label":"Menu: op maat"},{"type":"link_list","id":"stijl_menu","label":"Menu: op stijl"},{"type":"link_list","id":"merk_menu","label":"Menu: op merk"},{"type":"checkbox","id":"show_pending","label":"Toon niet-klikbare maat/stijlvoorbeelden tot menu’s gekoppeld zijn","default":true},{"type":"header","content":"Merken"},{"type":"checkbox","id":"show_brands","label":"Merkenblok tonen","default":true},{"type":"text","id":"brands_heading","label":"Titel merkenblok","default":"Merken ontdekken"},{"type":"text","id":"brands_intro","label":"Ondertitel merkenblok","default":"Vind de producten van jouw merk"},{"type":"url","id":"brands_url","label":"Bestemming Alle merken (optioneel)"},{"type":"header","content":"Inspiratie en service"},{"type":"image_picker","id":"inspiration_image","label":"Inspiratieafbeelding (vervangbaar)"},{"type":"url","id":"inspiration_url","label":"Inspiratieafbeelding URL"},{"type":"url","id":"inspiration_link","label":"Stijlenpagina (leeg = keuzeadvies op deze pagina)"},{"type":"text","id":"service_title_1","label":"Servicetitel 1","default":"Levering & beschikbaarheid"},{"type":"text","id":"service_text_1","label":"Serviceuitleg 1","default":"Bekijk de productinformatie"},{"type":"text","id":"service_title_2","label":"Servicetitel 2","default":"Veilig bestellen"},{"type":"text","id":"service_text_2","label":"Serviceuitleg 2","default":"Via onze Shopify-checkout"},{"type":"text","id":"service_title_3","label":"Servicetitel 3","default":"Persoonlijk advies"},{"type":"text","id":"service_text_3","label":"Serviceuitleg 3","default":"Hulp bij jouw keuze"},{"type":"text","id":"service_title_4","label":"Servicetitel 4","default":"Zelf samenstellen"},{"type":"text","id":"service_text_4","label":"Serviceuitleg 4","default":"Meubels en toebehoren combineren"},{"type":"richtext","id":"advice_fallback","label":"Advies als [SPLIT]-tekst ontbreekt","default":"<p>Vergelijk de beschikbare ruimte, de indeling en welke onderdelen bij jouw gekozen meubel zijn inbegrepen. Neem bij twijfel contact op voor advies.</p>"}],"max_blocks":24,"blocks":[{"type":"category","name":"Categoriekaart","settings":[{"type":"collection","id":"category","label":"Bestaande collectie"},{"type":"text","id":"label","label":"Titel"},{"type":"text","id":"caption","label":"Korte ondertitel"},{"type":"image_picker","id":"photo","label":"Afbeelding (vervangbaar)"},{"type":"url","id":"photo_url","label":"Afbeelding URL"},{"type":"text","id":"photo_alt","label":"Afbeeldingbeschrijving"},{"type":"checkbox","id":"allow_empty","label":"Lege collectie toch klikbaar (alleen zinvolle navigatiepagina’s)","default":false}]},{"type":"brand","name":"Merkkaart","settings":[{"type":"text","id":"label","label":"Merknaam"},{"type":"url","id":"destination","label":"Bestaande merkselectie"},{"type":"image_picker","id":"logo","label":"Officieel merklogo"}]}],"presets":[{"name":"BadkamerCity meubelhub"}]}
{% endschema %}
