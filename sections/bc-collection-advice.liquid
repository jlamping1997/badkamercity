{{ 'bc-collection.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign tree_menu = section.settings.navigation_menu | default: linklists['main-menu']
  assign is_faucet_category = false
  for root_link in tree_menu.links
    if root_link.object.handle == 'kranen'
      if root_link.object.id == collection.id
        assign is_faucet_category = true
      endif
      for middle_link in root_link.links
        if middle_link.object.id == collection.id
          assign is_faucet_category = true
        endif
        for leaf_link in middle_link.links
          if leaf_link.object.id == collection.id
            assign is_faucet_category = true
          endif
        endfor
      endfor
    endif
  endfor
  assign advice_family = 'general'
  if is_faucet_category
    assign advice_family = 'faucets'
  endif
  assign advice_prefix = 'bc_collection.' | append: advice_family
-%}
<section id="bc-category-advice-{{ collection.id }}" class="bc-collection-advice" aria-labelledby="bc-advice-title-{{ section.id }}">
  <div class="page-width">
    <div class="bc-collection-advice__heading">
      <p class="bc-collection-eyebrow">{{ 'bc_collection.choice_help' | t }}</p>
      <h2 id="bc-advice-title-{{ section.id }}">{{ advice_prefix | append: '.heading' | t }}</h2>
      <p>{{ advice_prefix | append: '.intro' | t }}</p>
    </div>
    <div class="bc-advice-grid">
      {%- for index in (1..3) -%}
        <article class="bc-advice-card">
          <span class="bc-advice-card__number" aria-hidden="true">0{{ index }}</span>
          <h3>{{ advice_prefix | append: '.title_' | append: index | t }}</h3>
          <p>{{ advice_prefix | append: '.body_' | append: index | t }}</p>
        </article>
      {%- endfor -%}
    </div>
    {%- if section.settings.extra_content != blank -%}
      <div class="bc-collection-advice__extra rte">{{ section.settings.extra_content }}</div>
    {%- endif -%}
    {%- if section.settings.show_faq and is_faucet_category -%}
      <div class="bc-category-faq">
        <h2>{{ 'bc_collection.faq_title' | t: category: collection.title }}</h2>
        {%- for index in (1..3) -%}
          {%- assign question_key = 'bc_collection.faq.question_' | append: index -%}
          {%- assign answer_key = 'bc_collection.faq.answer_' | append: index -%}
          <details class="bc-category-faq__item">
            <summary>{{ question_key | t }}<span class="svg-wrapper" aria-hidden="true">{{ 'icon-caret.svg' | inline_asset_content }}</span></summary>
            <div class="bc-category-faq__answer"><p>{{ answer_key | t }}</p></div>
          </details>
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- if section.settings.show_contact and pages['contact'] != blank -%}
      <div class="bc-category-help">
        <div><h2>{{ 'bc_collection.help_title' | t }}</h2><p>{{ 'bc_collection.help_body' | t }}</p></div>
        <a class="bc-collection-button" href="{{ pages['contact'].url }}">{{ 'bc_collection.contact' | t }}<span aria-hidden="true">→</span></a>
      </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "BadkamerCity keuzeadvies",
  "settings": [
    {"type":"link_list","id":"navigation_menu","label":"Menu voor categorieboom","default":"main-menu"},
    {"type":"richtext","id":"extra_content","label":"Aanvullend advies"},
    {"type":"checkbox","id":"show_faq","label":"Toon veelgestelde vragen bij kranen","default":true},
    {"type":"checkbox","id":"show_contact","label":"Toon contactblok","default":true}
  ],
  "presets": [{"name":"BadkamerCity keuzeadvies"}]
}
{% endschema %}
