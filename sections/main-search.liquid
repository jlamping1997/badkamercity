{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-search.css' | asset_url | stylesheet_tag }}

{%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
  {{ 'component-facets.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

<script src="{{ 'main-search.js' | asset_url }}" defer="defer"></script>

<style>
  .template-search__header {
    margin-bottom: 3.2rem;
  }

  .template-search__intro {
    max-width: 72rem;
  }

  .template-search__eyebrow {
    margin: 0 0 1rem;
    color: rgba(var(--color-foreground), 0.62);
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .template-search__title {
    margin: 0;
    color: rgb(var(--color-foreground));
    font-size: clamp(3rem, 4vw, 4.6rem);
    line-height: 1.08;
  }

  .template-search__subtitle {
    margin: 1.2rem 0 0;
    color: rgba(var(--color-foreground), 0.7);
    font-size: 1.7rem;
    line-height: 1.5;
    max-width: 56rem;
  }

  .template-search--empty {
    padding-bottom: 18rem;
  }

  .template-search__layout {
    align-items: flex-start;
    gap: 0;
  }

  .template-search__toolbar {
    margin-bottom: 2.8rem;
    padding-bottom: 2rem;
    border-bottom: 0.1rem solid rgba(var(--color-foreground), 0.08);
  }

  .template-search__toolbar-form {
    position: relative;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2.4rem;
  }

  .template-search__toolbar-summary {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .template-search__toolbar-label {
    color: rgba(var(--color-foreground), 0.56);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .template-search__toolbar-count {
    margin: 0;
    color: rgb(var(--color-foreground));
    font-size: 1.7rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .template-search__toolbar-sort {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1.2rem;
    margin-left: auto;
  }

  .template-search__toolbar-sort-label {
    color: rgba(var(--color-foreground), 0.72);
    font-size: 1.4rem;
    white-space: nowrap;
  }

  .template-search__toolbar-sort .select {
    min-width: 19rem;
  }

  .template-search__toolbar-sort .select:before,
  .template-search__toolbar-sort .select:after {
    content: none;
  }

  .template-search__toolbar-sort .select__select {
    min-height: 4.8rem;
    padding: 0 4rem 0 1.6rem;
    border: 0.1rem solid rgba(var(--color-foreground), 0.16);
    border-radius: 1.2rem;
    box-shadow: none;
    background: rgb(var(--color-background));
    font-size: 1.4rem;
  }

  .template-search__toolbar-sort .icon-caret {
    right: 1.5rem;
  }

  .template-search__toolbar .loading__spinner {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
  }

  .template-search__results {
    margin-top: 0;
  }

  .template-search__results .grid {
    row-gap: 2.8rem;
  }

  .template-search__results .grid__item {
    min-width: 0;
  }

  .template-search__results .grid > .template-search__grid-item--usp {
    margin: 0;
    width: 100%;
    max-width: 100%;
    flex: 0 0 100%;
    padding-bottom: 0;
    align-self: stretch;
  }

  .template-search__results .grid > .template-search__grid-item--usp-mobile {
    display: none;
  }

  .bc-search-usp-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(18rem, 1fr));
    align-items: center;
    gap: 2.8rem;
    width: 100%;
    min-width: 0;
    padding: 1.4rem 2.8rem;
    border: 0;
    background: #f4f4f4;
  }

  .bc-search-usp-strip__item {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.9rem;
    min-width: 0;
  }

  .bc-search-usp-strip__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 1.8rem;
    height: 1.8rem;
    color: #14b86f;
  }

  .bc-search-usp-strip__icon .icon,
  .bc-search-usp-strip__icon svg {
    width: 1.8rem;
    height: 1.8rem;
  }

  .bc-search-usp-strip__icon svg,
  .bc-search-usp-strip__icon svg path {
    fill: #14b86f;
  }

  .bc-search-usp-strip__title {
    color: rgb(var(--color-foreground));
    font-size: 1.45rem;
    font-weight: 500;
    line-height: 1.3;
    min-width: 0;
  }

  .bc-search-card {
    height: 100%;
  }

  .bc-search-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 100%;
    border: 0.1rem solid rgba(var(--color-foreground), 0.08);
    border-radius: 1.8rem;
    background: rgb(var(--color-background));
    overflow: hidden;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      border-color 180ms ease;
  }

  .bc-search-card__link:hover {
    transform: translateY(-0.2rem);
    border-color: rgba(var(--color-foreground), 0.12);
    box-shadow: 0 1.6rem 3rem rgba(var(--color-foreground), 0.06);
  }

  .bc-search-card__media-wrapper {
    position: relative;
    padding: 0;
  }

  .bc-search-card__media {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    min-height: 32rem;
    padding: 0 0 0;
    border-radius: 1.8rem 1.8rem 0 0;
    background: linear-gradient(180deg, rgba(var(--color-foreground), 0.03), rgba(var(--color-foreground), 0.01));
    overflow: hidden;
  }

  .bc-search-card__image,
  .bc-search-card__image-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
  }

  .bc-search-card__image {
    position: absolute;
    inset: 0;
    padding: 0;
    transition: opacity 220ms ease, transform 220ms ease;
  }

  .bc-search-card__image--secondary {
    opacity: 0;
  }

  .bc-search-card__badge {
    position: absolute;
    left: 1.8rem;
    top: 1.8rem;
    z-index: 1;
    padding: 0.75rem 1.2rem;
    border-radius: 999px;
    background: rgba(61, 90, 196, 0.12);
    backdrop-filter: blur(4px);
    color: #ffffff;
    border: 0;
    box-shadow: none;
    color: #3d5ac4;
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: none;
  }

  .bc-search-card__content {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 1.45rem;
    padding: 1.7rem 1.8rem 2rem;
  }

  .bc-search-card__title-wrap {
    min-height: 5.6rem;
  }

  .bc-search-card__title {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: rgb(var(--color-foreground));
    font-size: 1.65rem;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.4;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .bc-search-card__price-wrap {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 0.1rem solid rgba(var(--color-foreground), 0.06);
  }

  .bc-search-card__specs {
    margin-top: 0.2rem !important;
  }

  .bc-search-card__price {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
    letter-spacing: 0;
    width: 100%;
  }

  .bc-search-card__price .price__container {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
    width: 100%;
  }

  .bc-search-card__price .price__sale,
  .bc-search-card__price .price__regular {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
  }

  .bc-search-card__price .price__sale {
    width: 100%;
    justify-content: space-between;
  }

  .bc-search-card__price .price__sale > span:last-child {
    margin-left: auto;
  }

  .bc-search-card__price .price-item {
    display: inline-flex;
    margin: 0;
  }

  .bc-search-card__price .price-item--regular {
    color: rgba(var(--color-foreground), 0.44);
    font-size: 1.3rem;
    font-weight: 500;
  }

  .bc-search-card__price .price-item--sale,
  .bc-search-card__price .price-item--last,
  .bc-search-card__price .price-item:not(.price-item--regular) {
    color: rgb(var(--color-foreground));
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.15;
  }

  .bc-search-card__price.price--on-sale .price__regular {
    display: none;
  }

  .bc-search-card__meta {
    min-height: 0.2rem;
  }

  @media screen and (min-width: 750px) {
    .template-search__header {
      margin-bottom: 4.8rem;
    }
  }

  .search__button .icon {
    height: 1.8rem;
  }

  @media screen and (min-width: 990px) {
    .template-search__layout {
      gap: 3rem;
    }

    .template-search__layout .facets-wrapper {
      flex: 0 0 25rem;
      padding-right: 0;
    }

    .template-search__layout .facets__form-vertical {
      width: 100%;
      padding: 2.2rem 2.4rem;
      border: 0.1rem solid rgba(var(--color-foreground), 0.08);
      border-radius: 1.8rem;
      background: rgb(var(--color-background));
    }

    .template-search__layout .product-grid-container {
      min-width: 0;
      flex: 1 1 auto;
    }

    .template-search__results .grid {
      row-gap: 3.2rem;
    }

    .template-search__layout .facets__disclosure-vertical:first-of-type {
      border-top: 0;
    }

    .template-search__layout .facets__summary {
      padding-top: 1.2rem;
      padding-bottom: 1.2rem;
    }
  }

  @media screen and (max-width: 989px) {
    .template-search__header {
      margin-bottom: 2.8rem;
    }

    .template-search__title {
      font-size: 3.2rem;
    }

    .template-search__subtitle {
      margin-top: 1rem;
      font-size: 1.5rem;
    }

    .bc-search-card__link {
      border-radius: 1.6rem;
    }

    .bc-search-card__media-wrapper {
      padding: 0;
    }

    .bc-search-card__media {
      min-height: 24.5rem;
      padding: 0;
    }

    .bc-search-card__badge {
      left: 1.4rem;
      top: 1.4rem;
      font-size: 1rem;
      padding: 0.55rem 0.95rem;
      border-radius: 999px;
      box-shadow: none;
    }

    .bc-search-card__content {
      gap: 1.2rem;
      padding: 1.3rem 1.3rem 1.6rem;
    }

    .bc-search-card__title-wrap {
      min-height: 4.8rem;
    }

    .bc-search-card__title {
      font-size: 1.45rem;
      line-height: 1.38;
    }

    .bc-search-card__price .price-item--regular {
      font-size: 1.2rem;
    }

    .bc-search-card__price .price-item--sale,
    .bc-search-card__price .price-item--last,
    .bc-search-card__price .price-item:not(.price-item--regular) {
      font-size: 1.65rem;
    }

    .bc-search-card__price-wrap {
      padding-top: 0.8rem;
    }

    .template-search__toolbar {
      display: none;
    }

    .template-search__results .grid > .template-search__grid-item--usp {
      margin-top: -0.6rem;
    }

    .template-search__results .grid > .template-search__grid-item--usp-desktop {
      display: none;
    }

    .template-search__results .grid > .template-search__grid-item--usp-mobile {
      display: list-item;
    }

    .bc-search-usp-strip {
      grid-template-columns: 1fr;
      gap: 1.2rem;
      padding: 1.4rem 1.6rem;
    }

    .bc-search-usp-strip__item {
      justify-content: flex-start;
    }

    .bc-search-usp-strip__item:nth-child(n + 2) {
      display: none;
    }

    .bc-search-usp-strip__icon {
      width: 1.8rem;
      height: 1.8rem;
    }

    .bc-search-usp-strip__title {
      font-size: 1.4rem;
    }
  }

  @media screen and (min-width: 990px) {
    .bc-search-card__link:hover .bc-search-card__image--secondary {
      opacity: 1;
    }

    .bc-search-card__link:hover .bc-search-card__image--primary {
      opacity: 0;
      transform: scale(1.015);
    }
  }
</style>

{%- liquid
  assign sort_by = search.sort_by | default: search.default_sort_by
  assign terms = search.terms | escape
  assign search_url = '?q=' | append: terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% paginate search.results by 36 %}
  <div class="template-search{% unless search.performed and search.results_count > 0 %} template-search--empty{% endunless %} section-{{ section.id }}-padding">
    <div class="template-search__header page-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      <div class="template-search__intro">
        <p class="template-search__eyebrow">
          {%- if search.performed -%}
            {{- 'templates.search.title' | t -}}
          {%- else -%}
            {{- 'general.search.search' | t -}}
          {%- endif -%}
        </p>
        <h1 class="template-search__title">
          {%- if search.performed and search.terms != blank -%}
            Zoekresultaten voor '{{ search.terms }}'
          {%- elsif search.performed -%}
            {{- 'templates.search.title' | t -}}
          {%- else -%}
            {{- 'general.search.search' | t -}}
          {%- endif -%}
        </h1>
        {%- if search.performed and search.results_count > 0 -%}
          <p class="template-search__subtitle">
            Gebruik de filters en sortering om sneller door het assortiment te navigeren.
          </p>
        {%- endif -%}
      </div>
      {%- if search.performed -%}
        {%- unless section.settings.enable_filtering or section.settings.enable_sorting -%}
          {%- if search.results_count > 0 -%}
            <p role="status">
              {{ 'templates.search.results_with_count_and_term' | t: terms: search.terms, count: search.results_count }}
            </p>
          {%- endif -%}
        {%- endunless -%}
        {%- if search.results_count == 0 and search.filters == empty -%}
          <p role="status">{{ 'templates.search.no_results' | t: terms: search.terms }}</p>
        {%- endif -%}
      {%- endif -%}
    </div>
    {%- if search.performed -%}
      <div
        {% if section.settings.filter_type == 'vertical' %}
          class="facets-vertical page-width template-search__layout"
        {% endif %}
      >
        {%- if search.filters != empty -%}
          {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
            <aside
              aria-labelledby="verticalTitle"
              class="facets-wrapper{% unless section.settings.enable_filtering %} facets-wrapper--no-filters{% endunless %}{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
              id="main-search-filters"
              data-id="{{ section.id }}"
            >
              {% render 'facets',
                results: search,
                enable_filtering: section.settings.enable_filtering,
                enable_sorting: section.settings.enable_sorting,
                filter_type: section.settings.filter_type,
                paginate: paginate
              %}
            </aside>
          {%- endif -%}
        {%- endif -%}
        <div class="product-grid-container" id="ProductGridContainer">
          {%- if section.settings.filter_type == 'vertical' -%}
            <facet-filters-form class="template-search__toolbar small-hide">
              <form class="template-search__toolbar-form" id="FacetSortForm">
                {%- if search.terms -%}
                  <input type="hidden" name="q" value="{{ search.terms | escape }}">
                  <input name="options[prefix]" type="hidden" value="last">
                {%- endif -%}
                <div class="template-search__toolbar-summary">
                  <span class="template-search__toolbar-label">Resultaten</span>
                  <p class="template-search__toolbar-count" role="status">
                    <span id="ProductCountDesktop">
                      {%- if search.results_count -%}
                        {{ 'templates.search.results_with_count' | t: terms: search.terms, count: search.results_count }}
                      {%- elsif search.products_count == search.all_products_count -%}
                        {{ 'products.facets.product_count_simple' | t: count: search.products_count }}
                      {%- else -%}
                        {{
                          'products.facets.product_count'
                          | t: product_count: search.products_count, count: search.all_products_count
                        }}
                      {%- endif -%}
                    </span>
                  </p>
                </div>
                {%- if section.settings.enable_sorting -%}
                  <div class="template-search__toolbar-sort">
                    <label class="template-search__toolbar-sort-label" for="SortBy">
                      {{ 'products.facets.sort_by_label' | t }}
                    </label>
                    <div class="select">
                      <select
                        name="sort_by"
                        class="facet-filters__sort select__select caption-large"
                        id="SortBy"
                        aria-describedby="a11y-refresh-page-message"
                      >
                        {%- for option in search.sort_options -%}
                          <option
                            value="{{ option.value | escape }}"
                            {% if option.value == sort_by %}
                              selected="selected"
                            {% endif %}
                          >
                            {{ option.name | escape }}
                          </option>
                        {%- endfor -%}
                      </select>
                      <span class="svg-wrapper">
                        {{- 'icon-caret.svg' | inline_asset_content -}}
                      </span>
                    </div>
                  </div>
                {%- endif -%}
                {%- render 'loading-spinner' -%}
              </form>
            </facet-filters-form>
          {%- endif -%}
          {%- if search.results.size == 0 and search.filters != empty -%}
            <div
              class="template-search__results collection collection--empty{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
              id="product-grid"
              data-id="{{ section.id }}"
            >
              <div class="loading-overlay gradient"></div>
              <div class="title-wrapper center">
                <h2 class="title title--primary">
                  {{ 'sections.collection_template.empty' | t -}}
                  <br>
                  {{
                    'sections.collection_template.use_fewer_filters_html'
                    | t: link: search_url, class: 'underlined-link link'
                  }}
                </h2>
              </div>
            </div>
          {%- else -%}
            <div
              class="template-search__results collection{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
              id="product-grid"
              data-id="{{ section.id }}"
            >
              <div class="loading-overlay gradient"></div>
              <ul
                class="grid product-grid  grid--{{ section.settings.columns_mobile }}-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop"
                role="list"
              >
                {%- for item in search.results -%}
                  {% assign lazy_load = false %}
                  {%- if forloop.index > 2 -%}
                    {%- assign lazy_load = true -%}
                  {%- endif -%}

                  <li
                    class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                    {% endif %}
                  >
                    {%- case item.object_type -%}
                      {%- when 'product' -%}
                        {% render 'bc-card-product-search',
                          card_product: item,
                          media_aspect_ratio: section.settings.image_ratio,
                          image_shape: section.settings.image_shape,
                          show_secondary_image: section.settings.show_secondary_image,
                          lazy_load: lazy_load
                        %}
                        {%- assign skip_card_product_styles = true -%}
                      {%- when 'article' -%}
                        {% render 'article-card',
                          article: item,
                          show_image: true,
                          show_date: section.settings.article_show_date,
                          show_author: section.settings.article_show_author,
                          show_badge: true,
                          media_aspect_ratio: 1,
                          lazy_load: lazy_load
                        %}
                      {%- when 'page' -%}
                        <div class="article-card-wrapper card-wrapper underline-links-hover">
                          <div
                            class="card card--card card--text ratio color-{{ settings.blog_card_color_scheme }}"
                            style="--ratio-percent: 100%;"
                          >
                            <div class="card__content">
                              <div class="card__information">
                                <h3 class="card__heading">
                                  <a href="{{ item.url }}" class="full-unstyled-link">
                                    {{ item.title | truncate: 50 | escape }}
                                  </a>
                                </h3>
                              </div>
                              <div class="card__badge {{ settings.badge_position }}">
                                <span class="badge color-{{ settings.color_schemes | first }}">
                                  {{- 'templates.search.page' | t -}}
                                </span>
                              </div>
                            </div>
                          </div>
                        </div>
                    {%- endcase -%}
                  </li>

                  {%- if forloop.index == 4 and search.results_count >= 5 -%}
                    <li class="grid__item template-search__grid-item--usp template-search__grid-item--usp-mobile">
                      {% render 'bc-search-usp-strip' %}
                    </li>
                  {%- endif -%}

                  {%- if forloop.index == 8 and search.results_count >= 9 -%}
                    <li class="grid__item template-search__grid-item--usp template-search__grid-item--usp-desktop">
                      {% render 'bc-search-usp-strip' %}
                    </li>
                  {%- endif -%}

                  {%- if forloop.index == 12 and search.results_count >= 13 -%}
                    <li class="grid__item template-search__grid-item--usp template-search__grid-item--usp-mobile">
                      {% render 'bc-search-usp-strip' %}
                    </li>
                  {%- endif -%}

                  {%- if forloop.index == 20 and search.results_count >= 21 -%}
                    <li class="grid__item template-search__grid-item--usp template-search__grid-item--usp-desktop">
                      {% render 'bc-search-usp-strip' %}
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
              {%- if paginate.pages > 1 -%}
                {% render 'pagination', paginate: paginate %}
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
{% endpaginate %}
{% if section.settings.image_shape == 'arch' %}
  {{ 'mask-arch.svg' | inline_asset_content }}
{%- endif -%}

