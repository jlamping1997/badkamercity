{%- liquid
  assign primary_link = section.settings.primary_button_link
  assign secondary_link = section.settings.secondary_button_link
  if primary_link == blank and pages['afspraak-maken'] != blank
    assign primary_link = pages['afspraak-maken'].url
  endif
  if secondary_link == blank and pages['contact'] != blank
    assign secondary_link = pages['contact'].url
  endif
  assign has_services = false
  for service_number in (1..3)
    assign service_setting = 'service_' | append: service_number | append: '_label'
    if section.settings[service_setting] != blank
      assign has_services = true
    endif
  endfor
-%}

{%- style -%}
  .home-help-cta-{{ section.id }} {
    --hhc-navy: #0f2740;
    --hhc-yellow: #f4cd45;
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    background: #ffffff;
  }

  .home-help-cta-{{ section.id }} .page-width {
    width: 100%;
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: 16px;
  }

  .home-help-cta-{{ section.id }} .home-help-cta__card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
    padding: 20px;
    border-radius: 8px;
    background: var(--hhc-navy);
    color: #ffffff;
  }

  .home-help-cta-{{ section.id }} .home-help-cta__intro {
    display: grid;
    gap: 8px;
    min-width: 0;
  }

  .home-help-cta-{{ section.id }} .home-help-cta__heading {
    margin: 0;
    color: #ffffff;
    font-size: clamp(2.4rem, 2.2vw, 2.8rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }

  .home-help-cta-{{ section.id }} .home-help-cta__text {
    margin: 0;
    color: #d7e6ee;
    font-size: 1.5rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .home-help-cta-{{ section.id }} .home-help-cta__actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .home-help-cta-{{ section.id }} .home-help-cta__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: 0;
    min-height: 48px;
    padding: 12px 16px;
    border: 1px solid transparent;
    border-radius: 8px;
    font-size: 1.4rem;
    font-weight: 600;
    line-height: 1.4;
    text-align: center;
    text-decoration: none;
  }

  .home-help-cta-{{ section.id }} .home-help-cta__button-label {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .home-help-cta-{{ section.id }} .home-help-cta__button-arrow {
    flex-shrink: 0;
  }

  .home-help-cta-{{ section.id }} .home-help-cta__button--primary {
    background: var(--hhc-yellow);
    color: var(--hhc-navy);
  }

  .home-help-cta-{{ section.id }} .home-help-cta__button--secondary {
    border-color: rgba(255, 255, 255, 0.6);
    background: transparent;
    color: #ffffff;
  }

  .home-help-cta-{{ section.id }} .home-help-cta__services {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home-help-cta-{{ section.id }} .home-help-cta__service {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    min-width: 0;
    text-align: center;
  }

  .home-help-cta-{{ section.id }} .home-help-cta__service-icon {
    display: block;
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    color: #8fd4ef;
  }

  .home-help-cta-{{ section.id }} .home-help-cta__service-label {
    max-width: 100%;
    color: #ffffff;
    font-size: 1.4rem;
    font-weight: 500;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .home-help-cta-{{ section.id }} a.home-help-cta__button:focus-visible {
    outline: 3px solid #8fd4ef;
    outline-offset: 4px;
  }

  @media screen and (min-width: 750px) {
    .home-help-cta-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .home-help-cta-{{ section.id }} .page-width {
      padding-inline: 24px;
    }

    .home-help-cta-{{ section.id }} .home-help-cta__card {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 24px;
      padding: 28px;
    }

    .home-help-cta-{{ section.id }} .home-help-cta__intro,
    .home-help-cta-{{ section.id }} .home-help-cta__actions {
      flex: 1 1 calc(50% - 12px);
    }

    .home-help-cta-{{ section.id }} .home-help-cta__services {
      flex: 1 1 100%;
      gap: 16px;
    }

    .home-help-cta-{{ section.id }} .home-help-cta__intro {
      gap: 10px;
    }

    .home-help-cta-{{ section.id }} .home-help-cta__actions {
      gap: 12px;
    }

    .home-help-cta-{{ section.id }} .home-help-cta__service {
      gap: 8px;
    }

    .home-help-cta-{{ section.id }} .home-help-cta__service-icon {
      width: 26px;
      height: 26px;
    }
  }

  @media screen and (min-width: 1100px) {
    .home-help-cta-{{ section.id }} .home-help-cta__card {
      flex-wrap: nowrap;
      min-height: 156px;
      padding: 28px 32px;
    }

    .home-help-cta-{{ section.id }} .home-help-cta__intro,
    .home-help-cta-{{ section.id }} .home-help-cta__services {
      flex: 1 1 0;
    }

    .home-help-cta-{{ section.id }} .home-help-cta__actions {
      flex: 1.2 1 0;
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
    }

    .home-help-cta-{{ section.id }} .home-help-cta__button {
      flex: 0 1 auto;
    }

    .home-help-cta-{{ section.id }} .home-help-cta__services {
      gap: 12px;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .home-help-cta-{{ section.id }} a.home-help-cta__button--primary:hover {
      background: #e9c039;
    }

    .home-help-cta-{{ section.id }} a.home-help-cta__button--secondary:hover {
      background: rgba(255, 255, 255, 0.08);
    }
  }
{%- endstyle -%}

{%- if section.settings.heading != blank or section.settings.text != blank or section.settings.primary_button_label != blank or section.settings.secondary_button_label != blank or has_services -%}
  <section class="home-help-cta home-help-cta-{{ section.id }}" {% if section.settings.heading != blank %}aria-labelledby="HelpCtaHeading-{{ section.id }}"{% endif %}>
    <div class="page-width">
      <div class="home-help-cta__card">
        {%- if section.settings.heading != blank or section.settings.text != blank -%}
          <div class="home-help-cta__intro">
            {%- if section.settings.heading != blank -%}
              <h2 class="home-help-cta__heading" id="HelpCtaHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
            {%- endif -%}
            {%- if section.settings.text != blank -%}
              <p class="home-help-cta__text">{{ section.settings.text | escape | newline_to_br }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.primary_button_label != blank or section.settings.secondary_button_label != blank -%}
          <div class="home-help-cta__actions">
            {%- for button_number in (1..2) -%}
              {%- liquid
                if button_number == 1
                  assign button_label = section.settings.primary_button_label
                  assign button_link = primary_link
                  assign button_style = 'primary'
                else
                  assign button_label = section.settings.secondary_button_label
                  assign button_link = secondary_link
                  assign button_style = 'secondary'
                endif
              -%}
              {%- if button_label != blank -%}
                {%- if button_link != blank -%}
                  <a class="home-help-cta__button home-help-cta__button--{{ button_style }}" href="{{ button_link | escape }}">
                {%- else -%}
                  <span class="home-help-cta__button home-help-cta__button--{{ button_style }}" aria-disabled="true">
                {%- endif -%}
                  <span class="home-help-cta__button-label">{{ button_label | escape }}</span>
                  {%- if button_number == 1 -%}
                    <span class="home-help-cta__button-arrow" aria-hidden="true">&rarr;</span>
                  {%- endif -%}
                {%- if button_link != blank -%}
                  </a>
                {%- else -%}
                  </span>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if has_services -%}
          <ul class="home-help-cta__services" role="list">
            {%- for service_number in (1..3) -%}
              {%- assign service_setting = 'service_' | append: service_number | append: '_label' -%}
              {%- if section.settings[service_setting] != blank -%}
                <li class="home-help-cta__service">
                  <svg class="home-help-cta__service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    {%- case service_number -%}
                      {%- when 1 -%}
                        <path d="M20 11.5a8 8 0 0 1-8 8H5l-3 3v-11a9 9 0 0 1 18 0Z"/>
                        <path d="M7 9h8M7 13h5"/>
                      {%- when 2 -%}
                        <path d="M3 12h18v3a5 5 0 0 1-5 5H8a5 5 0 0 1-5-5v-3ZM5 12V5a2 2 0 0 1 4 0v1M7 6h4M6 20v2M18 20v2"/>
                      {%- when 3 -%}
                        <path d="M4 20h16M6 17l1-4L17 3l4 4-10 10-5 1ZM14 6l4 4"/>
                    {%- endcase -%}
                  </svg>
                  <span class="home-help-cta__service-label">{{ section.settings[service_setting] | escape | newline_to_br }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Badkamer hulp CTA",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titel",
      "default": "Hulp nodig bij je badkamer?"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Tekst",
      "default": "Onze adviseurs staan voor je klaar.\nVan eerste idee tot complete realisatie."
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Primaire knoptekst",
      "default": "Plan een afspraak"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Primaire knoplink",
      "info": "Kies een bestaande afspraakpagina. Zonder instelling wordt de pagina afspraak-maken gebruikt, alleen als deze bestaat."
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secundaire knoptekst",
      "default": "Neem contact op"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secundaire knoplink",
      "info": "Kies een bestaande contactpagina. Zonder instelling wordt de pagina contact gebruikt, alleen als deze bestaat."
    },
    {
      "type": "header",
      "content": "Servicepunten"
    },
    {
      "type": "textarea",
      "id": "service_1_label",
      "label": "Servicepunt 1",
      "default": "Persoonlijk\nadvies"
    },
    {
      "type": "textarea",
      "id": "service_2_label",
      "label": "Servicepunt 2",
      "default": "Complete\nbadkamer"
    },
    {
      "type": "textarea",
      "id": "service_3_label",
      "label": "Servicepunt 3",
      "default": "Vrijblijvend\nontwerp"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Ruimte boven",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Ruimte onder",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Badkamer hulp CTA"
    }
  ]
}
{% endschema %}
