{%- style -%}
  .home-hero-{{ section.id }} {
    --hh-gap: 14px;
    --hh-text: #0f2740;
    --hh-accent: #f4cd45;
    --hh-focus: #f4cd45;
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  .home-hero-{{ section.id }} .page-width {
    width: 100%;
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: 16px;
  }

  .home-hero-{{ section.id }} .home-hero__shell,
  .home-hero-{{ section.id }} .home-hero__secondary {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--hh-gap);
    min-width: 0;
    min-height: 0;
  }

  .home-hero-{{ section.id }} .home-hero__hero,
  .home-hero-{{ section.id }} .home-hero__banner {
    position: relative;
    display: grid;
    align-items: end;
    min-width: 0;
    min-height: min-content;
    overflow: hidden;
    isolation: isolate;
    border-radius: 10px;
    background: #e9eef3;
    color: var(--hh-text);
  }

  .home-hero-{{ section.id }} .home-hero__hero {
    width: 100%;
  }

  .home-hero-{{ section.id }} .home-hero__hero::before,
  .home-hero-{{ section.id }} .home-hero__banner::before {
    content: '';
    grid-area: 1 / 1;
    pointer-events: none;
  }

  .home-hero-{{ section.id }} .home-hero__hero::before {
    aspect-ratio: var(--hh-hero-ratio, 1.9);
  }

  .home-hero-{{ section.id }} .home-hero__banner::before {
    aspect-ratio: var(--hh-banner-ratio, 2);
  }

  .home-hero-{{ section.id }} .home-hero__media {
    position: absolute;
    inset: 0;
  }

  .home-hero-{{ section.id }} .home-hero__media img,
  .home-hero-{{ section.id }} .home-hero__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .home-hero-{{ section.id }} .home-hero__media .placeholder-svg {
    background: linear-gradient(135deg, #edf3f7, #d8e5ee);
    color: rgba(15, 39, 64, 0.18);
  }

  .home-hero-{{ section.id }} .home-hero__hero--has-copy .home-hero__media::after,
  .home-hero-{{ section.id }} .home-hero__banner--has-copy .home-hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(15, 39, 64, 0.62), rgba(15, 39, 64, 0) 85%);
    pointer-events: none;
  }

  .home-hero-{{ section.id }} .home-hero__card-link {
    position: absolute;
    display: block;
    inset: 0;
    z-index: 3;
    border-radius: inherit;
  }

  .home-hero-{{ section.id }} .home-hero__card-link:focus-visible {
    outline: 3px solid var(--hh-focus);
    outline-offset: -5px;
    box-shadow: inset 0 0 0 6px var(--hh-text);
  }

  .home-hero-{{ section.id }} .home-hero__content {
    position: relative;
    z-index: 1;
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: clamp(16px, 2.5vw, 32px);
    min-width: 0;
    pointer-events: none;
  }

  .home-hero-{{ section.id }} .home-hero__content-inner {
    display: grid;
    gap: 10px;
    max-width: 54rem;
    min-width: 0;
    color: #ffffff;
  }

  .home-hero-{{ section.id }} .home-hero__banner .home-hero__content-inner {
    max-width: 36rem;
  }

  .home-hero-{{ section.id }} .home-hero__title {
    margin: 0;
    color: #ffffff;
    font-size: clamp(2.8rem, 3.8vw, 5.2rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.025em;
    overflow-wrap: anywhere;
  }

  .home-hero-{{ section.id }} .home-hero__banner .home-hero__title {
    font-size: clamp(2rem, 2.1vw, 3rem);
    line-height: 1.12;
  }

  .home-hero-{{ section.id }} .home-hero__subtitle {
    margin: 0;
    max-width: 48rem;
    color: #ffffff;
    font-size: 1.5rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .home-hero-{{ section.id }} .home-hero__banner .home-hero__subtitle {
    font-size: 1.4rem;
  }

  .home-hero-{{ section.id }} .home-hero__actions {
    display: flex;
    min-width: 0;
  }

  .home-hero-{{ section.id }} .home-hero__actions--left {
    justify-content: flex-start;
  }

  .home-hero-{{ section.id }} .home-hero__actions--center {
    justify-content: center;
  }

  .home-hero-{{ section.id }} .home-hero__actions--right {
    justify-content: flex-end;
  }

  .home-hero-{{ section.id }} .home-hero__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    max-width: 100%;
    min-height: 48px;
    padding: 10px 20px;
    border-radius: 8px;
    background: var(--hh-accent);
    color: var(--hh-text);
    font-size: 1.4rem;
    font-weight: 600;
    line-height: 1.25;
    text-align: center;
    overflow-wrap: anywhere;
  }

  .home-hero-{{ section.id }} .home-hero__button[aria-disabled='true'] {
    opacity: 0.72;
  }

  .home-hero-{{ section.id }} .home-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .home-hero-{{ section.id }} .home-hero__title--free,
  .home-hero-{{ section.id }} .home-hero__subtitle--free,
  .home-hero-{{ section.id }} .home-hero__actions--free {
    position: absolute;
    margin: 0;
    left: calc(16px + (100% - 32px) * var(--hh-x));
    top: calc(16px + (100% - 32px) * var(--hh-y));
    transform: translate(calc(-100% * var(--hh-x)), calc(-100% * var(--hh-y)));
    width: max-content;
    max-width: calc(100% - 32px);
  }

  .home-hero-{{ section.id }} .home-hero__title--free {
    --hh-x: {{ section.settings.hero_title_mobile_x | divided_by: 100.0 }};
    --hh-y: {{ section.settings.hero_title_mobile_y | divided_by: 100.0 }};
    max-width: min(calc(100% - 32px), 54rem);
  }

  .home-hero-{{ section.id }} .home-hero__subtitle--free {
    --hh-x: {{ section.settings.hero_subtitle_mobile_x | divided_by: 100.0 }};
    --hh-y: {{ section.settings.hero_subtitle_mobile_y | divided_by: 100.0 }};
    max-width: min(calc(100% - 32px), 48rem);
  }

  .home-hero-{{ section.id }} .home-hero__actions--free {
    --hh-x: {{ section.settings.hero_button_mobile_x | divided_by: 100.0 }};
    --hh-y: {{ section.settings.hero_button_mobile_y | divided_by: 100.0 }};
  }

  @media screen and (min-width: 750px) {
    .home-hero-{{ section.id }} {
      --hh-gap: 16px;
      padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
    }

    .home-hero-{{ section.id }} .page-width {
      padding-inline: 24px;
    }

    .home-hero-{{ section.id }} .home-hero__hero::before {
      aspect-ratio: 2.4;
    }

    .home-hero-{{ section.id }} .home-hero__secondary {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
  }

  @media screen and (min-width: 990px) {
    .home-hero-{{ section.id }} .home-hero__shell {
      grid-template-columns: minmax(0, 13fr) minmax(0, 7fr);
      align-items: stretch;
    }

    .home-hero-{{ section.id }} .home-hero__secondary {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: repeat(2, minmax(0, 1fr));
      align-items: stretch;
    }

    .home-hero-{{ section.id }} .home-hero__banner::before {
      display: none;
    }

    .home-hero-{{ section.id }} .home-hero__banner .home-hero__media {
      object-position: center top;
    }

    .home-hero-{{ section.id }} .home-hero__title--free {
      --hh-x: {{ section.settings.hero_title_desktop_x | divided_by: 100.0 }};
      --hh-y: {{ section.settings.hero_title_desktop_y | divided_by: 100.0 }};
    }

    .home-hero-{{ section.id }} .home-hero__subtitle--free {
      --hh-x: {{ section.settings.hero_subtitle_desktop_x | divided_by: 100.0 }};
      --hh-y: {{ section.settings.hero_subtitle_desktop_y | divided_by: 100.0 }};
    }

    .home-hero-{{ section.id }} .home-hero__actions--free {
      --hh-x: {{ section.settings.hero_button_desktop_x | divided_by: 100.0 }};
      --hh-y: {{ section.settings.hero_button_desktop_y | divided_by: 100.0 }};
    }
  }
{%- endstyle -%}

{%- liquid
  assign hero_fetch_priority = 'auto'
  if section.index == 1
    assign hero_fetch_priority = 'high'
  endif
  assign hero_link_label = section.settings.hero_button_text | default: section.settings.hero_title | default: section.settings.hero_image.alt | default: 'BadkamerCity aanbiedingen'
  assign hero_image_alt = section.settings.hero_image.alt | default: section.settings.hero_title | default: 'BadkamerCity aanbiedingen'
  assign hero_has_inline_content = false
  assign hero_has_inline_copy = false
  assign hero_has_free_content = false
  if section.settings.hero_title != blank
    if section.settings.hero_title_position_mode == 'free'
      assign hero_has_free_content = true
    else
      assign hero_has_inline_content = true
      assign hero_has_inline_copy = true
    endif
  endif
  if section.settings.hero_subtitle != blank
    if section.settings.hero_subtitle_position_mode == 'free'
      assign hero_has_free_content = true
    else
      assign hero_has_inline_content = true
      assign hero_has_inline_copy = true
    endif
  endif
  if section.settings.hero_button_text != blank
    if section.settings.hero_button_position_mode == 'free'
      assign hero_has_free_content = true
    else
      assign hero_has_inline_content = true
    endif
  endif
-%}

<section class="home-hero home-hero-{{ section.id }} section-{{ section.id }}-padding" style="--hh-hero-ratio: {{ section.settings.hero_image.aspect_ratio | default: 1.9 }};">
  <div class="page-width">
    <div class="home-hero__shell">
      <article class="home-hero__hero{% if section.settings.hero_title != blank or section.settings.hero_subtitle != blank %} home-hero__hero--has-copy{% endif %}">
        <div class="home-hero__media">
          {%- if section.settings.hero_image != blank -%}
            {{
              section.settings.hero_image
              | image_url: width: 2200
              | image_tag:
                widths: '320, 480, 640, 750, 1100, 1500, 1780, 2200',
                sizes: '(min-width: 1440px) 895px, (min-width: 990px) calc(65vw - 42px), (min-width: 750px) calc(100vw - 48px), calc(100vw - 32px)',
                loading: 'eager',
                fetchpriority: hero_fetch_priority,
                alt: hero_image_alt
            }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>

        {%- if section.settings.hero_button_link != blank -%}
          <a href="{{ section.settings.hero_button_link | escape }}" class="home-hero__card-link" aria-label="{{ hero_link_label | escape }}"></a>
        {%- endif -%}

        {%- if hero_has_inline_content -%}
          <div class="home-hero__content">
            {%- if hero_has_inline_copy -%}
              <div class="home-hero__content-inner">
                {%- if section.settings.hero_title != blank and section.settings.hero_title_position_mode != 'free' -%}
                  <h2 class="home-hero__title" style="color: {{ section.settings.hero_title_color }};">
                    {{ section.settings.hero_title | escape }}
                  </h2>
                {%- endif -%}
                {%- if section.settings.hero_subtitle != blank and section.settings.hero_subtitle_position_mode != 'free' -%}
                  <p class="home-hero__subtitle" style="color: {{ section.settings.hero_subtitle_color }};">
                    {{ section.settings.hero_subtitle | escape }}
                  </p>
                {%- endif -%}
              </div>
            {%- endif -%}
            {%- if section.settings.hero_button_text != blank and section.settings.hero_button_position_mode != 'free' -%}
              <div class="home-hero__actions home-hero__actions--{{ section.settings.hero_button_alignment }}">
                <span
                  {% if section.settings.hero_button_link == blank %}role="link" aria-disabled="true"{% endif %}
                  class="home-hero__button"
                  style="background: {{ section.settings.hero_button_background_color }}; color: {{ section.settings.hero_button_text_color }};"
                >
                  {{ section.settings.hero_button_text | escape }}
                </span>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if hero_has_free_content -%}
          <div class="home-hero__overlay">
            {%- if section.settings.hero_title != blank and section.settings.hero_title_position_mode == 'free' -%}
              <h2 class="home-hero__title home-hero__title--free" style="color: {{ section.settings.hero_title_color }};">
                {{ section.settings.hero_title | escape }}
              </h2>
            {%- endif -%}
            {%- if section.settings.hero_subtitle != blank and section.settings.hero_subtitle_position_mode == 'free' -%}
              <p class="home-hero__subtitle home-hero__subtitle--free" style="color: {{ section.settings.hero_subtitle_color }};">
                {{ section.settings.hero_subtitle | escape }}
              </p>
            {%- endif -%}
            {%- if section.settings.hero_button_text != blank and section.settings.hero_button_position_mode == 'free' -%}
              <div class="home-hero__actions home-hero__actions--free">
                <span
                  {% if section.settings.hero_button_link == blank %}role="link" aria-disabled="true"{% endif %}
                  class="home-hero__button"
                  style="background: {{ section.settings.hero_button_background_color }}; color: {{ section.settings.hero_button_text_color }};"
                >
                  {{ section.settings.hero_button_text | escape }}
                </span>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </article>

      <div class="home-hero__secondary">
        {%- for index in (1..2) -%}
          {%- liquid
            assign title_key = 'banner_' | append: index | append: '_title'
            assign subtitle_key = 'banner_' | append: index | append: '_subtitle'
            assign button_key = 'banner_' | append: index | append: '_button'
            assign link_key = 'banner_' | append: index | append: '_link'
            assign image_key = 'banner_' | append: index | append: '_image'
            assign title_color_key = 'banner_' | append: index | append: '_title_color'
            assign subtitle_color_key = 'banner_' | append: index | append: '_subtitle_color'
            assign button_text_color_key = 'banner_' | append: index | append: '_button_text_color'
            assign button_background_color_key = 'banner_' | append: index | append: '_button_background_color'
            assign button_alignment_key = 'banner_' | append: index | append: '_button_alignment'
            assign banner_title = section.settings[title_key]
            assign banner_subtitle = section.settings[subtitle_key]
            assign banner_button = section.settings[button_key]
            assign banner_link = section.settings[link_key]
            assign banner_image = section.settings[image_key]
            assign banner_focal_x = banner_image.presentation.focal_point.x | default: 50
            assign banner_focal_y = banner_image.presentation.focal_point.y | default: 50
            assign banner_title_color = section.settings[title_color_key]
            assign banner_subtitle_color = section.settings[subtitle_color_key]
            assign banner_button_text_color = section.settings[button_text_color_key]
            assign banner_button_background_color = section.settings[button_background_color_key]
            assign banner_button_alignment = section.settings[button_alignment_key]
            assign banner_default_alt = 'Persoonlijk badkameradvies'
            if index == 2
              assign banner_default_alt = 'Badkamerinspiratie voor elke stijl'
            endif
            assign banner_image_alt = banner_image.alt | default: banner_title | default: banner_default_alt
            assign banner_link_label = banner_button | default: banner_title | default: banner_image_alt
          -%}
          <article class="home-hero__banner{% if banner_title != blank or banner_subtitle != blank %} home-hero__banner--has-copy{% endif %}" style="--hh-banner-ratio: {{ banner_image.aspect_ratio | default: 2 }};">
            <div class="home-hero__media"{% if banner_focal_x != 50 or banner_focal_y != 50 %} style="object-position: {{ banner_focal_x }}% {{ banner_focal_y }}%;"{% endif %}>
              {%- if banner_image != blank -%}
                {{
                  banner_image
                  | image_url: width: 1400
                  | image_tag:
                    widths: '320, 480, 550, 750, 990, 1200, 1400',
                    sizes: '(min-width: 1440px) 482px, (min-width: 990px) calc(35vw - 22px), (min-width: 750px) calc(50vw - 32px), calc(100vw - 32px)',
                    loading: 'lazy',
                    style: 'object-position: inherit;',
                    alt: banner_image_alt
                }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>

            {%- if banner_link != blank -%}
              <a href="{{ banner_link | escape }}" class="home-hero__card-link" aria-label="{{ banner_link_label | escape }}"></a>
            {%- endif -%}

            {%- if banner_title != blank or banner_subtitle != blank or banner_button != blank -%}
              <div class="home-hero__content">
                <div class="home-hero__content-inner">
                  {%- if banner_title != blank -%}
                    <h3 class="home-hero__title" style="color: {{ banner_title_color }};">
                      {{ banner_title | escape }}
                    </h3>
                  {%- endif -%}
                  {%- if banner_subtitle != blank -%}
                    <p class="home-hero__subtitle" style="color: {{ banner_subtitle_color }};">
                      {{ banner_subtitle | escape }}
                    </p>
                  {%- endif -%}
                  {%- if banner_button != blank -%}
                    <div class="home-hero__actions home-hero__actions--{{ banner_button_alignment }}">
                      <span
                        {% if banner_link == blank %}role="link" aria-disabled="true"{% endif %}
                        class="home-hero__button"
                        style="background: {{ banner_button_background_color }}; color: {{ banner_button_text_color }};"
                      >
                        {{ banner_button | escape }}
                      </span>
                    </div>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home Hero",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero title",
      "default": "Jouw badkamer begint hier"
    },
    {
      "type": "text",
      "id": "hero_subtitle",
      "label": "Hero subtitle",
      "default": "Ontdek ons assortiment, laat je inspireren en stel moeiteloos jouw ideale badkamer samen."
    },
    {
      "type": "text",
      "id": "hero_button_text",
      "label": "Hero button text",
      "default": "Bekijk assortiment"
    },
    {
      "type": "url",
      "id": "hero_button_link",
      "label": "Hero button link"
    },
    {
      "type": "color",
      "id": "hero_title_color",
      "label": "Hero title color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "hero_subtitle_color",
      "label": "Hero subtitle color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "hero_title_position_mode",
      "label": "Hero title placement mode",
      "default": "inline",
      "options": [
        {
          "value": "inline",
          "label": "Inline"
        },
        {
          "value": "free",
          "label": "Free position"
        }
      ]
    },
    {
      "type": "range",
      "id": "hero_title_mobile_x",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Hero title mobile horizontal position",
      "default": 5
    },
    {
      "type": "range",
      "id": "hero_title_mobile_y",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Hero title mobile vertical position",
      "default": 52
    },
    {
      "type": "range",
      "id": "hero_title_desktop_x",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Hero title desktop horizontal position",
      "default": 6
    },
    {
      "type": "range",
      "id": "hero_title_desktop_y",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Hero title desktop vertical position",
      "default": 56
    },
    {
      "type": "select",
      "id": "hero_subtitle_position_mode",
      "label": "Hero subtitle placement mode",
      "default": "inline",
      "options": [
        {
          "value": "inline",
          "label": "Inline"
        },
        {
          "value": "free",
          "label": "Free position"
        }
      ]
    },
    {
      "type": "range",
      "id": "hero_subtitle_mobile_x",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Hero subtitle mobile horizontal position",
      "default": 5
    },
    {
      "type": "range",
      "id": "hero_subtitle_mobile_y",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Hero subtitle mobile vertical position",
      "default": 70
    },
    {
      "type": "range",
      "id": "hero_subtitle_desktop_x",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Hero subtitle desktop horizontal position",
      "default": 6
    },
    {
      "type": "range",
      "id": "hero_subtitle_desktop_y",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Hero subtitle desktop vertical position",
      "default": 72
    },
    {
      "type": "color",
      "id": "hero_button_text_color",
      "label": "Hero button text color",
      "default": "#0f2740"
    },
    {
      "type": "color",
      "id": "hero_button_background_color",
      "label": "Hero button background color",
      "default": "#f4cd45"
    },
    {
      "type": "select",
      "id": "hero_button_alignment",
      "label": "Hero button position",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "hero_button_position_mode",
      "label": "Hero button placement mode",
      "default": "inline",
      "options": [
        {
          "value": "inline",
          "label": "Inline"
        },
