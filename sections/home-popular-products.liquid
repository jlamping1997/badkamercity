{%- liquid
  assign popular_collection = section.settings.collection
  assign product_limit = section.settings.product_count | default: 4
  assign view_all_link = section.settings.view_all_link | default: popular_collection.url
  assign section_heading = section.settings.heading | default: 'Populair op dit moment'
  assign add_to_cart_label = section.settings.add_to_cart_label | default: 'In winkelwagen'
-%}

{%- if popular_collection != blank and popular_collection.products_count > 0 -%}
  {%- style -%}
    .home-popular-products-{{ section.id }} {
      --hpp-text: #0f2740;
      --hpp-blue: #176b9b;
      --hpp-gap: 12px;
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
      background: #ffffff;
      color: var(--hpp-text);
    }

    .home-popular-products-{{ section.id }} .page-width {
      width: 100%;
      max-width: 1440px;
      margin-inline: auto;
      padding-inline: 16px;
    }

    .home-popular-products-{{ section.id }} .home-popular-products__header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 8px 24px;
      margin-bottom: 16px;
    }

    .home-popular-products-{{ section.id }} .home-popular-products__heading {
      min-width: 0;
      margin: 0;
      color: var(--hpp-text);
      font-size: clamp(2.4rem, 2.5vw, 3.2rem);
      font-weight: 700;
      line-height: 1.2;
      letter-spacing: -0.02em;
      overflow-wrap: anywhere;
    }

    .home-popular-products-{{ section.id }} .home-popular-products__view-all {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 44px;
      max-width: 100%;
      color: var(--hpp-text);
      font-size: 1.4rem;
      font-weight: 600;
      line-height: 1.4;
      text-decoration: none;
      text-underline-offset: 4px;
      overflow-wrap: anywhere;
    }

    .home-popular-products-{{ section.id }} .home-popular-products__rail {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: min(82%, 320px);
      gap: var(--hpp-gap);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x proximity;
      scroll-padding-inline: 4px;
      scrollbar-width: thin;
      scrollbar-color: #a5b9c7 #eef3f6;
      padding: 4px 4px 12px;
      margin: 0 -4px;
      list-style: none;
    }

    .home-popular-products-{{ section.id }} .home-popular-products__item {
      min-width: 0;
      scroll-snap-align: start;
    }

    .home-popular-products-{{ section.id }} .home-popular-products__card {
      position: relative;
      display: flex;
      flex-direction: column;
      height: 100%;
      min-width: 0;
      border: 1px solid rgba(15, 39, 64, 0.12);
      border-radius: 8px;
      background: #ffffff;
      box-shadow: 0 2px 6px rgba(15, 39, 64, 0.025);
    }

    .home-popular-products-{{ section.id }} .home-popular-products__product-link {
      display: flex;
      flex: 1 0 auto;
      flex-direction: column;
      min-width: 0;
      border-radius: 8px;
      color: inherit;
      text-decoration: none;
    }

    .home-popular-products-{{ section.id }} .home-popular-products__media {
      position: relative;
      aspect-ratio: 1;
      overflow: hidden;
    }

    .home-popular-products-{{ section.id }} .home-popular-products__image {
      position: absolute;
      inset: 20px;
      display: block;
      width: calc(100% - 40px);
      height: calc(100% - 40px);
      object-fit: contain;
      object-position: center;
    }

    .home-popular-products-{{ section.id }} .home-popular-products__image-placeholder {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #a5b9c7;
    }

    .home-popular-products-{{ section.id }} .home-popular-products__image-placeholder svg {
      width: 60px;
      height: 60px;
    }

    .home-popular-products-{{ section.id }} .home-popular-products__discount {
      position: absolute;
      top: 12px;
      left: 12px;
      z-index: 1;
      padding: 5px 9px;
      border-radius: 4px;
      background: #f4cd45;
      color: var(--hpp-text);
      font-size: 1.3rem;
      font-weight: 700;
      line-height: 1.3;
    }

    .home-popular-products-{{ section.id }} .home-popular-products__info {
      display: flex;
      flex: 1 0 auto;
      flex-direction: column;
      gap: 6px;
      min-width: 0;
      padding: 0 16px;
    }

    .home-popular-products-{{ section.id }} .home-popular-products__vendor {
      margin: 0;
      color: #667482;
      font-size: 1.2rem;
      line-height: 1.4;
      overflow-wrap: anywhere;
    }

    .home-popular-products-{{ section.id }} .home-popular-products__title {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      min-height: 2.75em;
      margin: 0;
      overflow: hidden;
      color: var(--hpp-text);
      font-size: 1.6rem;
      font-weight: 600;
      line-height: 1.375;
      overflow-wrap: anywhere;
    }

    .home-popular-products-{{ section.id }} .home-popular-products__prices {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 4px 8px;
      margin-top: auto;
      padding-top: 8px;
    }

    .home-popular-products-{{ section.id }} .home-popular-products__price {
      color: var(--hpp-text);
      font-size: 2.2rem;
      font-weight: 700;
      line-height: 1.2;
      overflow-wrap: anywhere;
    }

    .home-popular-products-{{ section.id }} .home-popular-products__compare {
      color: #667482;
      font-size: 1.3rem;
      line-height: 1.4;
      overflow-wrap: anywhere;
    }

    .home-popular-products-{{ section.id }} .home-popular-products__unit-price {
      width: 100%;
      color: #667482;
      font-size: 1.2rem;
      line-height: 1.4;
    }

    .home-popular-products-{{ section.id }} .home-popular-products__actions {
      padding: 16px;
    }

    .home-popular-products-{{ section.id }} product-form {
      display: block;
    }

    .home-popular-products-{{ section.id }} .home-popular-products__button {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      min-width: 0;
      min-height: 48px;
      padding: 12px;
      border: 0;
      border-radius: 8px;
      background: var(--hpp-blue);
      color: #ffffff;
      box-shadow: none;
      font: inherit;
      font-size: 1.4rem;
      font-weight: 600;
      line-height: 1.3;
      letter-spacing: 0;
      text-align: center;
      text-decoration: none;
      cursor: pointer;
    }

    .home-popular-products-{{ section.id }} .home-popular-products__button::before,
    .home-popular-products-{{ section.id }} .home-popular-products__button::after {
      box-shadow: none;
    }

    .home-popular-products-{{ section.id }} .home-popular-products__button-content {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 0;
      max-width: 100%;
      gap: 8px;
      overflow-wrap: anywhere;
    }

    .home-popular-products-{{ section.id }} .home-popular-products__button-content svg {
      flex: 0 0 auto;
      width: 20px;
      height: 20px;
    }

    .home-popular-products-{{ section.id }} .home-popular-products__button[disabled] {
      opacity: 0.55;
      cursor: not-allowed;
    }

    .home-popular-products-{{ section.id }} .home-popular-products__button[aria-disabled='true'] {
      cursor: not-allowed;
    }

    .home-popular-products-{{ section.id }} .home-popular-products__button.loading[aria-disabled='true'] {
      cursor: wait;
    }

    .home-popular-products-{{ section.id }} .home-popular-products__button.loading > .home-popular-products__button-content {
      opacity: 0;
    }

    .home-popular-products-{{ section.id }} .home-popular-products__button .loading__spinner {
      color: #ffffff;
    }

    .home-popular-products-{{ section.id }} .home-popular-products__button .loading__spinner .path {
      stroke: currentColor;
    }

    .home-popular-products-{{ section.id }} .product-form__error-message-wrapper {
      margin-bottom: 8px;
      color: #a32121;
      font-size: 1.3rem;
      line-height: 1.4;
      overflow-wrap: anywhere;
    }

    .home-popular-products-{{ section.id }} .product-form__error-message-wrapper[hidden] {
      display: none;
    }

    .home-popular-products-{{ section.id }} .home-popular-products__view-all:focus-visible,
    .home-popular-products-{{ section.id }} .home-popular-products__product-link:focus-visible,
    .home-popular-products-{{ section.id }} .home-popular-products__button:focus-visible,
    .home-popular-products-{{ section.id }} .home-popular-products__rail:focus-visible {
      outline: 3px solid #1f6685;
      outline-offset: 2px;
    }

    @media screen and (min-width: 750px) {
      .home-popular-products-{{ section.id }} {
        --hpp-gap: 16px;
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }

      .home-popular-products-{{ section.id }} .page-width {
        padding-inline: 24px;
      }

      .home-popular-products-{{ section.id }} .home-popular-products__header {
        margin-bottom: 20px;
      }

      .home-popular-products-{{ section.id }} .home-popular-products__rail {
        grid-auto-columns: calc((100% - 2 * var(--hpp-gap)) / 3);
      }
    }

    @media screen and (min-width: 990px) {
      .home-popular-products-{{ section.id }} .home-popular-products__rail {
        grid-auto-columns: calc((100% - 3 * var(--hpp-gap)) / 4);
      }
    }

    @media (hover: hover) and (pointer: fine) {
      .home-popular-products-{{ section.id }} .home-popular-products__view-all:hover {
        text-decoration: underline;
      }

      .home-popular-products-{{ section.id }} .home-popular-products__button:not([disabled]):not([aria-disabled='true']):hover {
        background: #155978;
      }
    }
  {%- endstyle -%}

  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

  <section class="home-popular-products home-popular-products-{{ section.id }}" aria-labelledby="PopularHeading-{{ section.id }}">
    <div class="page-width">
      <div class="home-popular-products__header">
        <h2 class="home-popular-products__heading" id="PopularHeading-{{ section.id }}">{{ section_heading | escape }}</h2>
        {%- if section.settings.view_all_label != blank -%}
          <a href="{{ view_all_link | escape }}" class="home-popular-products__view-all">
            {{ section.settings.view_all_label | escape }} <span aria-hidden="true">&rarr;</span>
          </a>
        {%- endif -%}
      </div>

      <ul class="home-popular-products__rail" role="list" tabindex="0" aria-labelledby="PopularHeading-{{ section.id }}">
        {%- for popular_product in popular_collection.products limit: product_limit -%}
          {%- liquid
            assign card_variant = popular_product.selected_or_first_available_variant
            assign card_price = card_variant.price | default: popular_product.price
            assign compare_price = card_variant.compare_at_price
            assign is_on_sale = false
            assign discount_percentage = 0
            if compare_price > card_price and compare_price > 0
              assign is_on_sale = true
              assign discount_percentage = compare_price | minus: card_price | times: 100.0 | divided_by: compare_price | round
            endif
            assign card_image = card_variant.featured_image | default: popular_product.featured_image
            assign product_link = card_variant.url | default: popular_product.url
            assign product_form_id = 'PopularProductForm-' | append: section.id | append: '-' | append: popular_product.id
            assign product_title_id = 'PopularProductTitle-' | append: section.id | append: '-' | append: popular_product.id
            assign requires_options = false
            if popular_product.variants.size > 1 or popular_product.requires_selling_plan
              assign requires_options = true
            endif
            if card_variant.quantity_rule.min > 1 or card_variant.quantity_rule.increment > 1 or card_variant.quantity_rule.max != null
              assign requires_options = true
            endif
          -%}

          <li class="home-popular-products__item">
            <article class="home-popular-products__card">
              <a href="{{ product_link | escape }}" class="home-popular-products__product-link" aria-labelledby="{{ product_title_id }}">
                <div class="home-popular-products__media">
                  {%- if card_image != blank -%}
                    {{ card_image | image_url: width: 750 | image_tag:
                      widths: '180, 300, 450, 600, 750',
                      sizes: '(min-width: 1440px) 296px, (min-width: 990px) calc(25vw - 64px), (min-width: 750px) calc(33.33vw - 67px), min(280px, calc(82vw - 66px))',
                      class: 'home-popular-products__image',
                      loading: 'lazy',
                      alt: ''
                    }}
                  {%- else -%}
                    <span class="home-popular-products__image-placeholder" aria-hidden="true">{{ 'icon-box.svg' | inline_asset_content }}</span>
                  {%- endif -%}
                  {%- if is_on_sale and discount_percentage > 0 -%}
                    <span class="home-popular-products__discount"><span class="visually-hidden">{{ 'products.product.on_sale' | t }}: </span>-{{ discount_percentage }}%</span>
                  {%- endif -%}
                </div>

                <div class="home-popular-products__info">
                  {%- if popular_product.vendor != blank -%}
                    <p class="home-popular-products__vendor">{{ popular_product.vendor | escape }}</p>
                  {%- endif -%}
                  <h3 class="home-popular-products__title" id="{{ product_title_id }}">{{ popular_product.title | escape }}</h3>
                  <div class="home-popular-products__prices">
                    <span class="visually-hidden">{% if is_on_sale %}{{ 'products.product.price.sale_price' | t }}{% else %}{{ 'products.product.price.regular_price' | t }}{% endif %}</span>
                    <span class="home-popular-products__price">{% if settings.currency_code_enabled %}{{ card_price | money_with_currency }}{% else %}{{ card_price | money }}{% endif %}</span>
                    {%- if is_on_sale -%}
                      <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
                      <s class="home-popular-products__compare">{% if settings.currency_code_enabled %}{{ compare_price | money_with_currency }}{% else %}{{ compare_price | money }}{% endif %}</s>
                    {%- endif -%}
                    {%- if card_variant.unit_price_measurement -%}
                      <div class="home-popular-products__unit-price">{% render 'unit-price', price: card_variant.unit_price, measurement: card_variant.unit_price_measurement %}</div>
                    {%- endif -%}
                  </div>
                </div>
              </a>

              <div class="home-popular-products__actions">
                {%- if card_variant == nil or card_variant.available == false -%}
                  <button class="home-popular-products__button button" type="button" disabled>{{ 'products.product.sold_out' | t }}</button>
                {%- elsif requires_options -%}
                  <a href="{{ product_link | escape }}" class="home-popular-products__button button" aria-describedby="{{ product_title_id }}">{{ 'products.product.choose_options' | t }}</a>
                {%- else -%}
                  <product-form data-section-id="{{ section.id }}">
                    <div class="product-form__error-message-wrapper" role="alert" hidden><span class="product-form__error-message"></span></div>
                    {%- form 'product', popular_product, id: product_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                      <input type="hidden" name="id" value="{{ card_variant.id }}" class="product-variant-id">
                      <input type="hidden" name="quantity" value="1">
                      <button
                        id="{{ product_form_id }}-submit"
                        type="submit"
                        name="add"
                        class="home-popular-products__button button"
                        aria-describedby="{{ product_title_id }}"
                        aria-live="polite"
                      >
                        <span class="home-popular-products__button-content" data-submit-content>
                          <span aria-hidden="true">{{ 'icon-cart-bc.svg' | inline_asset_content }}</span>
                          {{ add_to_cart_label | escape }}
                        </span>
                        <span class="sold-out-message hidden">{{ 'products.product.sold_out' | t }}</span>
                        {%- render 'loading-spinner' -%}
                      </button>
                    {%- endform -%}
                  </product-form>
                {%- endif -%}
              </div>
            </article>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Home popular products",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titel",
      "default": "Populair op dit moment"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collectie",
      "info": "Selecteer de collectie met populaire producten. Zonder producten blijft de sectie verborgen."
    },
    {
      "type": "range",
      "id": "product_count",
      "min": 1,
      "max": 12,
      "step": 1,
      "label": "Aantal producten",
      "default": 4
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Bekijk alle-label",
      "default": "Bekijk alle producten"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "Bekijk alle-link",
      "info": "Leeg laten om de geselecteerde collectie te openen."
    },
    {
      "type": "text",
      "id": "add_to_cart_label",
      "label": "Tekst winkelwagenknop",
      "default": "In winkelwagen"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Ruimte boven",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Ruimte onder",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Home popular products"
    }
  ]
}
{% endschema %}
