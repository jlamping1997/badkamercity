{% liquid
  assign trust_icons = 'grid,headset,sparkles,shield' | split: ','
  assign social_names = 'facebook,instagram,pinterest,youtube,linkedin' | split: ','
  assign groups = 'service,category' | split: ','
  assign payment_types = shop.enabled_payment_types
  if section.settings.payment_examples
    assign payment_types = 'ideal,visa,master,paypal,klarna' | split: ','
  endif
%}
<footer class="bcf-v2" id="bcf-{{ section.id }}" aria-label="{{ section.settings.footer_label | escape }}">
<svg class="bcf-sprite" width="0" height="0" aria-hidden="true" hidden><defs>
<symbol id="bcf-grid-{{ section.id }}" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></symbol>
<symbol id="bcf-headset-{{ section.id }}" viewBox="0 0 24 24"><path d="M4 14v-3a8 8 0 0 1 16 0v3"/><rect x="2" y="12" width="4" height="7" rx="2"/><rect x="18" y="12" width="4" height="7" rx="2"/><path d="M18 19c0 2-2 3-6 3"/></symbol>
<symbol id="bcf-sparkles-{{ section.id }}" viewBox="0 0 24 24"><path d="m12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5L12 3ZM20 2v4M18 4h4"/></symbol>
<symbol id="bcf-shield-{{ section.id }}" viewBox="0 0 24 24"><path d="M12 2 3 6v6c0 5 9 10 9 10s9-5 9-10V6l-9-4Z"/><path d="m8 12 3 3 5-6"/></symbol>
<symbol id="bcf-pin-{{ section.id }}" viewBox="0 0 24 24"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></symbol>
<symbol id="bcf-phone-{{ section.id }}" viewBox="0 0 24 24"><path d="m7 3 3 5-3 3a16 16 0 0 0 6 6l3-3 5 3-1 4C10 23 1 14 3 4l4-1Z"/></symbol>
<symbol id="bcf-mail-{{ section.id }}" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></symbol>
<symbol id="bcf-arrow-{{ section.id }}" viewBox="0 0 24 24"><path d="M4 12h15m-5-5 5 5-5 5"/></symbol>
</defs></svg>
  <div class="bcf-trust">
    <ul class="bcf-shell bcf-trust-grid" role="list">
      {% for icon_name in trust_icons %}
        {% assign title_key = 'trust_title_' | append: forloop.index %}
        {% assign text_key = 'trust_text_' | append: forloop.index %}
        <li class="bcf-trust-item">
          <svg class="bcf-icon" aria-hidden="true" focusable="false"><use href="#bcf-{{ icon_name }}-{{ section.id }}"></use></svg>
          <div><strong>{{ section.settings[title_key] | escape }}</strong><small>{{ section.settings[text_key] | escape }}</small></div>
        </li>
      {% endfor %}
    </ul>
  </div>
  <div class="bcf-main">
    <div class="bcf-shell bcf-grid">
      <div class="bcf-brand">
        <a class="bcf-wordmark" href="{{ routes.root_url }}" aria-label="BadkamerCity">Badkamer<span>City</span></a>
        <p class="bcf-tagline">{{ section.settings.brand_tagline | escape }}</p>
        <div class="bcf-intro">{{ section.settings.brand_text }}</div>
        {% if section.settings.show_social %}
          <ul class="bcf-socials" role="list">
            {% for social_name in social_names %}
              {% assign social_key = 'social_' | append: social_name | append: '_link' %}
              {% assign social_url = settings[social_key] %}
              {% if social_url != blank or section.settings.placeholder_mode %}
                <li>
                  {% if social_url != blank %}<a class="bcf-social" href="{{ social_url | escape }}" aria-label="{{ social_name | capitalize }}" target="_blank" rel="noopener noreferrer">{% else %}<span class="bcf-social" role="img" aria-label="{{ social_name | capitalize }} — voorbeeld" title="Voorbeeld — nog niet gekoppeld">{% endif %}
                  {% case social_name %}{% when 'facebook' %}<svg class="icon icon-facebook" viewBox="0 0 20 20"><path fill="currentColor" d="M18 10.049C18 5.603 14.419 2 10 2s-8 3.603-8 8.049C2 14.067 4.925 17.396 8.75 18v-5.624H6.719v-2.328h2.03V8.275c0-2.017 1.195-3.132 3.023-3.132.874 0 1.79.158 1.79.158v1.98h-1.009c-.994 0-1.303.621-1.303 1.258v1.51h2.219l-.355 2.326H11.25V18c3.825-.604 6.75-3.933 6.75-7.951"/></svg>
{% when 'instagram' %}<svg class="icon icon-instagram" viewBox="0 0 20 20"><path fill="currentColor" fill-rule="evenodd" d="M13.23 3.492c-.84-.037-1.096-.046-3.23-.046-2.144 0-2.39.01-3.238.055-.776.027-1.195.164-1.487.273a2.4 2.4 0 0 0-.912.593 2.5 2.5 0 0 0-.602.922c-.11.282-.238.702-.274 1.486-.046.84-.046 1.095-.046 3.23s.01 2.39.046 3.229c.004.51.097 1.016.274 1.495.145.365.319.639.602.913.282.282.538.456.92.602.474.176.974.268 1.479.273.848.046 1.103.046 3.238.046s2.39-.01 3.23-.046c.784-.036 1.203-.164 1.486-.273.374-.146.648-.329.921-.602.283-.283.447-.548.602-.922.177-.476.27-.979.274-1.486.037-.84.046-1.095.046-3.23s-.01-2.39-.055-3.229c-.027-.784-.164-1.204-.274-1.495a2.4 2.4 0 0 0-.593-.913 2.6 2.6 0 0 0-.92-.602c-.284-.11-.703-.237-1.488-.273ZM6.697 2.05c.857-.036 1.131-.045 3.302-.045a63 63 0 0 1 3.302.045c.664.014 1.321.14 1.943.374a4 4 0 0 1 1.414.922c.41.397.728.88.93 1.414.23.622.354 1.279.365 1.942C18 7.56 18 7.824 18 10.005c0 2.17-.01 2.444-.046 3.292-.036.858-.173 1.442-.374 1.943-.2.53-.474.976-.92 1.423a3.9 3.9 0 0 1-1.415.922c-.51.191-1.095.337-1.943.374-.857.036-1.122.045-3.302.045-2.171 0-2.445-.009-3.302-.055-.849-.027-1.432-.164-1.943-.364a4.15 4.15 0 0 1-1.414-.922 4.1 4.1 0 0 1-.93-1.423c-.183-.51-.329-1.085-.365-1.943C2.009 12.45 2 12.167 2 10.004c0-2.161 0-2.435.055-3.302.027-.848.164-1.432.365-1.942a4.4 4.4 0 0 1 .92-1.414 4.2 4.2 0 0 1 1.415-.93c.51-.183 1.094-.33 1.943-.366Zm.427 4.806a4.105 4.105 0 1 1 5.805 5.805 4.105 4.105 0 0 1-5.805-5.805m1.882 5.371a2.668 2.668 0 1 0 2.042-4.93 2.668 2.668 0 0 0-2.042 4.93m5.922-5.942a.958.958 0 1 1-1.355-1.355.958.958 0 0 1 1.355 1.355" clip-rule="evenodd"/></svg>
{% when 'pinterest' %}<svg class="icon icon-pinterest" viewBox="0 0 20 20"><path fill="currentColor" d="M10 2.01a8.1 8.1 0 0 1 5.666 2.353 8.09 8.09 0 0 1 1.277 9.68A7.95 7.95 0 0 1 10 18.04a8.2 8.2 0 0 1-2.276-.307c.403-.653.672-1.24.816-1.729l.567-2.2c.134.27.393.5.768.702.384.192.768.297 1.19.297q1.254 0 2.248-.72a4.7 4.7 0 0 0 1.537-1.969c.37-.89.554-1.848.537-2.813 0-1.249-.48-2.315-1.43-3.227a5.06 5.06 0 0 0-3.65-1.374c-.893 0-1.729.154-2.478.461a5.02 5.02 0 0 0-3.236 4.552c0 .72.134 1.355.413 1.902.269.538.672.922 1.22 1.152.096.039.182.039.25 0 .066-.028.114-.096.143-.192l.173-.653c.048-.144.02-.288-.105-.432a2.26 2.26 0 0 1-.548-1.565 3.803 3.803 0 0 1 3.976-3.861c1.047 0 1.863.288 2.44.855.585.576.883 1.315.883 2.228a6.8 6.8 0 0 1-.317 2.122 3.8 3.8 0 0 1-.893 1.556c-.384.384-.836.576-1.345.576-.413 0-.749-.144-1.018-.451-.259-.307-.345-.672-.25-1.085q.22-.77.452-1.537l.173-.701c.057-.25.086-.451.086-.624 0-.346-.096-.634-.269-.855-.192-.22-.451-.336-.797-.336-.432 0-.797.192-1.085.595-.288.394-.442.893-.442 1.499.005.374.063.746.173 1.104l.058.144c-.576 2.478-.913 3.938-1.037 4.36-.116.528-.154 1.153-.125 1.863A8.07 8.07 0 0 1 2 10.03c0-2.208.778-4.11 2.343-5.666A7.72 7.72 0 0 1 10 2.001z"/></svg>
{% when 'youtube' %}<svg class="icon icon-youtube" viewBox="0 0 20 20"><path fill="currentColor" d="M18.16 5.87c.34 1.309.34 4.08.34 4.08s0 2.771-.34 4.08a2.13 2.13 0 0 1-1.53 1.53c-1.309.34-6.63.34-6.63.34s-5.321 0-6.63-.34a2.13 2.13 0 0 1-1.53-1.53c-.34-1.309-.34-4.08-.34-4.08s0-2.771.34-4.08a2.17 2.17 0 0 1 1.53-1.53C4.679 4 10 4 10 4s5.321 0 6.63.34a2.17 2.17 0 0 1 1.53 1.53M8.3 12.5l4.42-2.55L8.3 7.4z"/></svg>
{% when 'linkedin' %}<svg viewBox="0 0 24 24"><path d="M5 3a2 2 0 1 0 0 4 2 2 0 0 0 0-4ZM3 9h4v12H3V9Zm6 0h4v2c1-3 8-3 8 3v7h-4v-7c0-3-4-3-4 0v7H9V9Z"/></svg>{% endcase %}
                  {% if social_url != blank %}</a>{% else %}</span>{% endif %}
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        {% endif %}
      </div>
      {% for group in groups %}
        {% assign heading_key = group | append: '_heading' %}
        <details class="bcf-nav bcf-{{ group }}" open>
          <summary class="bcf-heading bcf-nav-summary">{{ section.settings[heading_key] | escape }}<span class="bcf-plus" aria-hidden="true"></span></summary>
          <ul class="bcf-links" role="list">
            {% for block in section.blocks %}
              {% if block.type == group %}
                <li {{ block.shopify_attributes }}>
                  {% if block.settings.url != blank %}<a href="{{ block.settings.url | escape }}">{{ block.settings.label | escape }}</a>{% else %}<span title="Voorbeeld — pagina nog niet gekoppeld">{{ block.settings.label | escape }}</span>{% endif %}
                </li>
              {% endif %}
            {% endfor %}
            {% if group == 'category' %}<li><a class="bcf-all" href="{{ routes.all_products_collection_url }}">{{ section.settings.all_label | escape }}<svg class="bcf-icon" aria-hidden="true" focusable="false"><use href="#bcf-arrow-{{ section.id }}"></use></svg></a></li>{% endif %}
          </ul>
        </details>
      {% endfor %}
      <div class="bcf-contact">
        <h2 class="bcf-heading bcf-contact-title">{{ section.settings.contact_heading | escape }}{% if section.settings.placeholder_mode %}<span class="bcf-example">{{ section.settings.example_label | escape }}</span>{% endif %}</h2>
        <div class="bcf-contact-list">
          <div class="bcf-contact-row"><svg class="bcf-icon" aria-hidden="true" focusable="false"><use href="#bcf-pin-{{ section.id }}"></use></svg><address>{{ section.settings.contact_address | escape | newline_to_br }}</address></div>
          <div class="bcf-contact-row"><svg class="bcf-icon" aria-hidden="true" focusable="false"><use href="#bcf-phone-{{ section.id }}"></use></svg><div>{% if section.settings.placeholder_mode %}<span>{{ section.settings.contact_phone | escape }}</span>{% else %}<a href="tel:{{ section.settings.contact_phone | remove: ' ' | escape }}">{{ section.settings.contact_phone | escape }}</a>{% endif %}<small>{{ section.settings.opening_hours | escape }}</small></div></div>
          <div class="bcf-contact-row"><svg class="bcf-icon" aria-hidden="true" focusable="false"><use href="#bcf-mail-{{ section.id }}"></use></svg>{% if section.settings.placeholder_mode %}<span>{{ section.settings.contact_email | escape }}</span>{% else %}<a href="mailto:{{ section.settings.contact_email | escape }}">{{ section.settings.contact_email | escape }}</a>{% endif %}</div>
        </div>
        {% if section.settings.contact_button_link != blank %}<a class="bcf-cta" href="{{ section.settings.contact_button_link | escape }}"><span>{{ section.settings.contact_button_text | escape }}</span><svg class="bcf-icon" aria-hidden="true" focusable="false"><use href="#bcf-arrow-{{ section.id }}"></use></svg></a>{% endif %}
      </div>
    </div>
  </div>
  <div class="bcf-bottom">
    <div class="bcf-shell bcf-bottom-row">
      <small class="bcf-copyright">&copy; {{ 'now' | date: '%Y' }} BadkamerCity. {{ section.settings.bottom_text | escape }}</small>
      {% if section.settings.show_policy %}<ul class="bcf-legal" role="list">{% for policy in shop.policies %}{% if policy != blank %}<li><a href="{{ policy.url | escape }}">{{ policy.title | escape }}</a></li>{% endif %}{% endfor %}</ul>{% endif %}
      {% if section.settings.payment_enable %}<ul class="bcf-payments" role="list" aria-label="{{ section.settings.payment_label | escape }}">{% if section.settings.payment_examples %}<li><span class="bcf-example">{{ section.settings.example_label | escape }}</span></li>{% endif %}{% for type in payment_types %}<li>{{ type | payment_type_svg_tag: class: 'bcf-payment-icon' }}</li>{% endfor %}</ul>{% endif %}
    </div>
  </div>
</footer>
{% stylesheet %}

.bcf-v2{--bcf-bg:#151e24;--bcf-text:#d5dce0;--bcf-muted:#aebbc4;--bcf-accent:rgb(var(--bc-color-secondary,96,165,250));display:block;margin:0;padding:0;border:0;color:var(--bcf-text);background:var(--bcf-bg);font-family:var(--font-body-family,Arial,sans-serif);font-style:normal;font-size:14px;line-height:1.55;letter-spacing:0;text-align:left}
.bcf-v2 *,.bcf-v2 *::before,.bcf-v2 *::after{box-sizing:border-box}
.bcf-v2 [hidden]{display:none!important}
.bcf-v2 .bcf-shell{width:calc(100% - 80px);max-width:1280px;margin:0 auto;padding:0}
.bcf-v2 :is(p,h2,h3,ul,li,address,details,summary){margin:0;padding:0}
.bcf-v2 :is(ul,li){list-style:none}
.bcf-v2 a{color:inherit;text-decoration:none}
.bcf-v2 a:hover{color:#fff;text-decoration:underline;text-underline-offset:4px}
.bcf-v2 :is(a,button,summary):focus-visible{outline:2px solid var(--bcf-accent);outline-offset:5px;box-shadow:none}
.bcf-v2 .bcf-icon{display:block;flex:none;width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.65;stroke-linecap:round;stroke-linejoin:round}
.bcf-v2 .bcf-trust{margin:0;padding:20px 0;background:#f6f8f9;color:#182b3c;border-block:1px solid #e3e8eb}
.bcf-v2 .bcf-trust-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));align-items:center}
.bcf-v2 .bcf-trust-item{display:flex;align-items:center;gap:13px;min-width:0;padding:0 24px;border-left:1px solid #dce3e8}
.bcf-v2 .bcf-trust-item:first-child{padding-left:0;border-left:0}
.bcf-v2 .bcf-trust-item:last-child{padding-right:0}
.bcf-v2 .bcf-trust-item .bcf-icon{width:30px;height:30px}
.bcf-v2 .bcf-trust-item strong{display:block;font-size:14px;line-height:1.35;font-weight:700;letter-spacing:0}
.bcf-v2 .bcf-trust-item small{display:block;margin-top:3px;color:#5b6c79;font-size:11.5px;line-height:1.4}
.bcf-v2 .bcf-main{padding:46px 0 42px;background:linear-gradient(120deg,#162129,#192228 60%,#141d23)}
.bcf-v2 .bcf-grid{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.88fr) minmax(0,.9fr) minmax(0,1.02fr);gap:48px;align-items:start}
.bcf-v2 .bcf-grid>*{min-width:0}
.bcf-v2 .bcf-wordmark{display:inline-flex;align-items:baseline;color:#fff;font-family:var(--font-heading-family,Arial,sans-serif);font-size:32px;line-height:1.1;font-weight:750;letter-spacing:-1.1px;white-space:nowrap}
.bcf-v2 .bcf-wordmark:hover{text-decoration:none}
.bcf-v2 .bcf-wordmark span{font-weight:350}
.bcf-v2 .bcf-tagline{margin-top:9px;color:#b7c6d0;font-size:10px;line-height:1.4;letter-spacing:2px;text-transform:uppercase}
.bcf-v2 .bcf-intro{max-width:285px;margin-top:24px;color:var(--bcf-text);font-size:14px;line-height:1.65}
.bcf-v2 .bcf-socials{display:flex;gap:9px;margin-top:23px;flex-wrap:wrap}
.bcf-v2 .bcf-social{display:grid;place-items:center;flex:none;width:36px;height:36px;border:1px solid #ffffff0a;border-radius:50%;background:#ffffff10;color:#eef3f6;transition:background .16s ease,transform .16s ease}
.bcf-v2 a.bcf-social:hover{background:#ffffff22;transform:translateY(-2px);text-decoration:none}
.bcf-v2 .bcf-social svg{width:17px;height:17px;fill:currentColor;stroke:none}
.bcf-v2 .bcf-heading{display:block;margin:0 0 18px;color:#fff;font-family:inherit;font-size:15px;line-height:22px;font-weight:700;letter-spacing:0}
.bcf-v2 .bcf-nav-summary{list-style:none;cursor:default}
.bcf-v2 .bcf-nav-summary::-webkit-details-marker{display:none}
.bcf-v2 .bcf-plus{display:none}
.bcf-v2 .bcf-links{display:grid;gap:4px;margin:0;padding:0}
.bcf-v2 .bcf-links :is(a,span){display:inline-block;max-width:100%;padding:3px 0;font-size:14px;line-height:20px;overflow-wrap:anywhere}
.bcf-v2 .bcf-links .bcf-all{display:inline-flex;align-items:center;gap:8px;margin-top:2px;color:#e9f1f6;font-weight:600}
.bcf-v2 .bcf-all .bcf-icon{width:17px;height:17px}
.bcf-v2 .bcf-contact-title{display:flex;align-items:center;gap:8px}
.bcf-v2 .bcf-example{display:inline-block;padding:2px 5px;border:1px solid #ffffff26;border-radius:3px;color:#b6c2ca;font-size:9px;line-height:12px;font-weight:400;letter-spacing:0;white-space:nowrap}
.bcf-v2 .bcf-contact-list{display:grid;gap:15px}
.bcf-v2 .bcf-contact-row{display:grid;grid-template-columns:22px minmax(0,1fr);gap:12px;align-items:start;font-size:14px;line-height:22px}
.bcf-v2 .bcf-contact-row .bcf-icon{margin-top:1px;color:#e8eef2}
.bcf-v2 .bcf-contact-row address{font-style:normal;line-height:22px}
.bcf-v2 .bcf-contact-row small{display:block;margin-top:1px;font-size:11.5px;line-height:18px;color:var(--bcf-muted)}
.bcf-v2 .bcf-contact-row :is(a,span){overflow-wrap:anywhere}
.bcf-v2 .bcf-cta{display:flex;justify-content:space-between;align-items:center;gap:12px;min-height:44px;margin-top:23px;padding:10px 15px;border:1px solid #c1ccd4;border-radius:4px;background:transparent;color:#f6f9fb;font-size:13px;line-height:20px;font-weight:600;transition:background .16s ease,color .16s ease}
.bcf-v2 .bcf-cta .bcf-icon{width:18px;height:18px}
.bcf-v2 a.bcf-cta:hover{background:#f3f7fa;color:#152532;text-decoration:none}
.bcf-v2 .bcf-bottom{margin:0;padding:17px 0;background:#111a20;border-top:1px solid #ffffff20}
.bcf-v2 .bcf-bottom-row{display:flex;align-items:center;justify-content:space-between;gap:14px 24px;min-height:28px}
.bcf-v2 .bcf-copyright{font-size:11px;line-height:18px;color:#bbc6ce}
.bcf-v2 .bcf-legal{display:flex;align-items:center;flex-wrap:wrap;gap:6px 18px;margin:0;padding:0;font-size:11px;line-height:18px}
.bcf-v2 .bcf-payments{display:flex;align-items:center;gap:7px;margin:0;padding:0;flex-shrink:0;flex-wrap:wrap}
.bcf-v2 .bcf-payments li{display:flex;align-items:center}
.bcf-v2 .bcf-payments svg{display:block;width:37px;height:24px}
.bcf-v2 .bcf-payments .bcf-example{border:0;padding:0;margin-right:2px;font-size:9px}
@media(min-width:750px){.bcf-v2 .bcf-nav:not([open])>.bcf-links{display:grid!important}.bcf-v2 .bcf-nav{content-visibility:visible}.bcf-v2 .bcf-nav::details-content{content-visibility:visible;height:auto}}
@media(max-width:1199px) and (min-width:990px){.bcf-v2 .bcf-shell{width:calc(100% - 56px)}.bcf-v2 .bcf-grid{gap:26px;grid-template-columns:1.08fr .88fr .88fr 1.08fr}.bcf-v2 .bcf-wordmark{font-size:28px}.bcf-v2 .bcf-trust-item{padding:0 16px;gap:10px}.bcf-v2 .bcf-trust-item strong{font-size:13px}.bcf-v2 .bcf-bottom-row{flex-wrap:wrap}.bcf-v2 .bcf-legal{margin-left:auto}.bcf-v2 .bcf-contact-title{flex-wrap:wrap;gap:3px 8px}}
@media(max-width:989px){.bcf-v2 .bcf-shell{width:calc(100% - 48px)}.bcf-v2 .bcf-trust{padding:0}.bcf-v2 .bcf-trust-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.bcf-v2 .bcf-trust-item,.bcf-v2 .bcf-trust-item:first-child,.bcf-v2 .bcf-trust-item:last-child{padding:17px 20px;border-left:0}.bcf-v2 .bcf-trust-item:nth-child(odd){padding-left:0;border-right:1px solid #dce3e8}.bcf-v2 .bcf-trust-item:nth-child(-n+2){border-bottom:1px solid #dce3e8}.bcf-v2 .bcf-grid{grid-template-columns:1fr 1fr;gap:34px 50px}.bcf-v2 .bcf-brand{grid-area:1/1}.bcf-v2 .bcf-contact{grid-area:1/2}.bcf-v2 .bcf-service{grid-area:2/1}.bcf-v2 .bcf-category{grid-area:2/2}.bcf-v2 .bcf-intro{max-width:310px}.bcf-v2 .bcf-bottom-row{flex-wrap:wrap;gap:12px 24px}.bcf-v2 .bcf-legal{margin-left:auto}.bcf-v2 .bcf-payments{margin-left:auto}}
