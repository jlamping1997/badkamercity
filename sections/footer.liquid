{% endstylesheet %}
{% javascript %}

(() => {
  const init = root => {
    if (root.dataset.bcfReady) return;
    root.dataset.bcfReady = 'true';
    const mobile = window.matchMedia('(max-width: 749px)');
    const panels = [...root.querySelectorAll('.bcf-nav')];
    const sync = () => panels.forEach(panel => {
      panel.open = !mobile.matches;
      const summary = panel.querySelector('summary');
      if (mobile.matches) summary.removeAttribute('tabindex');
      else summary.setAttribute('tabindex', '-1');
    });
    const onClick = event => {
      if (!mobile.matches && event.target.closest('.bcf-nav-summary')) event.preventDefault();
    };
    sync();
    mobile.addEventListener('change', sync);
    root.addEventListener('click', onClick);
    root.bcfCleanup = () => { mobile.removeEventListener('change', sync); root.removeEventListener('click', onClick); };
  };
  const scan = scope => {
    if (scope.matches && scope.matches('.bcf-v2')) init(scope);
    scope.querySelectorAll('.bcf-v2').forEach(init);
  };
  scan(document);
  document.addEventListener('shopify:section:load', event => scan(event.target));
  document.addEventListener('shopify:section:unload', event => {
    event.target.querySelectorAll('.bcf-v2').forEach(root => root.bcfCleanup && root.bcfCleanup());
  });
})();
{% endjavascript %}
