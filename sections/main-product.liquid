      else
        assign seo_media = product.featured_media
      endif
    -%}

    <script type="application/ld+json">
      {{ product | structured_data }}
    </script>
    <script>
      (() => {
        const initSummary = () => {
          const root = document.getElementById('MainProduct-{{ section.id }}');
          if (!root) return;

          const summary = root.querySelector('[data-product-summary]');
          const content = root.querySelector('[data-product-summary-content]');
          const toggle = root.querySelector('[data-product-summary-toggle]');

          if (!summary || !content || !toggle) return;

          const collapsedHeight = parseFloat(getComputedStyle(content).lineHeight) * 10;
          content.style.setProperty('--summary-collapsed-height', `${collapsedHeight}px`);

          const updateSummaryState = () => {
            const expanded = summary.classList.contains('is-expanded');
            const fullHeight = content.scrollHeight;
            const isShort = fullHeight <= collapsedHeight + 4;

            if (!expanded) {
              content.style.maxHeight = `${collapsedHeight}px`;
              summary.classList.toggle('is-short', isShort);
              toggle.hidden = isShort;
            } else {
              summary.classList.remove('is-short');
              toggle.hidden = false;
              content.style.maxHeight = `${fullHeight}px`;
            }
          };

          requestAnimationFrame(updateSummaryState);
          window.addEventListener('resize', updateSummaryState);

          toggle.addEventListener('click', () => {
            const expanding = !summary.classList.contains('is-expanded');

            if (expanding) {
              const fullHeight = content.scrollHeight;
              summary.classList.add('is-expanded');
              content.style.maxHeight = `${fullHeight}px`;
              toggle.setAttribute('aria-expanded', 'true');
            } else {
              content.style.maxHeight = `${content.scrollHeight}px`;
              requestAnimationFrame(() => {
                summary.classList.remove('is-expanded');
                content.style.maxHeight = `${collapsedHeight}px`;
              });
              toggle.setAttribute('aria-expanded', 'false');
            }

            requestAnimationFrame(updateSummaryState);
          });
        };

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initSummary, { once: true });
        } else {
          initSummary();
        }
      })();
    </script>
  </div>
</product-info>

