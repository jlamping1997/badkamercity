            <span class="bc-product__summary-toggle-text bc-product__summary-toggle-text--more">Lees verder</span>
            <span class="bc-product__summary-toggle-text bc-product__summary-toggle-text--less">Toon minder</span>
          </button>
        </div>
      </div>
    {%- endif -%}

    {%- liquid
