{{ 'section-main-glossary-page.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .bc-glossary-page.section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .bc-glossary-page.section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="bc-glossary-page color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding" data-glossary-page>
  <div class="page-width">
    <div class="bc-glossary-page__layout{% unless section.settings.show_sidebar %} bc-glossary-page__layout--single{% endunless %}">
      <article class="bc-glossary-page__article">
        {%- if section.settings.show_back_link and section.settings.back_link_url != blank -%}
          <nav class="bc-glossary-page__breadcrumb" aria-label="Breadcrumb">
            <a href="{{ section.settings.back_link_url }}" class="bc-glossary-page__back-link">
              {{ section.settings.back_link_label | default: 'Terug naar begrippenlijst' | escape }}
            </a>
          </nav>
        {%- endif -%}

        <header class="bc-glossary-page__header">
          <div class="bc-glossary-page__header-copy">
            {%- if section.settings.heading_prefix != blank -%}
              <p class="bc-glossary-page__eyebrow">
                <span class="bc-glossary-page__eyebrow-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" focusable="false">
                    <path d="M5 5.75C5 4.78 5.78 4 6.75 4h6.9c.5 0 .98.2 1.33.55l3.47 3.47c.35.35.55.83.55 1.33v8.9c0 .97-.78 1.75-1.75 1.75H6.75C5.78 20 5 19.22 5 18.25V5.75Zm9 0V9h3.25L14 5.75Z" />
                    <path d="M8 12.25h8M8 15.25h5" />
                  </svg>
                </span>
                {{ section.settings.heading_prefix | escape }}
              </p>
            {%- endif -%}

            <h1 class="bc-glossary-page__title">
              {{ page.title | escape }}
            </h1>

            <p class="bc-glossary-page__subtitle">
              Heldere uitleg voor badkamerkeuzes, montage en onderhoud.
            </p>
          </div>

          <div class="bc-glossary-page__header-mark" aria-hidden="true">
            <svg viewBox="0 0 80 80" focusable="false">
              <circle cx="40" cy="40" r="30" />
              <path d="M27 41.5 36 50l18-22" />
            </svg>
          </div>
        </header>

        <div class="bc-glossary-page__content rte">
          {{ page.content }}
        </div>
      </article>

      {%- if section.settings.show_sidebar -%}
        <aside class="bc-glossary-page__sidebar" aria-label="Begrippenlijst">
          <nav class="bc-glossary-page__toc" aria-label="Op deze pagina" data-glossary-page-toc hidden>
            <h2 class="bc-glossary-page__toc-heading">Op deze pagina</h2>
            <ol class="bc-glossary-page__toc-list" data-glossary-page-toc-list></ol>
          </nav>

          <div class="bc-glossary-page__sidebar-card">
            <div class="bc-glossary-page__sidebar-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" focusable="false">
                <path d="M4.75 6.75h14.5M4.75 12h14.5M4.75 17.25h8.5" />
                <path d="M17.5 15.5 20 18l-2.5 2.5" />
              </svg>
            </div>

            {%- if section.settings.sidebar_heading != blank -%}
              <h2 class="bc-glossary-page__sidebar-heading">{{ section.settings.sidebar_heading | escape }}</h2>
            {%- endif -%}

            {%- if section.settings.sidebar_text != blank -%}
              <p class="bc-glossary-page__sidebar-text">{{ section.settings.sidebar_text | escape }}</p>
            {%- endif -%}

            {%- if section.settings.sidebar_button_label != blank and section.settings.sidebar_button_url != blank -%}
              <a class="bc-glossary-page__sidebar-button" href="{{ section.settings.sidebar_button_url }}">
                {{ section.settings.sidebar_button_label | escape }}
              </a>
            {%- endif -%}
          </div>
        </aside>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (() => {
    const section = document.currentScript.previousElementSibling;
    if (!section || !section.matches('[data-glossary-page]')) return;

    const content = section.querySelector('.bc-glossary-page__content');
    const toc = section.querySelector('[data-glossary-page-toc]');
    const tocList = section.querySelector('[data-glossary-page-toc-list]');
    if (!content) return;

    const children = Array.from(content.children);
    const firstParagraph = children.find((child) => child.tagName === 'P');
    if (firstParagraph && !firstParagraph.previousElementSibling) {
      firstParagraph.classList.add('bc-glossary-page__summary');
    }

    const headings = Array.from(content.querySelectorAll(':scope > h2'));
    headings.forEach((heading, index) => {
      const headingText = heading.textContent.trim();
      const sectionCard = document.createElement('section');
      const headingId = heading.id || `begrip-section-${index + 1}`;

      heading.id = headingId;
      sectionCard.className = 'bc-glossary-page__content-card';
      sectionCard.setAttribute('aria-labelledby', headingId);

      if (/gerelateerde/i.test(headingText)) {
        sectionCard.classList.add('bc-glossary-page__content-card--related');
      } else if (/let je op/i.test(headingText)) {
        sectionCard.classList.add('bc-glossary-page__content-card--attention');
      } else if (/voordelen/i.test(headingText)) {
        sectionCard.classList.add('bc-glossary-page__content-card--benefits');
      }

      heading.before(sectionCard);
      sectionCard.append(heading);

      let next = sectionCard.nextElementSibling;
      while (next && next.tagName !== 'H2') {
        const current = next;
        next = next.nextElementSibling;
        sectionCard.append(current);
      }

      if (tocList && headingText) {
        const item = document.createElement('li');
        const link = document.createElement('a');
        link.href = `#${headingId}`;
        link.textContent = headingText;
        item.append(link);
        tocList.append(item);
      }
    });

    if (toc && tocList && tocList.children.length > 1) {
      toc.hidden = false;
    }
  })();
</script>

{% schema %}
{
  "name": "Begripspagina",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading_prefix",
      "label": "Label boven titel",
      "default": "Begrip"
    },
    {
      "type": "checkbox",
      "id": "show_back_link",
      "label": "Toon teruglink",
      "default": true
    },
    {
      "type": "text",
      "id": "back_link_label",
      "label": "Tekst teruglink",
      "default": "Terug naar begrippenlijst"
    },
    {
      "type": "url",
      "id": "back_link_url",
      "label": "URL teruglink"
    },
    {
      "type": "checkbox",
      "id": "show_sidebar",
      "label": "Toon sidebar",
      "default": true
    },
    {
      "type": "text",
      "id": "sidebar_heading",
      "label": "Sidebar titel",
      "default": "Meer badkamerbegrippen"
    },
    {
      "type": "textarea",
      "id": "sidebar_text",
      "label": "Sidebar tekst",
      "default": "Bekijk de volledige begrippenlijst met uitleg over sanitair, materialen, montage en onderhoud."
    },
    {
      "type": "text",
      "id": "sidebar_button_label",
      "label": "Sidebar knoptekst",
      "default": "Bekijk alle begrippen"
    },
    {
      "type": "url",
      "id": "sidebar_button_url",
      "label": "Sidebar knoplink"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Kleurenschema",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding boven",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding onder",
      "default": 64
    }
  ]
}
{% endschema %}
